(in-package :cl-user)
;;; CCL-1 x86-64 re-test, build half. Run in a fresh lx86cl64:
;;;   lx86cl64 --batch --no-init --load ccl1-build.lisp
;;; Bracket compiled inline store/read functions between large specialized vectors
;;; so that purify (default :purify t) places code vectors adjacent to ivector data,
;;; maximizing the chance an element shares a 4K page with the storing instruction
;;; (the exact precondition of the arm64 CCL-1 hang).

(defparameter *vecs* (make-hash-table :test 'eq))

(defmacro defvec (name etype n)
  `(setf (gethash ',name *vecs*)
         (make-array ,n :element-type ',etype)))

;; Each type: a vector before, inline store, inline read, vector after.
(defvec u8a (unsigned-byte 8) 200000)
(defun set-u8 (a i v)
  (declare (type (simple-array (unsigned-byte 8) (*)) a) (fixnum i) ((unsigned-byte 8) v)
           (optimize (speed 3) (safety 0)))
  (setf (aref a i) v))
(defun get-u8 (a i)
  (declare (type (simple-array (unsigned-byte 8) (*)) a) (fixnum i)
           (optimize (speed 3) (safety 0)))
  (aref a i))
(defvec u8b (unsigned-byte 8) 200000)

(defvec bitv bit 400000)
(defun set-bit (a i v)
  (declare (type (simple-array bit (*)) a) (fixnum i) (bit v)
           (optimize (speed 3) (safety 0)))
  (setf (sbit a i) v))
(defun get-bit (a i)
  (declare (type (simple-array bit (*)) a) (fixnum i)
           (optimize (speed 3) (safety 0)))
  (sbit a i))
(defvec bitw bit 400000)

(defvec u32a (unsigned-byte 32) 100000)
(defun set-u32 (a i v)
  (declare (type (simple-array (unsigned-byte 32) (*)) a) (fixnum i) ((unsigned-byte 32) v)
           (optimize (speed 3) (safety 0)))
  (setf (aref a i) v))
(defun get-u32 (a i)
  (declare (type (simple-array (unsigned-byte 32) (*)) a) (fixnum i)
           (optimize (speed 3) (safety 0)))
  (aref a i))
(defvec u32b (unsigned-byte 32) 100000)

(defvec u64a (unsigned-byte 64) 80000)
(defun set-u64 (a i v)
  (declare (type (simple-array (unsigned-byte 64) (*)) a) (fixnum i) ((unsigned-byte 64) v)
           (optimize (speed 3) (safety 0)))
  (setf (aref a i) v))
(defun get-u64 (a i)
  (declare (type (simple-array (unsigned-byte 64) (*)) a) (fixnum i)
           (optimize (speed 3) (safety 0)))
  (aref a i))
(defvec u64b (unsigned-byte 64) 80000)

(defvec s8a (signed-byte 8) 200000)
(defun set-s8 (a i v)
  (declare (type (simple-array (signed-byte 8) (*)) a) (fixnum i) ((signed-byte 8) v)
           (optimize (speed 3) (safety 0)))
  (setf (aref a i) v))
(defun get-s8 (a i)
  (declare (type (simple-array (signed-byte 8) (*)) a) (fixnum i)
           (optimize (speed 3) (safety 0)))
  (aref a i))
(defvec s8b (signed-byte 8) 200000)

(defvec sfa single-float 100000)
(defun set-sf (a i v)
  (declare (type (simple-array single-float (*)) a) (fixnum i) (single-float v)
           (optimize (speed 3) (safety 0)))
  (setf (aref a i) v))
(defun get-sf (a i)
  (declare (type (simple-array single-float (*)) a) (fixnum i)
           (optimize (speed 3) (safety 0)))
  (aref a i))
(defvec sfb single-float 100000)

(defvec dfa double-float 80000)
(defun set-df (a i v)
  (declare (type (simple-array double-float (*)) a) (fixnum i) (double-float v)
           (optimize (speed 3) (safety 0)))
  (setf (aref a i) v))
(defun get-df (a i)
  (declare (type (simple-array double-float (*)) a) (fixnum i)
           (optimize (speed 3) (safety 0)))
  (aref a i))
(defvec dfb double-float 80000)

(format t "built ~a vectors; saving image~%" (hash-table-count *vecs*))
(finish-output)
(ccl:save-application "img1" :prepend-kernel t)
