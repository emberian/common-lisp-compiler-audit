;;;; Targeted differential fuzzer: CCL vs SBCL, (speed 3 safety 0) vs (speed 0 safety 3).
;;;; Aims at the codegen where CCL's CONFIRMED bugs lived -- the ceiling/truncate bug
;;;; was a MULTIPLE-VALUES return bug, not arithmetic. So this heavily weights:
;;;;   multiple values (floor/truncate/round/ceiling/decode-float/gethash/get-properties,
;;;;   user mv fns, and the mv consumers nth-value / mv-bind / mv-call / mv-list / mv-prog1),
;;;;   type dispatch (typecase/etypecase/typep), sequence/string/character ops,
;;;;   struct & (multidim/specialized/bit) array access, and control flow
;;;;   (block/return-from, catch/throw, tagbody/go, loop, labels recursion, unwind-protect).
;;;; Determinism via own 64-bit LCG so CCL and SBCL run byte-identical streams.

(declaim (optimize (speed 1) (safety 3)))
#+ccl (ignore-errors (ccl:set-fpu-mode :overflow nil :underflow nil
                                       :division-by-zero nil :invalid nil :inexact nil))
#+sbcl (ignore-errors (sb-int:set-floating-point-modes :traps nil))

(defstruct (fs (:constructor mk-fs (a b c))) a b c)

(defvar *st* 0)
(defun nxt ()
  (setf *st* (logand (+ (* *st* 6364136223846793005) 1442695040888963407) #xffffffffffffffff))
  (ldb (byte 30 20) *st*))
(defun seed! (s)
  (setf *st* (logand (+ (* (+ s 1) 2862933555777941757) 3037000493) #xffffffffffffffff))
  (dotimes (i 4) (nxt)))
(defun rnd (n) (mod (nxt) n))
(defun pick (l) (nth (rnd (length l)) l))

(defparameter *ccl-fixmax* 1152921504606846975)
(defparameter *strings* '("" "a" "ab" "abc" "Hello" "racecar" "12345" "AaBbCc" "  x " "zzz"))

;; scalar expressions (shallow -- the operation is the subject, not nesting)
(defun ie (&optional (d 1))
  (if (<= d 0)
      (pick (list 'xi 'yi 'bi 'ci 'ni 0 1 -1 2 3 7 255 (ash 1 40) (- (rnd 20) 10) *ccl-fixmax*))
      (case (rnd 6)
        (0 (ie 0)) (1 (ie 0))
        (2 `(+ ,(ie (1- d)) ,(ie (1- d)))) (3 `(- ,(ie (1- d)) ,(ie (1- d))))
        (4 `(* ,(ie (1- d)) ,(ie 0))) (5 `(logand ,(ie (1- d)) ,(ie 0))))))
(defun nz () (let ((k (- (rnd 20) 10))) (if (zerop k) 3 k)))
(defun ce () (pick (list 'ch `(code-char ,(rnd 128)) `(code-char (+ 65 ni)) #\a #\Z #\5 #\Space #\9)))
(defun se () (pick (list 'st `(quote ,(pick *strings*)) `(string ,(ce))
                         `(make-string (mod ni 6) :initial-element ,(ce)))))
(defun fe () (pick (list 'di 'ei `(float ,(ie 0) 1d0) 1.5d0 -0.5d0 0d0 3.25d0)))
(defun smalln () (pick (list 'ni `(mod ni 6) (rnd 6) 3 4 5)))
(defun ve () (pick (list `(vector ,(ie 0) ,(ie 0) ,(ie 0) ,(ie 0))
                         `(make-array 4 :initial-contents (list ,(ie 0) ,(ie 0) ,(ie 0) ,(ie 0)))
                         `(coerce (quote ,(pick *strings*)) 'list)
                         `(list ,(ie 0) ,(ie 0) ,(ie 0)))))

;;; ---- multiple-value producers ----
(defun mv-producer (d)
  (case (rnd 12)
    (0 `(floor ,(ie d) ,(nz))) (1 `(ceiling ,(ie d) ,(nz)))
    (2 `(truncate ,(ie d) ,(nz))) (3 `(round ,(ie d) ,(nz)))
    (4 `(floor ,(fe))) (5 `(truncate ,(fe))) (6 `(round ,(fe)))
    (7 `(ftruncate ,(fe))) (8 `(fround ,(fe)))
    (9 `(decode-float ,(fe))) (10 `(integer-decode-float ,(fe)))
    (11 `(values ,@(loop repeat (rnd 5) collect (ie 0))))))

(defun mv-consumer (d)
  (let ((p (mv-producer d)))
    (case (rnd 8)
      (0 p)                                   ; bare multiple values
      (1 `(multiple-value-list ,p))
      (2 `(nth-value ,(rnd 4) ,p))
      (3 `(multiple-value-bind (a b c dd) ,p (list a b c dd)))
      (4 `(multiple-value-call #'list ,p))
      (5 `(multiple-value-call #'+ ,(mv-producer (1- d)) ,p))
      (6 `(multiple-value-prog1 ,p (values 99 98)))
      (7 `(let ((h (make-hash-table :test 'eql)))
            (setf (gethash ,(ie 0) h) ,(ie 0))
            (multiple-value-list (gethash ,(ie 0) h)))))))

(defun mv-user (d)
  (declare (ignore d))
  `(flet ((g (x) (declare (integer x)) (values x (* x 2) (- x) (* x x))))
     (,(pick '(multiple-value-list nth-value3 mvbind))
      (g ,(ie 1)))))
;; expand the pseudo-ops in mv-user by hand to keep it valid:
(defun mv-user2 ()
  (let ((x (ie 1)))
    (case (rnd 4)
      (0 `(flet ((g (v) (declare (integer v)) (values v (* v 2) (- v))))
            (multiple-value-list (g ,x))))
      (1 `(flet ((g (v) (declare (integer v)) (values v (* v 2) (- v))))
            (nth-value ,(rnd 4) (g ,x))))
      (2 `(flet ((g (v) (declare (integer v)) (values v (* v 2) (- v))))
            (multiple-value-call #'list (g ,x) (g ,(ie 0)))))
      (3 `(get-properties (list :a ,(ie 0) :b ,(ie 0) :c ,(ie 0))
                          (list ,(pick '(:b :c :z :a))))))))

;;; ---- type dispatch ----
(defun anyval ()
  (pick (list 'xi 'bi 'di 'fi 'ch `(quote ,(pick *strings*)) `(vector ,(ie 0) ,(ie 0))
              'nil 't `(list ,(ie 0)) `(/ ,(ie 0) ,(nz)) `(mk-fs ,(ie 0) ,(ie 0) ,(ie 0)))))
(defun type-dispatch (d)
  (declare (ignore d))
  (case (rnd 5)
    (0 `(typecase ,(anyval)
          (fixnum 1) (bignum 2) (ratio 3) (double-float 4) (single-float 5)
          (character 6) (string 7) (cons 8) (null 9) (vector 10) (fs 11) (t 0)))
    (1 `(etypecase ,(pick (list 'xi 'bi 'ch `(quote ,(pick *strings*))))
          (fixnum 10) (bignum 20) (character 30) (string 40)))
    (2 `(if (typep ,(anyval) ',(pick '(integer fixnum string character cons vector
                                       double-float number atom list fs)))
            1 0))
    (3 `(list ,@(loop repeat 4 collect `(typep ,(anyval) ',(pick '(integer string character cons))))))
    (4 `(the ,(pick '(integer t number)) ,(ie 1)))))

;;; ---- sequence / string / character ----
(defun seq-op (d)
  (declare (ignore d))
  (case (rnd 20)
    (0 `(length ,(se))) (1 `(reverse ,(se)))
    (2 `(subseq ,(se) (mod ni (1+ (length ,(se))))))
    (3 `(string-upcase ,(se))) (4 `(string-downcase ,(se)))
    (5 `(concatenate 'string ,(se) ,(se)))
    (6 `(let ((s ,(se))) (if (plusp (length s)) (char s (mod ni (length s))) #\?)))
    (7 `(position ,(ce) ,(se))) (8 `(count ,(ce) ,(se)))
    (9 `(find ,(ce) ,(se))) (10 `(remove ,(ce) ,(se)))
    (11 `(substitute ,(ce) ,(ce) ,(se))) (12 `(search ,(se) ,(se)))
    (13 `(reverse ,(ve))) (14 `(length ,(ve)))
    (15 `(reduce #'+ ,(ve) :initial-value 0))
    (16 `(map 'list #'1+ (coerce ,(ve) 'list)))
    (17 `(stable-sort (copy-seq (coerce ,(ve) 'vector)) #'<))
    (18 `(list (digit-char-p ,(ce)) (alpha-char-p ,(ce)) (alphanumericp ,(ce))
               (char-code (char-upcase ,(ce)))))
    (19 `(coerce (list ,(ce) ,(ce) ,(ce)) 'string))))

;;; ---- struct & array ----
(defun struct-array (d)
  (declare (ignore d))
  (case (rnd 10)
    (0 `(let ((o (mk-fs ,(ie 0) ,(se) ,(ce)))) (list (fs-a o) (fs-c o))))
    (1 `(let ((o (mk-fs ,(ie 0) ,(ie 0) ,(ie 0)))) (setf (fs-b o) ,(ie 0)) (+ (fs-a o) (fs-b o))))
    (2 `(aref (make-array '(2 3) :initial-contents '((1 2 3) (4 5 6)))
              (mod ni 2) (mod ni 3)))
    (3 `(let ((a (make-array 5 :element-type '(unsigned-byte 8) :initial-element 0)))
          (setf (aref a (mod ni 5)) (logand ,(ie 0) 255)) (aref a (mod ni 5))))
    (4 `(let ((a (make-array 4 :element-type 'double-float :initial-element 0d0)))
          (setf (aref a (mod ni 4)) ,(fe)) (aref a (mod ni 4))))
    (5 `(row-major-aref (make-array '(2 2) :initial-contents '((7 8) (9 10))) (mod ni 4)))
    (6 `(let ((a (make-array 3 :fill-pointer 0 :adjustable t)))
          (vector-push-extend ,(ie 0) a) (vector-push-extend ,(ie 0) a) (list (length a) (aref a 0))))
    (7 `(let ((b (make-array 8 :element-type 'bit :initial-element 0)))
          (setf (sbit b (mod ni 8)) 1) (list (count 1 b) (sbit b (mod ni 8)))))
    (8 `(bit-and (coerce '(1 0 1 1) 'bit-vector) (coerce '(1 1 0 1) 'bit-vector)))
    (9 `(list (array-rank (make-array '(2 3 4))) (array-total-size (make-array '(2 3 4)))))))

;;; ---- control flow ----
(defun control (d)
  (declare (ignore d))
  (case (rnd 10)
    (0 `(block b (dotimes (i 20) (when (> (* i i) ,(ie 0)) (return-from b i))) -1))
    (1 `(catch 'c (dotimes (i 20) (when (> i (mod ,(ie 0) 7)) (throw 'c (* i 10)))) -1))
    (2 `(let ((acc 0)) (tagbody (setf acc 0) top (incf acc) (when (< acc (mod ni 9)) (go top))) acc))
    (3 `(loop for i below (mod ni 12) sum i))
    (4 `(loop for i below 10 when (evenp (+ i ,(ie 0))) collect i))
    (5 `(labels ((f (n) (if (<= n 0) 0 (+ n (f (1- n)))))) (f (mod ni 10))))
    (6 `(labels ((fib (n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))) (fib (mod ni 12))))
    (7 `(let ((log nil)) (unwind-protect (setf log (cons 1 log)) (setf log (cons 2 log))) log))
    (8 `(do ((i 0 (1+ i)) (s 0 (+ s i))) ((>= i (mod ni 10)) s)))
    (9 `(block nil (mapc (lambda (x) (when (minusp x) (return x))) (list ,(ie 0) ,(ie 0) ,(ie 0))) 'none))))

(defun gen-body ()
  (case (rnd 20)
    ((0 1 2 3 4 5 6) (mv-consumer 2))     ; multiple values -- the star
    ((7 8) (mv-user2))
    ((9 10) (type-dispatch 2))
    ((11 12 13) (seq-op 2))
    ((14 15 16) (struct-array 2))
    ((17 18 19) (control 2))))

(defparameter *arglist* '(xi yi bi ci di ei fi ni st ch))
(defparameter *decls*
  '(declare (type fixnum xi yi) (type integer bi ci)
            (type double-float di ei) (type single-float fi)
            (type (integer 0 12) ni) (type simple-string st) (type character ch)))
(defun gen-row ()
  (list (- (rnd 4001) 2000) (- (rnd 4001) 2000)
        (if (zerop (rnd 2)) (- (rnd 4001) 2000) (* (ash 1 (+ 40 (rnd 80))) (if (zerop (rnd 2)) 1 -1)))
        (- (rnd 4001) 2000)
        (coerce (- (rnd 4001) 2000) 'double-float) (/ (coerce (- (rnd 2001) 1000) 'double-float) 8d0)
        (coerce (- (rnd 401) 200) 'single-float)
        (rnd 13) (pick *strings*) (code-char (rnd 128))))

;;; ---- serialization ----
(defun ser1 (v &optional (depth 0))
  (if (> depth 8) "..."
      (typecase v
        (integer (format nil "~d" v))
        (ratio (format nil "R~d/~d" (numerator v) (denominator v)))
        (double-float (ser-float v #\D)) (single-float (ser-float v #\S))
        (character (format nil "C~d" (char-code v)))
        (null "N!")
        (cons (ser-list v depth))
        (string (format nil "T~d:~a" (length v) v))
        (bit-vector (format nil "B~a" (map 'string (lambda (b) (digit-char b)) v)))
        (fs (format nil "FS[~a ~a ~a]" (ser1 (fs-a v)(1+ depth)) (ser1 (fs-b v)(1+ depth)) (ser1 (fs-c v)(1+ depth))))
        (vector (format nil "V~d[~a]" (length v)
                        (with-output-to-string (s)
                          (let ((n (min 60 (length v))))
                            (dotimes (i n) (when (plusp i) (write-char #\Space s))
                              (write-string (ser1 (aref v i) (1+ depth)) s))))))
        (array (format nil "ARR~a:~a" (array-dimensions v)
                       (with-output-to-string (s)
                         (dotimes (i (min 60 (array-total-size v)))
                           (when (plusp i) (write-char #\Space s))
                           (write-string (ser1 (row-major-aref v i) (1+ depth)) s)))))
        (symbol (cond ((eq v t) "T!") ((keywordp v) (format nil "K:~a" (symbol-name v)))
                      (t (format nil "Y:~a" (symbol-name v)))))
        (complex (format nil "X(~a)(~a)" (ser1 (realpart v)(1+ depth)) (ser1 (imagpart v)(1+ depth))))
        (hash-table "HT")
        (function "FN")
        (t (format nil "?~a" (type-of v))))))

(defun ser-list (v depth)
  (with-output-to-string (s)
    (write-char #\( s)
    (let ((i 0) (cur v))
      (loop while (and (consp cur) (< i 60)) do
        (when (plusp i) (write-char #\Space s))
        (write-string (ser1 (car cur) (1+ depth)) s)
        (setf cur (cdr cur)) (incf i))
      (when (and cur (not (consp cur)))
        (write-string " . " s) (write-string (ser1 cur (1+ depth)) s)))
    (write-char #\) s)))

(defun ser-float (v tag)
  (cond ((/= v v) (format nil "~cNAN" tag))
        ((and (> (abs v) 0) (or (> v most-positive-double-float) (< v most-negative-double-float)))
         (format nil "~cINF~a" tag (if (plusp v) "+" "-")))
        ((zerop v) (format nil "~cZ~a" tag (if (minusp (float-sign v)) "-" "+")))
        (t (handler-case
               (multiple-value-bind (m e sg) (integer-decode-float v)
                 (if (zerop m) (format nil "~cZ~d" tag sg) (format nil "~c~d.~d.~d" tag sg m e)))
             (error () (format nil "~cNONFIN" tag))))))

(defun serialize (vals)
  (if (= (length vals) 1) (ser1 (first vals)) (format nil "~{~a~^,~}" (mapcar (lambda (x) (ser1 x)) vals))))

(defun err-cat (e)
  (typecase e
    (division-by-zero "E:DIV0") (floating-point-overflow "E:FPOVER")
    (type-error "E:TYPE") (arithmetic-error "E:ARITH") (storage-condition "E:STORAGE")
    (error (format nil "E:~a" (type-of e))) (t (format nil "E?:~a" (type-of e)))))

(defun build-lambda (body policy)
  `(lambda ,*arglist* ,*decls* (declare (optimize ,@policy)) ,body))
(defun run-one (fn rows)
  (handler-case
      (format nil "~{~a~^|~}"
              (loop for row in rows
                    collect (handler-case (serialize (multiple-value-list (apply fn row)))
                              (error (e) (err-cat e)) (storage-condition (e) (err-cat e)))))
    (error (e) (format nil "OUTER~a" (err-cat e)))))
(defun compile-quiet (form) (handler-bind ((warning #'muffle-warning)) (compile nil form)))

(defun emit (start end)
  (loop for seed from start below end do
    (seed! seed)
    (let* ((body (gen-body))
           (rows (loop repeat 6 collect (gen-row)))
           (safe-fn (handler-case (compile-quiet (build-lambda body '((speed 0)(safety 3)(debug 0)))) (error (e) (err-cat e))))
           (fast-fn (handler-case (compile-quiet (build-lambda body '((speed 3)(safety 0)(debug 0)))) (error (e) (err-cat e))))
           (safe (if (functionp safe-fn) (run-one safe-fn rows) (format nil "CERR~a" safe-fn)))
           (fast (if (functionp fast-fn) (run-one fast-fn rows) (format nil "CERR~a" fast-fn))))
      (format t "~d~c~a~c~a~%" seed #\Tab safe #\Tab fast)
      (force-output))))

(defun getenv* (k) (or #+ccl (ccl:getenv k) #+sbcl (sb-ext:posix-getenv k) nil))
(let ((show (getenv* "SHOW")))
  (if show
      (let ((seed (parse-integer show)))
        (seed! seed)
        (let ((body (gen-body)) (rows (loop repeat 6 collect (gen-row))))
          (format t "SEED ~d~%BODY ~s~%" seed body)
          (dolist (r rows) (format t "ROW ~s~%" r))
          (format t "SAFE ~a~%" (run-one (compile-quiet (build-lambda body '((speed 0)(safety 3)))) rows))
          (format t "FAST ~a~%" (run-one (compile-quiet (build-lambda body '((speed 3)(safety 0)))) rows))))
      (emit (parse-integer (or (getenv* "START") "0")) (parse-integer (or (getenv* "END") "1000"))))
  #+ccl (ccl:quit 0) #+sbcl (sb-ext:exit :code 0))
