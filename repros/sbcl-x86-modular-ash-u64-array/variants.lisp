  (let ((a (make-array 6 :element-type '(unsigned-byte 64))))
    (setf (aref a 0) (logand v1 +m+))
    (setf (aref a 1) (logand (ash v1 (- (logand v0 63) 20)) +m+))
    (setf (aref a 2) (logand v1 +m+))
    (setf (aref a 3) (logand v1 +m+))
    (setf (aref a 4) (logand v1 +m+))
    (setf (aref a 5) (logand v1 +m+))
    (aref a k)))
(defun v4-correct (v0 v1 k)
  (declare (optimize (speed 0) (safety 3)) (type integer v0 v1) (type (integer 1 1) k))
  (let ((a (make-array 6 :element-type '(unsigned-byte 64))))
    (setf (aref a 0) (logand v1 +m+))
    (setf (aref a 1) (logand (ash v1 (- (logand v0 63) 20)) +m+))
    (setf (aref a 2) (logand v1 +m+))
    (setf (aref a 3) (logand v1 +m+))
    (setf (aref a 4) (logand v1 +m+))
    (setf (aref a 5) (logand v1 +m+))
    (aref a k)))

;; ---- V1b: :initial-contents, index (mod k 3) -> value 1 but type (integer 0 2).
;; Fold defeated; compiler cannot prove which element -> DSE likely also defeated.
(defun v1b-buggy (v0 v1 k)
  (declare (optimize (speed 3) (safety 0)) (type integer v0 v1) (type (integer 0 1000) k))
  (let ((a (make-array 3 :element-type '(unsigned-byte 64)
             :initial-contents (list (logand v1 +m+)
                                      (logand (ash v1 (- (logand v0 63) 20)) +m+)
                                      (logand v1 +m+)))))
    (aref a (mod k 3))))
(defun v1b-correct (v0 v1 k)
  (declare (optimize (speed 0) (safety 3)) (type integer v0 v1) (type (integer 0 1000) k))
  (let ((a (make-array 3 :element-type '(unsigned-byte 64)
             :initial-contents (list (logand v1 +m+)
                                      (logand (ash v1 (- (logand v0 63) 20)) +m+)
                                      (logand v1 +m+)))))
    (aref a (mod k 3))))

;; ---- V2: array ESCAPES (returned); read elt 1 outside. No elision, but all elts live.
(defun v2-buggy (v0 v1)
  (declare (optimize (speed 3) (safety 0)) (type integer v0 v1))
  (make-array 3 :element-type '(unsigned-byte 64)
    :initial-contents (list (logand v1 +m+)
                            (logand (ash v1 (- (logand v0 63) 20)) +m+)
                            (logand v1 +m+))))
(defun v2-correct (v0 v1)
  (declare (optimize (speed 0) (safety 3)) (type integer v0 v1))
  (make-array 3 :element-type '(unsigned-byte 64)
    :initial-contents (list (logand v1 +m+)
                            (logand (ash v1 (- (logand v0 63) 20)) +m+)
                            (logand v1 +m+))))

;; ---- V3: array stored in a struct, then elt 1 read via the accessor.
(defstruct box (arr nil :type (or null (simple-array (unsigned-byte 64) (3)))))
(defun v3-buggy (v0 v1)
  (declare (optimize (speed 3) (safety 0)) (type integer v0 v1))
  (let* ((a (make-array 3 :element-type '(unsigned-byte 64)
              :initial-contents (list (logand v1 +m+)
                                       (logand (ash v1 (- (logand v0 63) 20)) +m+)
                                       (logand v1 +m+))))
         (b (make-box :arr a)))
    (aref (box-arr b) 1)))
(defun v3-correct (v0 v1)
  (declare (optimize (speed 0) (safety 3)) (type integer v0 v1))
  (let* ((a (make-array 3 :element-type '(unsigned-byte 64)
              :initial-contents (list (logand v1 +m+)
                                       (logand (ash v1 (- (logand v0 63) 20)) +m+)
                                       (logand v1 +m+))))
         (b (make-box :arr a)))
    (aref (box-arr b) 1)))

(let* ((v0 64) (v1 9223372036854775807)
       (ref (logand (ash v1 -20) +m+)))
  (format t "~&SBCL ~a ~a  reference=~a~%" (lisp-implementation-version) (machine-type) ref)
  (flet ((emit (name b c)
           (format t "VARIANT ~a: buggy=~a correct=~a ~a~%"
                   name b c (if (eql b c) "OK" "DIVERGE"))))
    (emit "ORIG" (orig-buggy v0 v1) (orig-correct v0 v1))
    (emit "V5"   (v5-buggy v0 v1)   (v5-correct v0 v1))
    (emit "V5L"  (v5l-buggy v0 v1)  (v5l-correct v0 v1))
    (emit "V1a"  (v1a-buggy v0 v1 1) (v1a-correct v0 v1 1))
    (emit "V4"   (v4-buggy v0 v1 1)  (v4-correct v0 v1 1))
    (emit "V1b"  (v1b-buggy v0 v1 4) (v1b-correct v0 v1 4))
    (emit "V2"   (aref (v2-buggy v0 v1) 1) (aref (v2-correct v0 v1) 1))
    (emit "V3"   (v3-buggy v0 v1)   (v3-correct v0 v1))))
(sb-ext:exit)
