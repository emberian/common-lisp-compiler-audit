;;; Root-bug probe: can the SBCL modular variable-shift ASH / dead-store
;;; miscompile still be triggered on current SBCL by shapes the
;;; e938a68 "(aref (vector a) 0) => a" initialize-vector fold cannot touch?
;;;
;;; Essential ingredients kept in every BUGGY variant:
;;;   - a (simple-array (unsigned-byte 64)) with >= 3 modular (logand .. 2^64-1) elements
;;;   - the READ element is a VARIABLE-shift modular ash: (ash v1 (- (logand v0 63) 20))
;;;   - only that one element is read back (so the unread sibling stores are dead -> DSE)
;;; Each prints BUGGY (speed 3 safety 0) vs CORRECT (speed 0 safety 3).

(defconstant +m+ #xFFFFFFFFFFFFFFFF)
;; element-1 value = (logand (ash v1 (- (logand v0 63) 20)) +m+)

;; ---- ORIG: original repro shape (:initial-contents, constant index 1).
;; Folds to the element on >=2.6.9 -> must be CORRECT on 2.6.10, WRONG on 2.6.8.
(defun orig-buggy (v0 v1)
  (declare (optimize (speed 3) (safety 0)) (type integer v0 v1))
  (let ((a (make-array 3 :element-type '(unsigned-byte 64)
             :initial-contents (list (logand v1 +m+)
                                      (logand (ash v1 (- (logand v0 63) 20)) +m+)
                                      (logand v1 +m+)))))
    (aref a 1)))
(defun orig-correct (v0 v1)
  (declare (optimize (speed 0) (safety 3)) (type integer v0 v1))
  (let ((a (make-array 3 :element-type '(unsigned-byte 64)
             :initial-contents (list (logand v1 +m+)
                                      (logand (ash v1 (- (logand v0 63) 20)) +m+)
                                      (logand v1 +m+)))))
    (aref a 1)))

;; ---- V5: make-array + SETF aref stores (NOT an initialize-vector combination),
;; constant read index 1. Fold cannot fire; DSE of dead siblings still can. KEY.
(defun v5-buggy (v0 v1)
  (declare (optimize (speed 3) (safety 0)) (type integer v0 v1))
  (let ((a (make-array 3 :element-type '(unsigned-byte 64))))
    (setf (aref a 0) (logand v1 +m+))
    (setf (aref a 1) (logand (ash v1 (- (logand v0 63) 20)) +m+))
    (setf (aref a 2) (logand v1 +m+))
    (aref a 1)))
(defun v5-correct (v0 v1)
  (declare (optimize (speed 0) (safety 3)) (type integer v0 v1))
  (let ((a (make-array 3 :element-type '(unsigned-byte 64))))
    (setf (aref a 0) (logand v1 +m+))
    (setf (aref a 1) (logand (ash v1 (- (logand v0 63) 20)) +m+))
    (setf (aref a 2) (logand v1 +m+))
    (aref a 1)))

;; ---- V5L: same as V5 but a longer 6-element array, constant read index 1. KEY.
(defun v5l-buggy (v0 v1)
  (declare (optimize (speed 3) (safety 0)) (type integer v0 v1))
  (let ((a (make-array 6 :element-type '(unsigned-byte 64))))
    (setf (aref a 0) (logand v1 +m+))
    (setf (aref a 1) (logand (ash v1 (- (logand v0 63) 20)) +m+))
    (setf (aref a 2) (logand v1 +m+))
    (setf (aref a 3) (logand v1 +m+))
    (setf (aref a 4) (logand v1 +m+))
    (setf (aref a 5) (logand v1 +m+))
    (aref a 1)))
(defun v5l-correct (v0 v1)
  (declare (optimize (speed 0) (safety 3)) (type integer v0 v1))
  (let ((a (make-array 6 :element-type '(unsigned-byte 64))))
    (setf (aref a 0) (logand v1 +m+))
    (setf (aref a 1) (logand (ash v1 (- (logand v0 63) 20)) +m+))
    (setf (aref a 2) (logand v1 +m+))
    (setf (aref a 3) (logand v1 +m+))
    (setf (aref a 4) (logand v1 +m+))
    (setf (aref a 5) (logand v1 +m+))
    (aref a 1)))

;; ---- V1a: :initial-contents but a VARIABLE index of singleton type (integer 1 1).
;; Fold needs a constant-arg index -> gives up; compiler may still prove elt 1 and DSE.
(defun v1a-buggy (v0 v1 k)
  (declare (optimize (speed 3) (safety 0)) (type integer v0 v1) (type (integer 1 1) k))
  (let ((a (make-array 3 :element-type '(unsigned-byte 64)
             :initial-contents (list (logand v1 +m+)
                                      (logand (ash v1 (- (logand v0 63) 20)) +m+)
                                      (logand v1 +m+)))))
    (aref a k)))
(defun v1a-correct (v0 v1 k)
  (declare (optimize (speed 0) (safety 3)) (type integer v0 v1) (type (integer 1 1) k))
  (let ((a (make-array 3 :element-type '(unsigned-byte 64)
             :initial-contents (list (logand v1 +m+)
                                      (logand (ash v1 (- (logand v0 63) 20)) +m+)
                                      (logand v1 +m+)))))
    (aref a k)))

