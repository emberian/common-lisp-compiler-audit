(defstobj st (fld :type (integer 0 10) :initially 0))
(defun bad (st) (declare (xargs :mode :program :stobjs st)) (update-fld 'a st))
(defun rd (st) (declare (xargs :stobjs st)) (if (integerp (fld st)) (+ 1 (fld st)) 'not-integer))
(set-guard-checking nil)
(bad st)
(cw "RESULT ~x0~%" (rd st))
(set-guard-checking :none)
(bad st)
(cw "RESULT ~x0~%" (rd st))
