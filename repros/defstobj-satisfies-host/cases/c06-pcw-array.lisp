(defun pcw (x) (declare (xargs :guard t)) (prog2$ (cw "CALLED pcw ~x0~%" x) (integerp x)))
(defstobj st (ar :type (array (or null (satisfies pcw)) (3)) :initially nil :resizable t))
(cw "RESULT init ~x0~%" (ari 0 st))
(update-ari 0 3 st)
(resize-ar 5 st)
(cw "RESULT ~x0 ~x1 ~x2 ~x3~%" (ari 0 st) (ari 4 st) (ar-length st) (stp st))
(update-ari 1 'a st)
(set-guard-checking nil)
(update-ari 1 'a st)
(cw "RESULT ~x0~%" (ari 1 st))
