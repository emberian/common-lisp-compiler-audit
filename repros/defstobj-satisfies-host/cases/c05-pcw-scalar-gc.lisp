(defun pcw (x) (declare (xargs :guard t)) (prog2$ (cw "CALLED pcw ~x0~%" x) (integerp x)))
(defstobj st (fld :type (or null (satisfies pcw)) :initially nil))
(cw "RESULT init ~x0~%" (fld st))
(update-fld 3 st)
(cw "RESULT after-3 ~x0~%" (fld st))
(update-fld 'a st)
(cw "RESULT stp ~x0 fldp ~x1~%" (stp st) (fldp 'a))
(set-guard-checking :all)
(update-fld 4 st)
(update-fld 'a st)
(cw "RESULT all ~x0~%" (fld st))
(set-guard-checking nil)
(update-fld 5 st)
(update-fld 'a st)
(cw "RESULT nil ~x0~%" (fld st))
(set-guard-checking :none)
(update-fld 6 st)
(update-fld 'a st)
(cw "RESULT none ~x0~%" (fld st))
