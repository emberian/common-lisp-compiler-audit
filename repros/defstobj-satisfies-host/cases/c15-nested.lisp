(defun pcw (x) (declare (xargs :guard t)) (prog2$ (cw "CALLED pcw ~x0~%" x) (integerp x)))
(defstobj child (cf :type (or null (satisfies pcw)) :initially nil))
(defstobj parent (kid :type child) (kids :type (array child (2))))
(defun setk (v parent) (declare (xargs :stobjs parent :guard (or (null v) (integerp v))))
  (stobj-let ((child (kid parent))) (child) (update-cf v child) parent))
(defun getk (parent) (declare (xargs :stobjs parent))
  (stobj-let ((child (kid parent))) (v) (cf child) v))
(setk 3 parent)
(cw "RESULT ~x0~%" (getk parent))
(setk 'a parent)
(set-guard-checking nil)
(setk 'a parent)
(cw "RESULT ~x0~%" (getk parent))
