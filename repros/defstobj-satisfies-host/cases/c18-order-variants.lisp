(defun pcw (x) (declare (xargs :guard t)) (prog2$ (cw "CALLED pcw ~x0~%" x) (integerp x)))
(defstobj s1 (f1 :type (or (satisfies pcw) null) :initially nil))
(defstobj s2 (f2 :type (and (not null) (satisfies pcw)) :initially 0))
(defstobj s3 (f3 :type (and (or null integer) (satisfies pcw)) :initially 0))
(defstobj s4 (f4 :type (or (and null (satisfies pcw)) integer) :initially 0))
(defstobj s5 (f5 :type (not (and null (satisfies pcw))) :initially 0))
(defstobj s6 (f6 :type (or (not (satisfies pcw)) null) :initially nil))
(defstobj s7 (f7 :type (and list (satisfies pcw)) :initially nil))
(defstobj s8 (f8 :type (and symbol (satisfies pcw)) :initially nil))
(defstobj s9 (f9 :type (and atom (not (satisfies pcw))) :initially nil))
(defun d1 (x) (declare (type (or (member :a #\b) (satisfies pcw)) x)) x)
(defun d2 (x) (declare (type (and (member :a 7 #\b) (satisfies pcw)) x)) x)
(cw "RESULT ~x0 ~x1~%" (d1 :a) (d2 7))
