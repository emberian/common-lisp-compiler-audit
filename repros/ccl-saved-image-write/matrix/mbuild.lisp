;; Build the trigger-matrix image.  Args via env: PURIFY (t/nil), PREPEND (t/nil).
(in-package :cl-user)
(defparameter *types*
  '((bit bit 1) (u8 (unsigned-byte 8) 9) (u16 (unsigned-byte 16) 9) (u32 (unsigned-byte 32) 9)
    (u64 (unsigned-byte 64) 9) (s8 (signed-byte 8) -9) (s16 (signed-byte 16) -9)
    (s32 (signed-byte 32) -9) (s64 (signed-byte 64) -9) (fix fixnum -9)
    (sf single-float 9.0f0) (df double-float 9.0d0) (ch character #\Z) (bch base-char #\Z)
    (gv t :nine)))
(defun sym (fmt &rest args) (intern (string-upcase (apply #'format nil fmt args)) :cl-user))
(defun init-for (et) (cond ((subtypep et 'character) #\a) ((subtypep et 'float) (coerce 0 et)) (t 0)))
(defmacro def-all ()
  `(progn
     ,@(loop for (nm et val) in *types*
             for init = (if (eq et t) 0 (init-for et))
             append
             `((defvar ,(sym "*g1-~a*" nm) (make-array 4 :element-type ',et :initial-element ',init))
               (defvar ,(sym "*a-~a*" nm) (make-array 4 :element-type ',et :initial-element ',init))
               (defvar ,(sym "*g2-~a*" nm) (make-array 4 :element-type ',et :initial-element ',init))
               (defun ,(sym "fast-~a" nm) (a i v)
                 (declare (optimize (speed 3) (safety 0)) (type (simple-array ,et (*)) a) (fixnum i) (type ,et v))
                 (setf (aref a i) v))
               (defun ,(sym "safe-~a" nm) (a i v)
                 (declare (type (simple-array ,et (*)) a) (fixnum i) (type ,et v))
                 (setf (aref a i) v))
               (defun ,(sym "undecl-~a" nm) (a i v) (setf (aref a i) v))))))
(def-all)
;; special-variable form
(defun fast-special-u8 (i v)
  (declare (optimize (speed 3) (safety 0)) (type (simple-array (unsigned-byte 8) (*)) *a-u8*) (fixnum i v))
  (setf (aref *a-u8* i) v))
;; a big pre-save vector (many 16K pages) and a writer defined right after it
(defvar *big-u8* (make-array 100000 :element-type '(unsigned-byte 8) :initial-element 0))
(defun fast-big (a i v)
  (declare (optimize (speed 3) (safety 0)) (type (simple-array (unsigned-byte 8) (*)) a) (fixnum i v))
  (setf (aref a i) v))
(defun fill-big (a v)
  (declare (optimize (speed 3) (safety 0)) (type (simple-array (unsigned-byte 8) (*)) a) (fixnum v))
  (dotimes (i (length a)) (setf (aref a i) v)) a)
;; other pre-save mutable things
(defvar *cons* (list 1 2 3))
(defun fast-rplaca (c v) (declare (optimize (speed 3) (safety 0)) (cons c)) (setf (car c) v))
(defvar *str* (make-string 8 :initial-element #\a))
(defvar *ht* (make-hash-table :test 'equal))
(setf (gethash "k" *ht*) 1)
(defstruct pt (x 0 :type fixnum) (d 0d0 :type double-float))
(defvar *pt* (make-pt))
(defvar *bignum* (expt 3 200))
(defvar *boxed-df* 1.5d0)
(let ((purify (equal (ccl:getenv "PURIFY") "t")) (prepend (equal (ccl:getenv "PREPEND") "t")))
  (ccl:save-application "img" :prepend-kernel prepend :purify purify))
