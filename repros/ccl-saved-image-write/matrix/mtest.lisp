;; Run ONE case (env CASE = "<writer>:<type>[:<index>]") in the restarted image.
(in-package :cl-user)
(defun page (addr) (logandc2 addr 16383))
(defun code-range (f)
  (let* ((cv (ccl::uvref f 0)) (a (ccl::%address-of cv)))
    (if (typep cv 'ccl::code-vector) (list a (+ a (* 4 (ccl::uvsize cv)))) (list :not-code-vector (type-of cv)))))
(defun split (s) (loop with st = 0 for p = (position #\: s :start st) collect (subseq s st p) while p do (setq st (1+ p))))
(defun area-of (addr) (cond ((< addr #x302000000000) :readonly) (t :dynamic-or-other)))
(let* ((parts (split (ccl:getenv "CASE")))
       (writer (first parts)) (nm (second parts)) (idx (if (third parts) (parse-integer (third parts)) 1))
       (spec (assoc nm *types* :test #'string-equal))
       (et (second spec)) (val (third spec))
       (arr (symbol-value (sym "*a-~a*" nm)))
       (g1 (symbol-value (sym "*g1-~a*" nm))) (g2 (symbol-value (sym "*g2-~a*" nm)))
       (before (list (copy-seq g1) (copy-seq arr) (copy-seq g2)))
       (fn (cond ((string= writer "fast") (symbol-function (sym "fast-~a" nm)))
                 ((string= writer "safe") (symbol-function (sym "safe-~a" nm)))
                 ((string= writer "undecl") (symbol-function (sym "undecl-~a" nm)))
                 ((string= writer "generic") nil)
                 ((string= writer "special") #'fast-special-u8)
                 ((string= writer "postfast")   ; compiled after restart
                  (compile nil `(lambda (a i v) (declare (optimize (speed 3) (safety 0)) (type (simple-array ,et (*)) a) (fixnum i) (type ,et v)) (setf (aref a i) v))))
                 ((string= writer "newarr")     ; pre-save fast fn, post-save array
                  (setq arr (make-array 4 :element-type et :initial-element (aref arr 0)))
                  (symbol-function (sym "fast-~a" nm)))))
       (aaddr (ccl::%address-of arr)))
  (format t "~&@case ~a arr=~x arr-page=~x area=~a" (ccl:getenv "CASE") aaddr (page aaddr) (area-of aaddr))
  (when fn (let ((cr (code-range fn)))
             (format t " code=~x..~x code-pages=~x..~x same-page=~a" (first cr) (second cr) (page (first cr)) (page (second cr))
                     (if (and (integerp (first cr)) (<= (page (first cr)) (page aaddr) (page (second cr)))) "YES" "no"))))
  (terpri) (finish-output)
  (cond ((null fn) (setf (aref arr idx) val))
        ((string= writer "special") (funcall fn idx val))
        (t (funcall fn arr idx val)))
  (let* ((expect (let ((c (copy-seq (second before)))) (setf (aref c idx) val) c))
         (ok (and (equalp arr expect) (equalp g1 (first before)) (equalp g2 (third before)))))
    (format t "@returned ~s readback=~a~%" arr (if ok "OK" "WRONG")) (finish-output)
    (ccl:gc)
    (format t "@after-gc ~a~%" (if (and (equalp arr expect) (equalp g1 (first before)) (equalp g2 (third before))) "OK" "WRONG")))
  (finish-output)
  (ccl:quit 0))
