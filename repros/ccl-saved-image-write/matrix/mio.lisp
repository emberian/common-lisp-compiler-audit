;; I/O into a purified (pre-save) byte vector: stream read-sequence, and a raw read(2) into the pinned vector.
(with-open-file (s "io.bin" :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)
  (write-sequence (make-array 40000 :element-type '(unsigned-byte 8) :initial-element 7) s))
(with-open-file (s "io.bin" :element-type '(unsigned-byte 8))
  (let ((n (read-sequence *before* s)))
    (format t "@read-sequence n=~d count7=~d~%" n (count 7 *before*))))
(finish-output)
(let ((fd (ccl::fd-open "io.bin" 0)))
  (ccl:with-pointer-to-ivector (p *after*)
    (let ((n (ccl::fd-read fd p 40000)))
      (format t "@raw-read(2) into pre-save vector at ~x: return=~d errno=~d count7=~d~%" (ccl::%address-of *after*) n (if (< n 0) (- n) 0) (count 7 *after*))))
  (ccl::fd-close fd))
(let ((fresh (make-array 40000 :element-type '(unsigned-byte 8) :initial-element 0)) (fd (ccl::fd-open "io.bin" 0)))
  (ccl:with-pointer-to-ivector (p fresh)
    (let ((n (ccl::fd-read fd p 40000))) (format t "@raw-read(2) into fresh vector: return=~d count7=~d~%" n (count 7 fresh))))
  (ccl::fd-close fd))
(finish-output) (ccl:quit 0)
