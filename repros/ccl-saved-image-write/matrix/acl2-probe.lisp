:q
(in-package "ACL2")
(defun pg (a) (logandc2 a 16383))
(let ((st (cdr (assoc 'zst *user-stobj-alist*))))
  (format t "~&@stobj ~a ~x~%" (type-of st) (ccl::%address-of st))
  (loop for i from 0 for nm in '(zu8 zbit zu16 zu32 zu64 zs8 zs32 zs64 zint zdf zch zt zrs zsc zany)
        do (let* ((f (svref st i))
                  (f (if (and (arrayp f) (not (typep f 'simple-array))) (ccl::array-data-and-offset f) f))
                  (upd (intern (format nil "UPDATE-~aI" nm) "ACL2"))
                  (cv (and (fboundp upd) (ccl::uvref (symbol-function upd) 0)))
                  (s1 (and (fboundp upd) (find-symbol (symbol-name upd) "ACL2_*1*_ACL2")))
                  (cv1 (and s1 (fboundp s1) (ccl::uvref (symbol-function s1) 0))))
             (format t "@field ~a type=~s addr=~x page=~x  upd-code-page=~a  *1*-code-page=~a~%" nm (type-of f)
                     (if (or (arrayp f) (consp f)) (ccl::%address-of f) 0)
                     (if (or (arrayp f) (consp f)) (pg (ccl::%address-of f)) 0)
                     (and cv (format nil "~x" (pg (ccl::%address-of cv))))
                     (and cv1 (format nil "~x" (pg (ccl::%address-of cv1))))))))
(finish-output)
(ccl:quit 0)
