;;;; Generation.  An expression is (form . type).

(defvar *restrict* nil "Inside a loop$ body: primitives only.")
(defvar *feats* nil "Swarm: the optional operator groups this program may use.")
(defparameter *all-features* '(:rat :char :str :sym :any :word :listx :numx :df))
(defun feat (f) (and (not *restrict*) (member f *feats*)))
(defvar *feature-bias* 35 "Percent of operator draws given to the optional groups.")
(defvar *int-fns* nil) (defvar *mv-fns* nil) (defvar *list-fns* nil) (defvar *val-fns* nil)
(defvar *st-read-fns* nil) (defvar *st-upd-fns* nil)
(defvar *elem* nil "Program-wide list element type.")
(defparameter *ncap* 12)
(defvar *gensym* 0)
(defun fresh (stem) (intern (format nil "~A~D" stem (incf *gensym*)) :zs))
(defun list-type () (tl 0 *ncap* (second *elem*) (third *elem*)))

(defun lit (c) (cons c (if (integerp c) (ti c c) (nth-value 0 (infer c nil)))))
(defun op1 (op a) (cons `(,op ,(car a)) (xfer op (list (cdr a)))))
(defun op2 (op a b) (cons `(,op ,(car a) ,(car b)) (xfer op (list (cdr a) (cdr b)))))
(defun typed (form env) (cons form (infer form env)))
(defvar *avoid-f1* nil "Refuse LOOP$/LAMBDA$ forms containing an unused binding at generation time.
Off: emission excludes the exact F1/F2 shape instead (FIX-IGNORES in emit.lisp).")
(defun typed-loop (form env)
  (when (and *avoid-f1* (unused-binding-p form)) (invalid :known-finding-f1))
  (typed form env))

(defun random-int-type ()
  (let ((n (pick *seam-bits*)))
    (case (rnd 5)
      ((0 1) (ti (- (pow2 (1- n))) (1- (pow2 (1- n)))))
      (2 (ti 0 (1- (pow2 n))))
      (t (let ((a (random-const)) (b (random-const))) (ti (min a b) (max a b)))))))

(defun fit-int (e tlo thi)
  (let ((ty (cdr e)))
    (if (and (>= (second ty) tlo) (<= (third ty) thi))
        e
        (let* ((w (1+ (- thi tlo)))
               (r (cond ((and (= tlo 0) (= (logcount w) 1) (chance 70))
                         (op2 'logand e (lit thi)))
                        ((and (> w 1) (= (logcount w) 1) (= tlo (- (ash w -1))) (chance 65))
                         (op2 '- (op2 'logand (op2 '+ e (lit (ash w -1))) (lit (1- w)))
                              (lit (ash w -1))))
                        ((chance 50) (op2 'max (lit tlo) (op2 'min (lit thi) e)))
                        (t (op2 '+ (lit tlo) (op2 'mod e (lit w)))))))
          (if (sub-p (cdr r) (ti tlo thi))
              r
              (op2 'max (lit tlo) (op2 'min (lit thi) e)))))))

(defun fit-type (e ty) (fit-int e (second ty) (third ty)))

(defun tame (e)
  (let ((ty (cdr e)))
    (if (and (intp* ty) (> (max (integer-length (second ty)) (integer-length (third ty))) 150))
        (fit-type e (random-int-type))
        e)))

(defun small-int-p (ty)
  (and (intp* ty) (< (max (integer-length (second ty)) (integer-length (third ty))) 300)))
(defun int-vars (env) (remove-if-not (lambda (b) (small-int-p (cdr b))) env))
(defun vars-if (pred env) (remove-if-not (lambda (b) (funcall pred (cdr b))) env))
(defun rat-vars (env) (vars-if (lambda (ty) (and (ratp* ty) (< (integer-length (third ty)) 300))) env))
(defun char-vars (env) (vars-if #'charp* env))
(defun df-vars (env) (vars-if #'dfp* env))
(defun str-vars (env) (vars-if #'strp* env))
(defun sym-vars (env) (vars-if (lambda (ty) (eq ty :sym)) env))
(defun any-vars (env) (vars-if (lambda (ty) (member ty '(:any :pair))) env))
(defun var-expr (b) (cons (car b) (cdr b)))
(defun list-vars (env) (remove-if-not (lambda (b) (listp* (cdr b))) env))
(defun has-st (env) (and (not *restrict*) *fields* (assoc 'zst env)))

(declaim (ftype function gen-int gen-bool gen-list gen-rat gen-char gen-str gen-sym gen-of-type gen-df
                gen-int-x gen-bool-x gen-list-x fit-to))

(defun stobj-read (d env)
  (destructuring-bind (acc upd fty len) (pick *fields*)
    (declare (ignore upd))
    (let ((e (if len
                 (cons `(,acc ,(car (fit-int (gen-int (1- d) env) 0 (1- len))) zst) fty)
                 (cons `(,acc zst) fty))))
      ;; every caller wants an integer: a df or character field is converted
      (cond ((dfp* fty) (op2 'floor (op1 'from-df e) (lit 1)))
            ((charp* fty) (op1 'char-code e))
            (t e)))))

(defun leaf-int (env)
  (let ((iv (int-vars env)) (lv (list-vars env)))
    (cond ((and iv (chance 60)) (let ((b (pick iv))) (cons (car b) (cdr b))))
          ((and lv (chance 45))
           (let* ((b (pick lv)) (l (car b)) (ty (cdr b)))
             (cond ((and (>= (second ty) 1) (chance 60)) (cons `(car ,l) (xfer 'car (list ty))))
                   ((chance 50) (cons `(len ,l) (xfer 'len (list ty))))
                   (t (let ((c (random-const)))
                        (cons `(if (consp ,l) (car ,l) ,c)
                              (if (= (third ty) 0) (ti c c)
                                  (join (ti (fourth ty) (fifth ty)) (ti c c)))))))))
          ((and (has-st env) (chance 50)) (stobj-read 0 env))
          ((and *consts* (chance 35)) (let ((c (pick *consts*))) (cons (car c) (cdr c))))
          (t (lit (random-const))))))

(defun nonzero-divisor (d env)
  (if (chance 60)
      (lit (loop for c = (random-const) unless (zerop c) return c))
      (let ((m (1+ (rnd (pow2 (1+ (rnd 64)))))))
        (if (chance 50) (fit-int (gen-int (1- d) env) 1 m) (fit-int (gen-int (1- d) env) (- m) -1)))))

(defun call-args (ptys d env)
  "Argument forms for parameter types PTYS, or throws INVALID."
  (loop for pty in ptys
        collect (cond ((intp* pty) (car (fit-type (gen-int (1- d) env) pty)))
                      ((listp* pty) (car (gen-list (1- d) env)))
                      ((eq pty :st) (if (has-st env) 'zst (invalid :no-stobj-here)))
                      (t (car (gen-of-type pty (1- d) env))))))

(defun call-of (pred d env)
  "A call of an earlier function whose return type satisfies PRED, or NIL."
  (let ((c (remove-if-not (lambda (e) (funcall pred (third e))) *val-fns*)))
    (and c (not *restrict*) (chance 25)
         (first (valid-or-nil
                  (destructuring-bind (name ptys rty) (pick c)
                    (cons `(,name ,@(call-args ptys d env)) rty)))))))

(defun gen-int-op (d env)
  (when (and *feats* (not *restrict*) (chance *feature-bias*))
    (return-from gen-int-op (gen-int-x d env)))
  (let ((a (gen-int (1- d) env)))
    (flet ((sub () (gen-int (1- d) env)))
      (ecase (rnd 47)
        ((0 1 2) (op2 '+ a (sub)))
        ((3 4) (op2 '- a (sub)))
        ((5 6) (op2 '* a (sub)))
        (7 (op1 '- a))
        (8 (op1 (pick '(1+ 1-)) a))
        ((9 10) (op2 'ash a (lit (- (rnd 91) 70))))
        (11 (op2 'ash a (fit-int (sub) (- (rnd 67)) (rnd 11))))
        ((12 13) (op2 'logand a (sub)))
        ((14 15) (op2 (pick '(logior logxor logeqv logandc1 logandc2 lognand lognor
                              logorc1 logorc2))
                      a (sub)))
        (16 (op1 'lognot a))
        ((17 18) (op2 (pick '(floor truncate mod rem)) a (nonzero-divisor d env)))
        (19 (op1 (pick '(integer-length logcount abs signum)) a))
        (20 (op2 (pick '(min max)) a (sub)))
        ((21 22 23)
         (let ((c (gen-bool (1- d) env)) (b (sub)))
           (cons `(if ,(car c) ,(car a) ,(car b)) (join (cdr a) (cdr b)))))
        (24 (let* ((v (fresh "V")) (body (gen-int (1- d) (acons v (cdr a) env))))
              (cons `(let ((,v ,(car a))) ,(car body)) (cdr body))))
        ((25 26 27)
         (if (and *int-fns* (not *restrict*))
             (destructuring-bind (name ptys rty) (pick *int-fns*)
               (cons `(,name ,@(call-args ptys d env)) rty))
             (op2 '+ a (lit 1))))
        (28 (if (and *mv-fns* (not *restrict*))
                (destructuring-bind (name ptys rty) (pick *mv-fns*)
                  (let* ((p (fresh "P")) (q (fresh "Q"))
                         (body (gen-int (1- d) (list* (cons p (second rty)) (cons q (third rty))
                                                      env))))
                    (cons `(mv-let (,p ,q) (,name ,@(call-args ptys d env)) ,(car body))
                          (cdr body))))
                (op2 '- a (lit 1))))
        (29 (if *restrict*
                (op2 'logxor a (sub))
                (let ((k (1+ (rnd 64))))
                  (ecase (rnd 3)
                    (0 (cons `(mbe :logic (mod ,(car a) ,(pow2 k))
                                   :exec (logand ,(car a) ,(1- (pow2 k))))
                             (ti 0 (1- (pow2 k)))))
                    (1 (cons `(mbe :logic (floor ,(car a) ,(pow2 k)) :exec (ash ,(car a) ,(- k)))
                             (xfer 'ash (list (cdr a) (ti (- k) (- k))))))
                    (2 (let ((j (1+ (rnd 20))))
                         (cons `(mbe :logic (* ,(car a) ,(pow2 j)) :exec (ash ,(car a) ,j))
                               (xfer 'ash (list (cdr a) (ti j j))))))))))
        (30 (let ((sel (fit-int a 0 7)) (arms (loop repeat 4 collect (sub))))
              (cons `(case ,(car sel)
                       (0 ,(car (first arms))) ((1 2) ,(car (second arms)))
                       ((3 5 6) ,(car (third arms))) (otherwise ,(car (fourth arms))))
                    (reduce #'join (mapcar #'cdr arms)))))
        (31 (op2 'expt (fit-int a -9 9) (lit (rnd 6))))
        (32 (let* ((b (sub)) (p (fresh "P")) (q (fresh "Q"))
                   (body (gen-int (1- d) (list* (cons p (cdr a)) (cons q (cdr b)) env))))
              (cons `(mv-let (,p ,q) (mv ,(car a) ,(car b)) ,(car body)) (cdr body))))
        ((33 34) (if (has-st env) (stobj-read d env) (op2 'logior a (sub))))
        ((35 36 37)
         (if *restrict*
             (op2 '+ a (sub))
             (let* ((v (fresh "X")) (l (gen-list (1- d) env))
                    (benv (acons v (ti (fourth (cdr l)) (fifth (cdr l))) (int-vars env)))
                    (body (let ((*restrict* t)) (gen-int (max 1 (- d 2)) benv))))
               (typed-loop (if (chance 30)
                          `(loop$ for ,v in ,(car l) when ,(let ((*restrict* t))
                                                             (car (gen-bool 1 benv)))
                                  sum ,(car body))
                          `(loop$ for ,v in ,(car l) sum ,(car body)))
                      env))))
        ((38 39)
         (if *restrict*
             (op2 '- a (sub))
             (let* ((v (fresh "K")) (lo (fit-int a 0 6)) (hi (fit-int (sub) 0 9))
                    (benv (acons v (ti 0 10) (int-vars env)))
                    (body (let ((*restrict* t)) (gen-int (max 1 (- d 2)) benv))))
               (typed-loop `(loop$ for ,v from ,(car lo) to ,(car hi) sum ,(car body)) env))))
        (40 (cons `(zm-inc ,(car a)) (xfer '1+ (list (cdr a)))))
        (41 (cons `(zm-id ,(car a)) (cdr a)))
        (42 (let ((c (gen-bool (1- d) env)) (b (sub)))
              (cons `(zm-sel ,(car c) ,(car a) ,(car b)) (join (cdr a) (cdr b)))))
        (43 (if *restrict*
                (op2 '+ a (sub))
                (cons `(let ((,(fresh "U") ,(car (sub)))) ,(car a)) (cdr a))))
        ((44 45 46)
         (if *restrict*
             (op2 '- a (sub))
             (let* ((b (sub)) (p (fresh "A")) (q (fresh "B"))
                    (body (let ((*restrict* t))
                            (gen-int (max 1 (- d 2)) (list (cons p (cdr a)) (cons q (cdr b)))))))
               (typed-loop `(apply$ (lambda$ (,p ,q) ,(car body)) (list ,(car a) ,(car b)))
                           env))))))))

(defun gen-int (d env)
  (if (or (<= d 0) (chance 10))
      (leaf-int env)
      (let ((r (valid-or-nil (tame (gen-int-op d env)))))
        (if r (first r) (leaf-int env)))))

(defun gen-bool-form (d env)
  (let* ((a (gen-int (1- d) env)) (fa (car a)) (ty (cdr a))
         (lv (list-vars env)))
    (flet ((near () (const-in (second ty) (third ty))))
      (case (if (<= d 1) (rnd 13) (rnd 17))
        (0 `(< ,fa ,(near))) (1 `(<= ,fa ,(near))) (2 `(> ,fa ,(near)))
        (3 `(>= ,fa ,(near))) (4 `(= ,fa ,(near))) (5 `(/= ,fa ,(near)))
        (6 `(,(pick '(< <= > >= = /=)) ,fa ,(car (gen-int (1- d) env))))
        (7 `(,(pick '(evenp oddp zip)) ,fa))
        (8 `(logbitp ,(rnd 70) ,fa))
        (9 `(signed-byte-p ,(pick *seam-bits*) ,fa))
        (10 `(unsigned-byte-p ,(pick *seam-bits*) ,fa))
        (11 `(eql ,fa ,(near)))
        (12 (if lv `(,(pick '(consp endp)) ,(car (pick lv))) `(oddp ,fa)))
        (13 `(not ,(gen-bool-form (1- d) env)))
        (14 `(and ,(gen-bool-form (1- d) env) ,(gen-bool-form (1- d) env)))
        (15 `(or ,(gen-bool-form (1- d) env) ,(gen-bool-form (1- d) env)))
        (t (if (and lv (not *restrict*))
               (let* ((v (fresh "X")) (b (pick lv))
                      (benv (acons v (ti (fourth (cdr b)) (fifth (cdr b))) (int-vars env))))
                 `(loop$ for ,v in ,(car b) always
                         ,(let ((*restrict* t)) (gen-bool-form 1 benv))))
               `(evenp ,fa)))))))

(defun gen-bool (d env)
  (cons (or (and *feats* (not *restrict*) (chance *feature-bias*)
                 (let ((r (valid-or-nil (gen-bool-x d env))))
                   (and r (valid-or-nil (infer (first r) env)) (first r))))
            (gen-bool-form d env))
        :bool))

(defun literal-list ()
  (let ((n (rnd 6)))
    (if (= n 0)
        (cons nil (tl 0 0 0 0))
        (let ((l (loop repeat n collect (const-in (second *elem*) (third *elem*)))))
          (cons `(quote ,l) (tl n n (reduce #'min l) (reduce #'max l)))))))

(defun leaf-list (env)
  (let ((lv (remove-if-not (lambda (b) (sub-p (cdr b) (list-type))) (list-vars env))))
    (if (and lv (chance 75))
        (let ((b (pick lv))) (cons (car b) (cdr b)))
        (literal-list))))

(defun gen-list-op (d env)
  (when (and (feat :listx) (chance *feature-bias*))
    (return-from gen-list-op (gen-list-x d env)))
  (let ((l (gen-list (1- d) env)))
    (flet ((elem () (fit-type (gen-int (1- d) env) *elem*)))
      (ecase (rnd 12)
        ((0 1) (op2 'cons (elem) l))
        (2 (op1 'cdr l))
        (3 (let ((c (gen-bool (1- d) env)) (m (gen-list (1- d) env)))
             (cons `(if ,(car c) ,(car l) ,(car m)) (join (cdr l) (cdr m)))))
        ((4 5) (if (and *list-fns* (not *restrict*))
                   (destructuring-bind (name ptys rty) (pick *list-fns*)
                     (cons `(,name ,@(call-args ptys d env)) rty))
                   (op1 'cdr l)))
        ((6 7) (if *restrict*
                   l
                   (let* ((v (fresh "X"))
                          (benv (acons v (ti (fourth (cdr l)) (fifth (cdr l))) (int-vars env)))
                          (body (let ((*restrict* t))
                                  (fit-type (gen-int (max 1 (- d 2)) benv) *elem*))))
                     (typed-loop `(loop$ for ,v in ,(car l) collect ,(car body)) env))))
        (8 (if *restrict*
               l
               (let* ((v (fresh "K")) (lo (fit-int (gen-int (1- d) env) 0 4))
                      (hi (fit-int (gen-int (1- d) env) 0 8))
                      (benv (acons v (ti 0 9) (int-vars env)))
                      (body (let ((*restrict* t))
                              (fit-type (gen-int (max 1 (- d 2)) benv) *elem*))))
                 (typed-loop `(loop$ for ,v from ,(car lo) to ,(car hi) collect ,(car body)) env))))
        (9 (op2 'append l (gen-list (1- d) env)))
        (10 (op2 'nthcdr (fit-int (gen-int (1- d) env) 0 3) l))
        (11 (cons `(list ,(car (elem)) ,(car (elem))) (tl 2 2 (second *elem*) (third *elem*))))))))

(defun gen-list (d env)
  (if (or (<= d 0) (chance 25))
      (leaf-list env)
      (let ((r (valid-or-nil (gen-list-op d env))))
        (if (and r (sub-p (cdr (first r)) (list-type)) (<= (third (cdr (first r))) *ncap*))
            (first r)
            (leaf-list env)))))

;;;; Optional operator groups (swarm features)

(defparameter *sym-pool* '(zsa zsb zsc zsd zse :zka :zkb))
(defparameter *edge-types*
  (flet ((s (n) (list :int (- (pow2 (1- n))) (1- (pow2 (1- n))))) (u (n) (list :int 0 (1- (pow2 n)))))
    (list (u 64) (s 64) (u 63) (s 63) (u 62) (s 62) (u 61) (s 61) (u 60) (s 60) (u 32) (s 32)
          (u 31) (u 16) (u 8) (s 65) (u 65))))
(defparameter *divisors*
  (list 2 3 4 5 7 8 10 16 100 1000 255 256 65536 -1 -2 -3 -8 -10 (pow2 31) (pow2 32) (1- (pow2 32))
        (pow2 60) (pow2 61) (pow2 62) (pow2 63) (1- (pow2 63)) (pow2 64) (- (pow2 62)) (- (pow2 63))))

(defun edge-operand (d env) (fit-type (gen-int (1- d) env) (pick *edge-types*)))

(defun lit-char (lo hi)
  (let* ((slo (max lo 33)) (shi (min hi 126)))
    (if (and (<= slo shi) (chance 85))
        (let ((c (+ slo (rnd (1+ (- shi slo))))))
          (cons (code-char c) (tc c c)))
        (let ((c (+ lo (rnd (1+ (- hi lo)))))) (cons `(code-char ,c) (tc c c))))))

(defun lit-str (nlo nhi clo chi)
  "A string literal with length in [NLO,NHI] and printable character codes in [CLO,CHI]."
  (let* ((slo (max clo 35)) (shi (min chi 126)) (n (+ nlo (rnd (1+ (- (min nhi (+ nlo 6)) nlo))))))
    (when (and (> n 0) (> slo shi)) (invalid :no-printable-char))
    (let ((s (coerce (loop repeat n
                           collect (loop for c = (+ slo (rnd (1+ (- shi slo))))
                                         unless (member c '(92 124)) return (code-char c)))
                     'string)))
      (cons s (nth-value 0 (infer s nil))))))

(defun lit-rat (lo hi d)
  (let* ((k (min (or d 1000) (pick '(2 3 4 5 7 8 16 100 1000))))
         (k (max 1 k))
         (n (+ (* lo k) (rnd (1+ (* (- hi lo) k)))))
         (q (/ n k)))
    (cons q (nth-value 0 (infer q nil)))))

(defun fit-rat (e pty)
  (if (sub-p (cdr e) pty)
      e
      (destructuring-bind (lo hi pd) (cdr pty)
        (let* ((ety (cdr e)) (ed (rat-den ety))
               (e (if (and pd (or (null ed) (> ed pd)))
                      (let ((k (ash 1 (min 20 (1- (integer-length pd))))))
                        (op2 '/ (op2 'floor (op2 '* (lit k) e) (lit 1)) (lit k)))
                      e)))
          (if (sub-p (cdr e) pty) e (op2 'max (lit lo) (op2 'min (lit hi) e)))))))

(defun fit-to (e ty)
  "E coerced into type TY by a form whose inferred type is within TY, or INVALID."
  (cond ((sub-p (cdr e) ty) e)
        ((and (intp* ty) (intp* (cdr e))) (fit-type e ty))
        ((and (ratp* ty) (nump* (cdr e))) (fit-rat e ty))
        ((and (charp* ty) (charp* (cdr e)))
         (op1 'code-char (fit-int (op1 'char-code e) (second ty) (third ty))))
        ((and (strp* ty) (strp* (cdr e)))
         (destructuring-bind (nlo nhi clo chi) (cdr ty)
           (let* ((ety (cdr e))
                  (e (if (< (second ety) nlo)
                         (op2 'string-append e (lit-str (- nlo (second ety)) (- nlo (second ety)) clo chi))
                         e))
                  (e (if (> (third (cdr e)) nhi)
                         (typed `(subseq ,(car e) 0 ,nlo) nil)
                         e)))
             (if (sub-p (cdr e) ty) e (invalid :string-fit)))))
        (t (invalid :no-fit (cdr e) ty))))

(defun gen-num (d env) (if (chance 50) (gen-int d env) (gen-rat d env)))

(defun gen-rat-op (d env)
  (let ((a (gen-rat (1- d) env)))
    (ecase (rnd 12)
      ((0 1) (op2 '+ a (gen-num (1- d) env)))
      (2 (op2 '- a (gen-num (1- d) env)))
      (3 (op2 '- (gen-num (1- d) env) a))
      ((4 5) (op2 '* a (gen-num (1- d) env)))
      ((6 7) (op2 '/ (gen-num (1- d) env) (nonzero-divisor d env)))
      (8 (op1 (pick '(- abs)) a))
      (9 (op2 (pick '(min max)) a (gen-num (1- d) env)))
      (10 (let ((c (gen-bool (1- d) env)) (b (gen-rat (1- d) env)))
            (cons `(if ,(car c) ,(car a) ,(car b)) (join (cdr a) (cdr b)))))
      (11 (op2 '/ a (lit (pick '(2 3 4 -5 8 10 1024))))))))

(defun gen-rat (d env)
  (flet ((leaf ()
           (let ((rv (rat-vars env)))
             (cond ((and rv (chance 65)) (var-expr (pick rv)))
                   ((and (> d 0) (call-of #'ratp* d env)))
                   ((chance 50) (lit-rat -20 20 nil))
                   (t (op2 '/ (leaf-int env) (lit (pick '(2 3 7 16 -3 1000)))))))))
    (if (or (<= d 0) (chance 15))
        (leaf)
        (let* ((r (valid-or-nil (gen-rat-op d env))) (e (and r (first r))))
          (if (and e (nump* (cdr e)) (rat-den (cdr e))
                   (< (integer-length (rat-den (cdr e))) 90)
                   (< (max (integer-length (second (cdr e))) (integer-length (third (cdr e)))) 130))
              e
              (leaf))))))

(defun gen-char (d env)
  (let ((cv (char-vars env)) (sv (remove-if-not (lambda (b) (>= (second (cdr b)) 1)) (str-vars env))))
    (if (or (<= d 0) (chance 25))
        (cond ((and cv (chance 70)) (var-expr (pick cv)))
              ((and (> d 0) (call-of #'charp* d env)))
              (t (lit-char 0 255)))
        (or (first
             (valid-or-nil
               (ecase (rnd 6)
                 (0 (op1 'code-char (fit-int (gen-int (1- d) env) 0 (pick '(255 127 255)))))
                 (1 (op1 (pick '(char-upcase char-downcase)) (gen-char (1- d) env)))
                 (2 (if sv
                        (let ((b (pick sv)))
                          (typed `(char ,(car b) ,(car (fit-int (gen-int (1- d) env) 0
                                                                (1- (second (cdr b))))))
                                 env))
                        (invalid :no-string)))
                 (3 (let ((c (gen-bool (1- d) env)) (a (gen-char (1- d) env)) (b (gen-char (1- d) env)))
                      (cons `(if ,(car c) ,(car a) ,(car b)) (join (cdr a) (cdr b)))))
                 (4 (let ((s (gen-str (1- d) env)))
                      (if (>= (second (cdr s)) 1)
                          (typed `(char ,(car s) ,(rnd (second (cdr s)))) env)
                          (invalid :empty-string))))
                 (5 (if cv (var-expr (pick cv)) (lit-char 32 126))))))
            (lit-char 0 255)))))

(defun gen-str (d env)
  (let ((sv (remove-if-not (lambda (b) (<= (third (cdr b)) 64)) (str-vars env))))
    (flet ((leaf () (cond ((and sv (chance 70)) (var-expr (pick sv)))
                          ((and (> d 0) (call-of (lambda (ty) (and (strp* ty) (<= (third ty) 64)))
                                                 d env)))
                          (t (lit-str 0 8 0 255)))))
      (if (or (<= d 0) (chance 25))
          (leaf)
          (let* ((r (valid-or-nil
                      (ecase (rnd 9)
                        ((0 1) (op2 'string-append (gen-str (1- d) env) (gen-str (1- d) env)))
                        (2 (op1 (pick '(string-upcase string-downcase)) (gen-str (1- d) env)))
                        (3 (let* ((s (gen-str (1- d) env)) (n (second (cdr s))))
                             (when (< n 1) (invalid :short))
                             (let* ((b (1+ (rnd n))) (a (rnd (1+ b))))
                               (typed `(subseq ,(car s) ,a ,b) env))))
                        (4 (typed `(coerce (list ,@(loop repeat (1+ (rnd 3))
                                                         collect (car (gen-char (1- d) env))))
                                           'string)
                                  env))
                        (5 (op1 'string (gen-char (1- d) env)))
                        (6 (op1 'reverse (gen-str (1- d) env)))
                        (7 (let ((c (gen-bool (1- d) env)) (a (gen-str (1- d) env)) (b (gen-str (1- d) env)))
                             (cons `(if ,(car c) ,(car a) ,(car b)) (join (cdr a) (cdr b)))))
                        (8 (let ((s (gen-str (1- d) env)) (v (fresh "S")))
                             (cons `(let ((,v ,(car s))) (string-append ,v ,v))
                                   (xfer 'string-append (list (cdr s) (cdr s)))))))))
                 (e (and r (first r))))
            (if (and e (strp* (cdr e)) (<= (third (cdr e)) 64)) e (leaf)))))))

(defun gen-sym (d env)
  (let ((sv (sym-vars env)))
    (flet ((leaf ()
             (if (and sv (chance 65)) (var-expr (pick sv))
                 (let ((s (pick *sym-pool*))) (cons (if (keywordp s) s `(quote ,s)) :sym)))))
      (if (or (<= d 0) (chance 40))
          (leaf)
          (ecase (rnd 3)
            (0 (let ((c (gen-bool (1- d) env)) (a (gen-sym (1- d) env)) (b (gen-sym (1- d) env)))
                 (cons `(if ,(car c) ,(car a) ,(car b)) :sym)))
            (1 (if (feat :str)
                   (cons `(intern-in-package-of-symbol
                           ,(car (if (chance 50) (lit-str 1 6 65 90) (op1 'symbol-name (gen-sym (1- d) env))))
                           ,(car (gen-sym (1- d) env)))
                         :sym)
                   (leaf)))
            (2 (leaf)))))))

(defun gen-of-type (ty d env)
  "An expression whose inferred type is within TY."
  (cond ((intp* ty) (fit-type (gen-int d env) ty))
        ((ratp* ty) (fit-rat (gen-rat d env) ty))
        ((charp* ty) (fit-to (gen-char d env) ty))
        ((strp* ty)
         (let ((e (gen-str d env)))
           (or (first (valid-or-nil (fit-to e ty)))
               (lit-str (second ty) (third ty) (fourth ty) (fifth ty)))))
        ((eq ty :sym) (gen-sym d env))
        ((dfp* ty) (let ((e (gen-df d env))) (if (sub-p (cdr e) ty) e (invalid :df-fit))))
        ((listp* ty) (let ((e (gen-list d env))) (if (sub-p (cdr e) ty) e (invalid :list-fit))))
        ((eq ty :bool) (gen-bool d env))
        ((eq ty :any)
         (let ((av (any-vars env)))
           (if (and av (chance 50))
               (var-expr (pick av))
               (ecase (rnd 5)
                 (0 (gen-int d env)) (1 (gen-rat d env)) (2 (gen-char d env))
                 (3 (gen-str d env)) (4 (gen-sym d env))))))
        (t (invalid :cannot-generate ty))))

(defun sym-case (d env)
  (let ((s (gen-sym (1- d) env)) (arms (loop repeat 3 collect (gen-int (1- d) env))))
    (cons `(case ,(car s)
             (,(first *sym-pool*) ,(car (first arms)))
             ((,(second *sym-pool*) ,(sixth *sym-pool*)) ,(car (second arms)))
             (otherwise ,(car (third arms))))
          (reduce #'join (mapcar #'cdr arms)))))

(defun random-alist (keyfn)
  `(quote ,(loop for k in (remove-duplicates (loop repeat (+ 2 (rnd 5)) collect (funcall keyfn))
                                             :test #'equal)
                 collect (cons k (rnd 1000)))))

(defun gen-int-x (d env)
  "An integer expression from one of the enabled optional groups."
  (let ((f (pick *feats*)))
    (flet ((int () (gen-int (1- d) env)))
      (ecase f
        (:word
         (let* ((a (edge-operand d env)) (w (pick '(64 64 63 62 61 60 32))) (m (1- (pow2 w))))
           (ecase (rnd 12)
             ((0 1) (op2 'logand (op2 (pick '(+ - *)) a (edge-operand d env)) (lit m)))
             (2 (op2 'logand (op2 'ash a (lit (rnd 65))) (lit m)))
             (3 (op2 'logand (op2 'ash a (fit-int (int) 0 (pick '(63 64 31 61)))) (lit m)))
             (4 (op2 'logand (op1 (pick '(lognot -)) a) (lit m)))
             (5 (op2 'ash (op2 'logand a (lit m)) (lit (- (rnd 65)))))
             (6 (op2 '- (op2 'logand (op2 '+ (op2 (pick '(+ - *)) a (edge-operand d env))
                                          (lit (pow2 (1- w))))
                             (lit m))
                     (lit (pow2 (1- w)))))
             ((7 8) (op2 (pick '(truncate floor ceiling round mod rem)) a (lit (pick *divisors*))))
             (9 (op1 (pick '(integer-length logcount)) a))
             (10 (op2 '* a (lit (pick (list 2 3 4 5 8 10 -1 -3 (pow2 31) (pow2 32) 65537)))))
             (11 (op2 (pick '(logior logxor logand)) (op2 'ash a (lit (- (rnd 70) 6)))
                      (edge-operand d env))))))
        (:numx
         (let ((a (int)))
           (ecase (rnd 6)
             ((0 1) (op2 (pick '(ceiling round)) a (nonzero-divisor d env)))
             (2 (op2 'expt (lit 2) (fit-int a 0 6)))
             (3 (op1 'abs (op2 '- a (int))))
             (4 (op2 'ash (lit (pick '(1 -1 3 255))) (fit-int a 0 (pick '(62 63 64 70)))))
             (5 (op2 (pick '(floor truncate mod rem ceiling round)) (edge-operand d env)
                     (fit-int (int) 1 (pick (list 7 255 (pow2 32) (1- (pow2 63))))))))))
        (:rat
         (let ((r (gen-rat (1- d) env)))
           (ecase (rnd 5)
             ((0 1) (op2 (pick '(floor ceiling truncate round)) r (lit (pick '(1 1 2 -3 10)))))
             (2 (op2 (pick '(floor ceiling truncate round)) r (nonzero-divisor d env)))
             (3 (op1 'numerator r))
             (4 (op1 'denominator r)))))
        (:char
         (let ((c (gen-char (1- d) env)))
           (ecase (rnd 4)
             ((0 1) (op1 'char-code c))
             (2 (op1 'nfix (op1 'digit-char-p c)))
             (3 (let ((arms (loop repeat 3 collect (int))))
                  (cons `(case ,(car c) (#\a ,(car (first arms))) ((#\B #\0) ,(car (second arms)))
                           (otherwise ,(car (third arms))))
                        (reduce #'join (mapcar #'cdr arms))))))))
        (:str
         (let ((s (gen-str (1- d) env)))
           (ecase (rnd 5)
             ((0 1) (op1 'length s))
             (2 (op1 'nfix (op2 (pick '(string< string> string<= string>=)) s (gen-str (1- d) env))))
             (3 (op1 'nfix (op2 'search (lit-str 1 2 65 122) s)))
             (4 (typed `(nfix (cdr (assoc-equal ,(car s) ,(random-alist (lambda () (car (lit-str 0 3 65 90)))))))
                       env)))))
        (:sym
         (ecase (rnd 3)
           (0 (sym-case d env))
           (1 (typed `(nfix (cdr (assoc-eq ,(car (gen-sym (1- d) env))
                                           ,(random-alist (lambda () (pick *sym-pool*))))))
                     env))
           (2 (op1 'length (op1 (pick '(symbol-name symbol-package-name)) (gen-sym (1- d) env))))))
        (:listx
         (let ((l (gen-list (1- d) env)))
           (ecase (rnd 6)
             (0 (op2 'count (int) l))
             (1 (op1 'nfix (op2 'position (int) l)))
             (2 (op1 'length l))
             (3 (if (>= (second (cdr l)) 2) (op1 'cadr l) (op1 'len l)))
             (4 (typed `(nfix (cdr (assoc ,(car (int)) ,(random-alist (lambda () (- (rnd 9) 4))))))
                       env))
             (5 (op1 'len (op1 (pick '(remove-duplicates reverse last)) l))))))
        (:any
         (let ((av (any-vars env)))
           (if av
               (op1 'len (var-expr (pick av)))
               (gen-int (1- d) env))))
        (:df (op2 (pick '(floor truncate ceiling round)) (op1 'from-df (gen-df (1- d) env))
                  (lit (pick '(1 1 2 -3 7)))))))))

(defun gen-bool-x (d env)
  "A test form from one of the enabled optional groups."
  (let ((f (pick *feats*)))
    (flet ((int () (gen-int (1- d) env)))
      (car
       (ecase f
         (:word (let ((a (edge-operand d env)))
                  (ecase (rnd 5)
                    (0 (op2 'logtest a (lit (pick (list 1 255 (pow2 62) (pow2 63) (1- (pow2 64)))))))
                    (1 (op2 'logtest a (edge-operand d env)))
                    (2 (op2 'logbitp (fit-int (int) 0 (pick '(61 62 63 64 70))) a))
                    (3 (op2 (pick '(< <= > >= = /=)) a (edge-operand d env)))
                    (4 (op2 (pick '(< > =)) (op2 'logand a (lit (1- (pow2 (pick '(62 63 64))))))
                            (lit (pick (list 0 (pow2 61) (pow2 62) (1- (pow2 63))))))))))
         (:numx (op1 (pick '(zerop plusp minusp evenp oddp)) (int)))
         (:rat (let ((r (gen-rat (1- d) env)))
                 (ecase (rnd 3)
                   (0 (op2 (pick '(< <= > >= = /=)) r (gen-num (1- d) env)))
                   (1 (op1 (pick '(zerop plusp minusp integerp)) r))
                   (2 (op2 (pick '(< > =)) r (lit (pick '(0 1 -1 1/2 -7/3))))))))
         (:char (let ((c (gen-char (1- d) env)))
                  (ecase (rnd 4)
                    (0 (op2 (pick '(char< char> char<= char>= char-equal eql)) c (gen-char (1- d) env)))
                    (1 (op1 (pick '(upper-case-p lower-case-p alpha-char-p standard-char-p digit-char-p)) c))
                    (2 (op2 'eql c (lit-char 32 126)))
                    (3 (op2 (pick '(< > =)) (op1 'char-code c) (lit (pick '(0 32 65 97 127 128 255))))))))
         (:str (let ((s (gen-str (1- d) env)))
                 (ecase (rnd 3)
                   (0 (op2 (pick '(string-equal string< string> string<= string>= equal search)) s
                           (gen-str (1- d) env)))
                   (1 (op2 'equal s (lit-str 0 3 65 122)))
                   (2 (op2 (pick '(< = >)) (op1 'length s) (lit (rnd 5)))))))
         (:sym (let ((s (gen-sym (1- d) env)))
                 (ecase (rnd 3)
                   (0 (op2 'eq s (gen-sym (1- d) env)))
                   (1 (op1 'keywordp s))
                   (2 (typed `(member-eq ,(car s) (quote ,(list (pick *sym-pool*) (pick *sym-pool*)))) env)))))
         (:listx (let ((l (gen-list (1- d) env)))
                   (ecase (rnd 3)
                     (0 (op2 'member (int) l))
                     (1 (op2 'subsetp l (gen-list (1- d) env)))
                     (2 (op2 'equal l (gen-list (1- d) env))))))
         (:df (let ((a (gen-df (1- d) env)))
                (if (chance 70)
                    (op2 (pick '(df< df<= df=)) a (gen-df (1- d) env))
                    (op2 (pick '(< > =)) (op1 'from-df a) (lit (pick '(0 1 -1 1/2)))))))
         (:any (let ((av (any-vars env)))
                 (if av
                     (let ((v (var-expr (pick av))))
                       (if (chance 70)
                           (op1 (pick *any-preds*) v)
                           (op2 'equal v (gen-of-type :any (1- d) env))))
                     (op1 (pick *any-preds*) (gen-of-type :any (1- d) env))))))))))

(defun gen-list-x (d env)
  (let ((l (gen-list (1- d) env)))
    (flet ((int () (gen-int (1- d) env))
           (elem () (fit-type (gen-int (1- d) env) *elem*)))
      (ecase (rnd 12)
        (0 (op1 'reverse l))
        (1 (op2 'revappend l (gen-list (1- d) env)))
        (2 (op1 'last l))
        (3 (op2 'butlast l (lit (rnd 4))))
        (4 (op2 'take (lit (rnd (1+ (min 4 (second (cdr l)))))) l))
        (5 (op2 'remove (int) l))
        (6 (op1 'remove-duplicates l))
        (7 (op2 (pick '(union$ intersection$ set-difference$)) l (gen-list (1- d) env)))
        (8 (op2 'add-to-set (elem) l))
        (9 (typed `(make-list ,(car (fit-int (int) 0 5)) :initial-element ,(car (elem))) env))
        (10 (typed `(list* ,(car (elem)) ,(car (elem)) ,(car l)) env))
        (11 (if (>= (second (cdr l)) 1)
                (let ((b (1+ (rnd (second (cdr l))))))
                  (typed `(subseq ,(car l) ,(rnd (1+ b)) ,b) env))
                (op1 'cdr l)))))))

(defun gen-df (d env)
  "An ACL2 double-float (df) expression."
  (flet ((leaf ()
           (let ((dv (df-vars env)))
             (cond ((and dv (chance 65)) (var-expr (pick dv)))
                   ((chance 50) (op1 'to-df (lit-rat -64 64 nil)))
                   (t (op1 'to-df (fit-int (leaf-int env) -1024 1024)))))))
    (if (or (<= d 0) (chance 20))
        (leaf)
        (or (safely-gen
             (lambda ()
               (let ((a (gen-df (1- d) env)))
                 (ecase (rnd 10)
                   ((0 1) (op2 'df+ a (gen-df (1- d) env)))
                   (2 (op2 'df- a (gen-df (1- d) env)))
                   ((3 4) (op2 'df* a (gen-df (1- d) env)))
                   (5 (op2 'df/ a (op1 'to-df (fit-int (gen-int (1- d) env) 1 (pick '(3 100 1024))))))
                   (6 (op1 (pick '(df- df-abs)) a))
                   (7 (op1 'df-sqrt (op1 'df-abs a)))
                   (8 (let ((c (gen-bool (1- d) env)) (b (gen-df (1- d) env)))
                        (cons `(if ,(car c) ,(car a) ,(car b)) (join (cdr a) (cdr b)))))
                   (9 (op1 'to-df (if (chance 50) (gen-rat (1- d) env)
                                      (fit-int (gen-int (1- d) env) -4096 4096))))))))
            (leaf)))))

(defun safely-gen (thunk) (first (valid-or-nil (funcall thunk))))
