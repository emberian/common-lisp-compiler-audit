
;;;; Randomness and constants

(defvar *rs*)
(defun rnd (n) (random n *rs*))
(defun pick (seq) (elt seq (rnd (length seq))))
(defun chance (pct) (< (rnd 100) pct))
(defun pow2 (k) (ash 1 k))

(defparameter *seam-bits*
  '(1 2 3 7 8 9 15 16 17 28 29 30 31 32 33 59 60 61 62 63 64 65 66 127 128 129))

(defun random-const ()
  (case (rnd 7)
    (0 (- (rnd 17) 8))
    (1 (+ (pow2 (pick *seam-bits*)) (- (rnd 5) 2)))
    (2 (- (+ (pow2 (pick *seam-bits*)) (- (rnd 5) 2))))
    (3 (1- (pow2 (1- (pick *seam-bits*)))))
    (4 (- (pow2 (1- (pick *seam-bits*)))))
    (5 (- (rnd (pow2 (1+ (rnd 66)))) (rnd (pow2 (1+ (rnd 66))))))
    (t (rnd 1000))))

(defun const-in (lo hi)
  (flet ((ok (x) (and (<= lo x) (<= x hi) x)))
    (or (case (rnd 8)
          (0 lo) (1 hi) (2 (ok (1+ lo))) (3 (ok (1- hi)))
          (4 (ok (pick '(0 1 -1 2 -2)))) (5 (ok (random-const))) (t nil))
        (+ lo (rnd (1+ (- hi lo)))))))

;;; Declared here, before any function that binds them is compiled.
(defvar *trace* nil "When a list cell: INFER pushes (form env type restricted) for each compound form.")
(defvar *in-restrict* nil "True while inferring a loop$ or lambda$ body.")
(defvar *ann* nil "THE density in percent while annotating, or NIL")
(defvar *restrict* nil "Inside a loop$ body: primitives only.")
(defvar *feats* nil "Swarm: the optional operator groups this program may use.")
(defvar *gensym* 0)

;;;; Abstract types
;;;   (:int lo hi)   :bool   (:list nlo nhi elo ehi)   (:mv t1 t2)   :st

(defun invalid (&rest why) (throw 'invalid (cons :invalid why)))
(defmacro valid-or-nil (&body body)
  "Value of BODY, or NIL if it threw INVALID."
  `(let ((r (catch 'invalid (multiple-value-list (progn ,@body)))))
     (if (and (consp r) (eq (car r) :invalid)) nil r)))

(defun ti (lo hi)
  (when (> (max (integer-length lo) (integer-length hi)) 220) (invalid :too-wide))
  (list :int lo hi))
(defun tl (nlo nhi elo ehi) (list :list nlo nhi elo ehi))
(defun intp* (ty) (and (consp ty) (eq (car ty) :int)))
(defun listp* (ty) (and (consp ty) (eq (car ty) :list)))

(defparameter *inf* (ash 1 4000) "Bound of an integer or rational known only by a type test.")
(defun ratp* (ty) (and (consp ty) (eq (car ty) :rat)))
(defun nump* (ty) (or (intp* ty) (ratp* ty)))
(defun charp* (ty) (and (consp ty) (eq (car ty) :char)))
(defun strp* (ty) (and (consp ty) (eq (car ty) :str)))
(defun rat-den (ty) (if (intp* ty) 1 (fourth ty)))
(defun tr (lo hi d)
  "Rational type with integer bounds and denominator bound D (NIL = unknown)."
  (let ((lo (floor lo)) (hi (ceiling hi)))
    (when (or (> (max (integer-length lo) (integer-length hi)) 220)
              (and d (> (integer-length d) 220)))
      (invalid :too-wide))
    (if (eql d 1) (list :int lo hi) (list :rat lo hi d))))
(defun tc (lo hi) (list :char lo hi))
(defun dfp* (ty) (and (consp ty) (eq (car ty) :df)))
(defun tdf (lo hi)
  "ACL2 double-float (df) whose value lies in [LO,HI].  The bounds are integers of
magnitude at most 2^52, so they are representable and rounding cannot cross them."
  (let ((lo (floor lo)) (hi (ceiling hi)))
    (when (> (max (abs lo) (abs hi)) (ash 1 52)) (invalid :df-range))
    (list :df lo hi)))
(defun ts (nlo nhi clo chi) (list :str nlo nhi clo chi))
(defparameter *str-any* (list :str 0 (ash 1 32) 0 255))

(defun join (a b)
  (cond ((and (intp* a) (intp* b))
         (ti (min (second a) (second b)) (max (third a) (third b))))
        ((and (nump* a) (nump* b))
         (tr (min (second a) (second b)) (max (third a) (third b))
             (and (rat-den a) (rat-den b) (max (rat-den a) (rat-den b)))))
        ((and (charp* a) (charp* b))
         (tc (min (second a) (second b)) (max (third a) (third b))))
        ((and (dfp* a) (dfp* b))
         (tdf (min (second a) (second b)) (max (third a) (third b))))
        ((and (strp* a) (strp* b))
         (ts (min (second a) (second b)) (max (third a) (third b))
             (min (fourth a) (fourth b)) (max (fifth a) (fifth b))))
        ((and (eq a :sym) (eq b :sym)) :sym)
        ((and (member a '(:any :pair)) (member b '(:any :pair))) :any)
        ((and (listp* a) (listp* b))
         (cond ((= (third a) 0) (tl 0 (third b) (fourth b) (fifth b)))
               ((= (third b) 0) (tl 0 (third a) (fourth a) (fifth a)))
               (t (tl (min (second a) (second b)) (max (third a) (third b))
                      (min (fourth a) (fourth b)) (max (fifth a) (fifth b))))))
        ((and (eq a :bool) (eq b :bool)) :bool)
        ((and (eq a :st) (eq b :st)) :st)
        ((and (consp a) (consp b) (eq (car a) :mv) (eq (car b) :mv)
              (= (length a) (length b)))
         (cons :mv (mapcar #'join (cdr a) (cdr b))))
        (t (invalid :join a b))))

(defun sub-p (a b)
  "Is A provably within B?  List length upper bounds are not compared: structural
recursion preserves them but the analysis cannot show it."
  (cond ((and (intp* a) (intp* b)) (and (>= (second a) (second b)) (<= (third a) (third b))))
        ((eq b :any) (not (or (member a '(:bool :st)) (and (consp a) (eq (car a) :mv)))))
        ((and (nump* a) (ratp* b))
         (and (>= (second a) (second b)) (<= (third a) (third b))
              (or (null (rat-den b)) (and (rat-den a) (<= (rat-den a) (rat-den b))))))
        ((and (charp* a) (charp* b)) (and (>= (second a) (second b)) (<= (third a) (third b))))
        ((and (dfp* a) (dfp* b)) (and (>= (second a) (second b)) (<= (third a) (third b))))
        ((and (strp* a) (strp* b))
         (and (>= (second a) (second b)) (<= (third a) (third b))
              (>= (fourth a) (fourth b)) (<= (fifth a) (fifth b))))
        ((and (listp* a) (listp* b))
         (and (>= (second a) (second b))
              (or (= (third a) 0)
                  (and (>= (fourth a) (fourth b)) (<= (fifth a) (fifth b))))))
        ((and (consp a) (consp b) (eq (car a) :mv) (eq (car b) :mv)
              (= (length a) (length b)))
         (every #'sub-p (cdr a) (cdr b)))
        (t (eq a b))))

(defun hull (&rest v) (ti (reduce #'min v) (reduce #'max v)))
(defun bits-hull (&rest b)
  (let ((n (reduce #'max (mapcar #'integer-length b)))) (ti (- (pow2 n)) (1- (pow2 n)))))

;;;; Transfer functions

(defun xfer-int (op tys)
  (dolist (ty tys) (unless (intp* ty) (invalid :int-expected op ty)))
  (let* ((a (first tys)) (b (second tys))
         (al (second a)) (ah (third a))
         (bl (and b (second b))) (bh (and b (third b))))
    (ecase op
      (+ (ti (+ al bl) (+ ah bh)))
      (- (if b (ti (- al bh) (- ah bl)) (ti (- ah) (- al))))
      (* (hull (* al bl) (* al bh) (* ah bl) (* ah bh)))
      (1+ (ti (1+ al) (1+ ah)))
      (1- (ti (1- al) (1- ah)))
      (ash (unless (and (>= bl -300) (<= bh 70)) (invalid :shift))
       (hull (ash al bl) (ash al bh) (ash ah bl) (ash ah bh)))
      (logand (cond ((and (>= al 0) (>= bl 0)) (ti 0 (min ah bh)))
                    ((>= al 0) (ti 0 ah))
                    ((>= bl 0) (ti 0 bh))
                    (t (bits-hull al ah bl bh))))
      ((logior logxor)
       (if (and (>= al 0) (>= bl 0))
           (ti 0 (1- (pow2 (max (integer-length ah) (integer-length bh)))))
           (bits-hull al ah bl bh)))
      ((logeqv logandc1 logandc2 lognand lognor logorc1 logorc2) (bits-hull al ah bl bh))
      (lognot (ti (- -1 ah) (- -1 al)))
      ((floor truncate ceiling round)
       (when (<= bl 0 bh) (invalid :div0))
       (hull (funcall op al bl) (funcall op al bh) (funcall op ah bl) (funcall op ah bh)))
      (mod (when (<= bl 0 bh) (invalid :div0))
       (if (> bl 0) (ti 0 (1- bh)) (ti (1+ bl) 0)))
      (rem (when (<= bl 0 bh) (invalid :div0))
       (let ((m (1- (max (abs bl) (abs bh)))))
         (ti (if (< al 0) (- (min m (abs al))) 0) (if (> ah 0) (min m ah) 0))))
      ((integer-length logcount) (ti 0 (max (integer-length al) (integer-length ah))))
      (abs (cond ((>= al 0) (ti al ah)) ((<= ah 0) (ti (- ah) (- al)))
                 (t (ti 0 (max (- al) ah)))))
      (min (ti (min al bl) (min ah bh)))
      (max (ti (max al bl) (max ah bh)))
      (signum (ti (signum al) (signum ah)))
      (expt (unless (and (>= al -16) (<= ah 16) (>= bl 0) (<= bh 6)) (invalid :expt))
       (apply #'hull (loop for x from al to ah
                           append (loop for k from bl to bh collect (expt x k)))))
      ((< <= > >= = /= eql evenp oddp zip zerop plusp minusp logtest) :bool)
      (zp (unless (>= al 0) (invalid :zp-needs-natural)) :bool)
      (logbitp (unless (and (>= al 0) (<= ah 300)) (invalid :logbitp-index)) :bool)
      ((signed-byte-p unsigned-byte-p)
       (unless (and (= al ah) (>= al 1)) (invalid :byte-size)) :bool))))

(defun xfer-list (op tys)
  (flet ((lst (ty) (unless (listp* ty) (invalid :list-expected op ty)) (cdr ty))
         (int (ty) (unless (intp* ty) (invalid :int-expected op ty)) (cdr ty)))
    (ecase op
      (car (destructuring-bind (nlo nhi elo ehi) (lst (first tys))
             (declare (ignore nhi))
             (unless (>= nlo 1) (invalid :car-of-possibly-empty))
             (ti elo ehi)))
      (cdr (destructuring-bind (nlo nhi elo ehi) (lst (first tys))
             (tl (max 0 (1- nlo)) (max 0 (1- nhi)) elo ehi)))
      (cons (destructuring-bind (el eh) (int (first tys))
              (destructuring-bind (nlo nhi elo ehi) (lst (second tys))
                (if (= nhi 0)
                    (tl 1 1 el eh)
                    (tl (1+ nlo) (1+ nhi) (min el elo) (max eh ehi))))))
      (len (destructuring-bind (nlo nhi elo ehi) (lst (first tys))
             (declare (ignore elo ehi)) (ti nlo nhi)))
      (nth (destructuring-bind (il ih) (int (first tys))
             (destructuring-bind (nlo nhi elo ehi) (lst (second tys))
               (declare (ignore nhi))
               (unless (and (>= il 0) (<= ih (1- nlo))) (invalid :nth-index))
               (ti elo ehi))))
      (nthcdr (destructuring-bind (il ih) (int (first tys))
                (destructuring-bind (nlo nhi elo ehi) (lst (second tys))
                  (unless (and (>= il 0) (<= ih 100)) (invalid :nthcdr-index))
                  (tl (max 0 (- nlo ih)) (max 0 (- nhi il)) elo ehi))))
      (append (let ((a (lst (first tys))) (b (lst (second tys))))
                (let ((j (join (cons :list a) (cons :list b))))
                  (tl (+ (first a) (first b)) (+ (second a) (second b))
                      (fourth j) (fifth j)))))
      (list (let ((es (mapcar #'int tys)))
              (tl (length es) (length es)
                  (reduce #'min (mapcar #'first es)) (reduce #'max (mapcar #'second es)))))
      ((endp consp) (lst (first tys)) :bool)
      (length (xfer-list 'len tys))
      (reverse (cons :list (lst (first tys))))
      (revappend (xfer-list 'append tys))
      (last (destructuring-bind (nlo nhi elo ehi) (lst (first tys))
              (tl (min nlo 1) (min nhi 1) elo ehi)))
      (butlast (destructuring-bind (il ih) (int (second tys))
                 (destructuring-bind (nlo nhi elo ehi) (lst (first tys))
                   (unless (>= il 0) (invalid :butlast-count))
                   (tl (max 0 (- nlo ih)) (max 0 (- nhi il)) elo ehi))))
      (take (destructuring-bind (il ih) (int (first tys))
              (destructuring-bind (nlo nhi elo ehi) (lst (second tys))
                (declare (ignore nhi))
                (unless (and (>= il 0) (<= ih nlo)) (invalid :take-count))
                (tl il ih elo ehi))))
      ((remove) (int (first tys))
       (destructuring-bind (nlo nhi elo ehi) (lst (second tys))
         (declare (ignore nlo)) (tl 0 nhi elo ehi)))
      (remove-duplicates (destructuring-bind (nlo nhi elo ehi) (lst (first tys))
                           (tl (min nlo 1) nhi elo ehi)))
      ((union$ intersection$ set-difference$)
       (let ((a (lst (first tys))) (b (lst (second tys))))
         (ecase op
           (union$ (let ((j (join (cons :list a) (cons :list b))))
                     (tl 0 (+ (second a) (second b)) (fourth j) (fifth j))))
           ((intersection$ set-difference$) (tl 0 (second a) (third a) (fourth a))))))
      (add-to-set (destructuring-bind (el eh) (int (first tys))
                    (destructuring-bind (nlo nhi elo ehi) (lst (second tys))
                      (if (= nhi 0) (tl 1 1 el eh)
                          (tl (max 1 nlo) (1+ nhi) (min el elo) (max eh ehi))))))
      (subsetp (lst (first tys)) (lst (second tys)) :bool)
      (member (int (first tys)) (lst (second tys)) :bool)
      (position (int (first tys)) (lst (second tys)) :bool)
      (count (int (first tys)) (ti 0 (second (lst (second tys)))))
      (cadr (destructuring-bind (nlo nhi elo ehi) (lst (first tys))
              (declare (ignore nhi))
              (unless (>= nlo 2) (invalid :cadr-short)) (ti elo ehi)))
      (cddr (xfer-list 'cdr (list (xfer-list 'cdr tys))))
      (list* (xfer-list 'cons (list (first tys) (xfer-list 'cons (cdr tys))))))))

(defun xfer-rat (op tys)
  (dolist (ty tys) (unless (nump* ty) (invalid :number-expected op ty)))
  (let* ((a (first tys)) (b (second tys))
         (al (second a)) (ah (third a)) (ad (rat-den a))
         (bl (and b (second b))) (bh (and b (third b))) (bd (and b (rat-den b)))
         (dd (and ad bd (* ad bd))))
    (flet ((nz () (when (<= bl 0 bh) (invalid :div0)))
           (corners (f) (list (funcall f al bl) (funcall f al bh) (funcall f ah bl) (funcall f ah bh))))
      (ecase op
        (+ (tr (+ al bl) (+ ah bh) dd))
        (- (if b (tr (- al bh) (- ah bl) dd) (tr (- ah) (- al) ad)))
        (* (let ((c (corners #'*))) (tr (reduce #'min c) (reduce #'max c) dd)))
        (/ (if b
               (progn (nz)
                      (let ((c (corners #'/)))
                        (tr (reduce #'min c) (reduce #'max c)
                            (and dd (* dd (max (abs bl) (abs bh)))))))
               (progn (when (<= al 0 ah) (invalid :div0))
                      (tr (min (/ al) (/ ah)) (max (/ al) (/ ah))
                          (and ad (* ad (max (abs al) (abs ah))))))))
        ((floor truncate ceiling round)
         (nz) (let ((c (corners op))) (ti (reduce #'min c) (reduce #'max c))))
        (mod (nz) (if (> bl 0) (tr 0 bh dd) (tr bl 0 dd)))
        (rem (nz) (let ((m (max (abs bl) (abs bh))))
                    (tr (if (< al 0) (- (min m (abs al))) 0) (if (> ah 0) (min m ah) 0) dd)))
        (abs (cond ((>= al 0) (tr al ah ad)) ((<= ah 0) (tr (- ah) (- al) ad))
                   (t (tr 0 (max (- al) ah) ad))))
        (min (tr (min al bl) (min ah bh) (and ad bd (max ad bd))))
        (max (tr (max al bl) (max ah bh) (and ad bd (max ad bd))))
        (signum (ti (signum al) (signum ah)))
        (numerator (unless ad (invalid :unknown-denominator))
         (ti (min al (* al ad)) (max ah (* ah ad))))
        (denominator (unless ad (invalid :unknown-denominator)) (ti 1 ad))
        ((< <= > >= = /= eql zerop plusp minusp) :bool)))))

(defun xfer-char (op tys)
  (flet ((ch (ty) (unless (charp* ty) (invalid :char-expected op ty)) ty))
    (ecase op
      (char-code (let ((c (ch (first tys)))) (ti (second c) (third c))))
      (code-char (let ((i (first tys)))
                   (unless (and (intp* i) (>= (second i) 0) (<= (third i) 255))
                     (invalid :code-char-range))
                   (tc (second i) (third i))))
      ((char-upcase char-downcase) (ch (first tys)) (tc 0 255))
      ((upper-case-p lower-case-p alpha-char-p standard-char-p digit-char-p)
       (ch (first tys)) :bool)
      ((char< char> char<= char>= char-equal) (ch (first tys)) (ch (second tys)) :bool))))

(defun xfer-str (op tys)
  (flet ((st (ty) (unless (strp* ty) (invalid :string-expected op ty)) ty))
    (ecase op
      (string-append (let ((a (st (first tys))) (b (st (second tys))))
                       (ts (+ (second a) (second b)) (+ (third a) (third b))
                           (min (fourth a) (fourth b)) (max (fifth a) (fifth b)))))
      ((string-upcase string-downcase)
       (let ((a (st (first tys)))) (ts (second a) (third a) 0 255)))
      ((string-equal string< string> string<= string>= search)
       (st (first tys)) (st (second tys)) :bool)
      (char (let ((s (st (first tys))) (i (second tys)))
              (unless (and (intp* i) (>= (second i) 0) (<= (third i) (1- (second s))))
                (invalid :char-index))
              (tc (fourth s) (fifth s))))
      (string (let ((c (first tys)))
                (cond ((charp* c) (ts 1 1 (second c) (third c)))
                      ((eq c :sym) *str-any*)
                      (t (st c)))))
      ((symbol-name symbol-package-name)
       (unless (eq (first tys) :sym) (invalid :symbol-expected)) *str-any*)
      (intern-in-package-of-symbol
       (st (first tys)) (unless (eq (second tys) :sym) (invalid :symbol-expected)) :sym))))

(defparameter *any-preds* '(integerp rationalp acl2-numberp complex-rationalp characterp stringp
                            symbolp consp atom natp posp keywordp true-listp null))

(defparameter *list-ops* '(car cdr cons len length nth nthcdr append list endp consp
                           reverse revappend last butlast take remove remove-duplicates
                           union$ intersection$ set-difference$ subsetp add-to-set member
                           count cadr cddr list* position))

(defun value-type-p (ty)
  "An ordinary object: may be passed to EQUAL and type predicates (a df may not)."
  (not (or (member ty '(:bool :st)) (and (consp ty) (member (car ty) '(:mv :df))))))

(defun xfer-df (op tys)
  (flet ((df (ty) (unless (dfp* ty) (invalid :df-expected op ty)) ty))
    (let* ((a (first tys)) (b (second tys)))
      (ecase op
        (to-df (unless (nump* a) (invalid :to-df-arg)) (tdf (second a) (third a)))
        ((from-df) (df a) (list :rat (second a) (third a) nil))
        ((df+ df- df* df/)
         (df a)
         (if (null b)
             (progn (unless (eq op 'df-) (invalid :df-arity)) (tdf (- (third a)) (- (second a))))
             (let ((al (second a)) (ah (third a)) (bl (second (df b))) (bh (third b)))
               (when (and (eq op 'df/) (<= bl 0 bh)) (invalid :div0))
               (let* ((f (ecase op (df+ #'+) (df- #'-) (df* #'*) (df/ #'/)))
                      (c (list (funcall f al bl) (funcall f al bh) (funcall f ah bl) (funcall f ah bh))))
                 (tdf (reduce #'min c) (reduce #'max c))))))
        (df-abs (df a) (tdf (if (<= (second a) 0 (third a)) 0 (min (abs (second a)) (abs (third a))))
                            (max (abs (second a)) (abs (third a)))))
        (df-sqrt (unless (>= (second (df a)) 0) (invalid :sqrt-negative))
         (tdf (isqrt (second a)) (1+ (isqrt (third a)))))
        ((df< df<= df=) (df a) (df b) :bool)))))

(defun xfer (op tys)
  (cond ((member op *any-preds*)
         (unless (and tys (null (cdr tys)) (value-type-p (first tys))) (invalid :predicate-arg))
         :bool)
        ((eq op 'equal)
         (unless (and (= (length tys) 2) (every #'value-type-p tys)) (invalid :equal-args)) :bool)
        ((eq op 'eq)
         (unless (and (= (length tys) 2) (every #'value-type-p tys) (member :sym tys))
           (invalid :eq-needs-symbol))
         :bool)
        ((and (eq op 'eql) (some #'charp* tys))
         (unless (and (= (length tys) 2) (every #'value-type-p tys)) (invalid :eql-args)) :bool)
        ((and (member op '(car cdr)) (eq (first tys) :pair)) :any)
        ((and (eq op 'len) (member (first tys) '(:any :pair)))
         (ti 0 (ash 1 32)))
        ((and (member op '(length reverse)) (strp* (first tys)))
         (if (eq op 'length) (ti (second (first tys)) (third (first tys))) (first tys)))
        ((member op '(char-code code-char char-upcase char-downcase upper-case-p lower-case-p
                      alpha-char-p standard-char-p digit-char-p char< char> char<= char>=
                      char-equal))
         (xfer-char op tys))
        ((member op '(string-append string-upcase string-downcase string-equal string< string>
                      string<= string>= search char string symbol-name symbol-package-name
                      intern-in-package-of-symbol))
         (xfer-str op tys))
        ((member op *list-ops*) (xfer-list op tys))
        ((and (member op '(nfix)) (eq (first tys) :bool)) (ti 0 (ash 1 32)))
        ((member op '(to-df from-df df+ df- df* df/ df-abs df-sqrt df< df<= df=)) (xfer-df op tys))
        ((some #'ratp* tys) (xfer-rat op tys))
        ((member op '(/ numerator denominator)) (xfer-rat op tys))
        ((eq op 'not) (unless (eq (first tys) :bool) (invalid :bool-expected)) :bool)
        (t (xfer-int op tys))))

(defvar *tainted* nil "Functions that use LOOP$ or LAMBDA$, directly or through a callee.")
(defvar *keep-f1-shape* nil "Emit the F1/F2 shape unprotected (to re-confirm the findings).")
(defparameter *styles* '(nil :late-guards :program :encap :progn :make-event :with-output
                         :redundant :notinline :nested-encap :local-in-encap))
(defun mentions (v tree)
  (cond ((eq tree v) t)
        ((consp tree) (or (mentions v (car tree)) (mentions v (cdr tree))))))
(defvar *aggregate-queries* nil "Emit one query record per function (bounded-exhaustive mode).")
(defvar *keep-f5-shape* nil "Emit df functions ending in a multiple-value primitive unprotected (finding F5).")
(defvar *stobj-inline* nil "Emit the stobj with :INLINE T (accessors are macros, inlined into callers).")
(defvar *keep-f6-shape* nil "Allow a loop$ variable to shadow a df variable (finding F6).")
