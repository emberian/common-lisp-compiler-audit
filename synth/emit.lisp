;;;; Emission: a program and its context envelope -> ACL2 files.

(defun rename (tree suffix)
  (cond ((consp tree) (cons (rename (car tree) suffix) (rename (cdr tree) suffix)))
        ((zf-name-p tree) (intern (format nil "~A-~A" (symbol-name tree) suffix) :zs))
        (t tree)))

(defun tainted-p (tree)
  (cond ((consp tree) (or (tainted-p (car tree)) (tainted-p (cdr tree))))
        (t (or (member tree '(loop$ lambda$)) (member tree *tainted*)))))


(defun free-in (v form)
  "Does variable V occur free in FORM?  (Binders: LET LET* MV-LET LAMBDA$ LOOP$ FLET.)"
  (flet ((body-of (xs) (remove-if (lambda (x) (and (consp x) (eq (car x) 'declare))) xs)))
    (cond ((eq form v) t)
          ((atom form) nil)
          ((eq (car form) 'quote) nil)
          ((eq (car form) 'let)
           (or (some (lambda (b) (free-in v (second b))) (second form))
               (and (not (member v (second form) :key #'first))
                    (some (lambda (x) (free-in v x)) (body-of (cddr form))))))
          ((eq (car form) 'let*)
           (if (null (second form))
               (some (lambda (x) (free-in v x)) (body-of (cddr form)))
               (let ((b (first (second form))))
                 (or (free-in v (second b))
                     (and (not (eq v (first b)))
                          (free-in v `(let* ,(rest (second form)) ,@(cddr form))))))))
          ((eq (car form) 'mv-let)
           (or (free-in v (third form))
               (and (not (member v (second form)))
                    (some (lambda (x) (free-in v x)) (body-of (cdddr form))))))
          ((eq (car form) 'lambda$)
           (and (not (member v (second form)))
                (some (lambda (x) (free-in v x)) (body-of (cddr form)))))
          ((eq (car form) 'flet)
           (some (lambda (x) (free-in v x)) (cddr form)))
          ((eq (car form) 'loop$)
           ;; (loop$ for VAR [of-type T] in|from ... ): the target expressions see the outer V
           (let* ((var (third form)) (rest (cdddr form))
                  (rest (if (eq (car rest) 'of-type) (cddr rest) rest))
                  (ntarget (if (eq (car rest) 'in) 2 4)))
             (or (some (lambda (x) (free-in v x)) (subseq rest 0 ntarget))
                 (and (not (eq v var))
                      (some (lambda (x) (free-in v x)) (nthcdr ntarget rest))))))
          (t (some (lambda (x) (free-in v x)) (cdr form))))))

(defun add-ignorable (vars decls)
  "DECLS (a list of DECLARE forms, possibly empty) extended with IGNORABLE for VARS."
  (cond ((null vars) decls)
        (decls (cons (append (first decls) `((ignorable ,@vars))) (rest decls)))
        (t (list `(declare (ignorable ,@vars))))))

(defun split-decls (body)
  (let ((decls (loop for x in body while (and (consp x) (eq (car x) 'declare)) collect x)))
    (values decls (nthcdr (length decls) body))))

(defun fix-ignores (form mode &optional inside)
  "Declare unused bindings IGNORABLE where SET-IGNORE-OK cannot be relied on:
everywhere when MODE is :DECL, and always inside LOOP$ and LAMBDA$ bodies, where an
undeclared unused binding is the exact shape of findings F1 and F2 (excluded by
that key, see *KEEP-F1-SHAPE*)."
  (flet ((need () (or (eq mode :decl) (and inside (not *keep-f1-shape*)))))
    (cond ((atom form) form)
          ((eq (car form) 'quote) form)
          ((member (car form) '(let let*))
           (destructuring-bind (bindings . body) (cdr form)
             (multiple-value-bind (decls rest) (split-decls body)
               (let* ((rest (mapcar (lambda (x) (fix-ignores x mode inside)) rest))
                      (bs (mapcar (lambda (b) (list (first b) (fix-ignores (second b) mode inside)))
                                  bindings))
                      (unused (and (need)
                                   (remove-duplicates
                                    (loop for (b . more) on bindings
                                          unless (or (eq (first b) 'zst) (mentions (first b) decls)
                                                     (and (eq (car form) 'let*)   ; ACL2 forbids the declaration
                                                          (> (count (first b) bindings :key #'first) 1))
                                                     (if (eq (car form) 'let*)
                                                         (free-in (first b) `(let* ,more ,@rest))
                                                         (some (lambda (x) (free-in (first b) x)) rest)))
                                            collect (first b))))))
                 `(,(car form) ,bs ,@(add-ignorable unused decls) ,@rest)))))
          ((eq (car form) 'mv-let)
           (destructuring-bind (vars e . body) (cdr form)
             (multiple-value-bind (decls rest) (split-decls body)
               (let* ((rest (mapcar (lambda (x) (fix-ignores x mode inside)) rest))
                      (unused (and (need)
                                   (remove-if (lambda (v)
                                                (or (mentions v decls)
                                                    (some (lambda (x) (free-in v x)) rest)))
                                              vars))))
                 `(mv-let ,vars ,(fix-ignores e mode inside) ,@(add-ignorable unused decls) ,@rest)))))
          ((eq (car form) 'lambda$)
           (destructuring-bind (vars . body) (cdr form)
             (multiple-value-bind (decls rest) (split-decls body)
               (let* ((rest (mapcar (lambda (x) (fix-ignores x mode t)) rest))
                      )
                 ;; lambda$ declares its own formals IGNORABLE and rejects the declaration
                 `(lambda$ ,vars ,@decls ,@rest)))))
          ((eq (car form) 'loop$)
           (cons 'loop$ (mapcar (lambda (x) (fix-ignores x mode t)) (cdr form))))
          ((eq (car form) 'flet)
           (destructuring-bind (((fname vars . fbody)) call) (cdr form)
             (multiple-value-bind (decls rest) (split-decls fbody)
               (let* ((rest (mapcar (lambda (x) (fix-ignores x mode inside)) rest))
                      (unused (and (eq mode :decl)
                                   (remove-if (lambda (v)
                                                (or (mentions v decls)
                                                    (some (lambda (x) (free-in v x)) rest)))
                                              vars))))
                 `(flet ((,fname ,vars ,@(add-ignorable unused decls) ,@rest))
                    ,(fix-ignores call mode inside))))))
          (t (cons (car form) (mapcar (lambda (x) (fix-ignores x mode inside)) (cdr form)))))))

(defun mv-as-list (form names root)
  "Metamorphic rewrite: the functions NAMES return (LIST a b) instead of (MV a b).
ROOT: FORM is the body of one of them.  Callers bind the list and take it apart."
  (labels ((walk (x)
             (cond ((atom x) x)
                   ((eq (car x) 'quote) x)
                   ((and (eq (car x) 'mv-let) (consp (third x)) (member (car (third x)) names))
                    (destructuring-bind (vars call . body) (cdr x)
                      `(let ((zr ,(walk call)))
                         (let ((,(first vars) (car zr)) (,(second vars) (car (cdr zr))))
                           ,@(mapcar #'walk body)))))
                   (t (cons (car x) (mapcar #'walk (cdr x)))))))
    (let ((b (walk form)))
      (if (and root (consp b) (eq (car b) 'mv)) (cons 'list (cdr b)) b))))

(defun annotated-body (f)
  (let ((*rs* (sb-ext:seed-random-state (fn-ann-seed f))) (*ann* (fn-density f)))
    (nth-value 1 (infer (fn-ir f) (mapcar #'cons (fn-params f) (fn-ptypes f))))))

(defun opt-name (f)
  "The function symbol whose symbol-class shows whether the OPT twin is guard-verified."
  (let ((n (rename (fn-name f) "OPT")))
    (cond ((fn-inline f) (intern (format nil "~A$INLINE" (symbol-name n)) :zs))
          ((eq (fn-style f) :notinline) (intern (format nil "~A$NOTINLINE" (symbol-name n)) :zs))
          (t n))))

(defun param-decls (f)
  "TYPE declarations and guard conjuncts stating the parameter types of F."
  (let (decls conj)
    (loop for p in (fn-params f) for ty in (fn-ptypes f)
          do (cond ((intp* ty)
                    (if (eq (fn-gmode f) :guard)
                        (setf conj (append conj `((integerp ,p) (<= ,(second ty) ,p) (<= ,p ,(third ty)))))
                        (push `(type ,(spec-for ty) ,p) decls)))
                   ((ratp* ty)
                    (push `(type rational ,p) decls)
                    (setf conj (append conj `((<= ,(second ty) ,p) (<= ,p ,(third ty))
                                              ,@(when (fourth ty) `((<= (denominator ,p) ,(fourth ty))))))))
                   ((charp* ty)
                    (push `(type character ,p) decls)
                    (unless (and (= (second ty) 0) (= (third ty) 255))
                      (setf conj (append conj `((<= ,(second ty) (char-code ,p))
                                                (<= (char-code ,p) ,(third ty)))))))
                   ((strp* ty)
                    (push `(type string ,p) decls)
                    (setf conj (append conj `((<= ,(second ty) (length ,p)) (<= (length ,p) ,(third ty))))))
                   ((eq ty :sym) (push `(type symbol ,p) decls))
                   ((dfp* ty)
                    (push `(type double-float ,p) decls)
                    (setf conj (append conj `((<= ,(second ty) (from-df ,p))
                                              (<= (from-df ,p) ,(third ty))))))
                   ((listp* ty) (setf conj (append conj `((integer-listp ,p)))))))
    (values (nreverse decls) conj)))

(defun defun-form (f suffix p &key extra-xargs name)
  "F's definition as the twin SUFFIX (REF, OPT or a style-copy suffix)."
  (let* ((refp (string= suffix "REF"))
         (ctx (prog-ctx p))
         (imode (getf ctx :ignore))
         (self (or name (rename (fn-name f) suffix)))
         (body (fix-ignores (rename (or (fn-body f) (setf (fn-body f) (annotated-body f))) (if refp "REF" "OPT"))
                            imode))
         (body (if name (subst name (rename (fn-name f) "OPT") body) body))
         ;; Known-failure exclusion (finding F5): on SBCL a function with a df formal is
         ;; proclaimed to return exactly one value, and a body ending in a raw
         ;; multiple-value primitive then signals a raw Lisp error.
         (body (if (and (some #'dfp* (fn-ptypes f)) (not *keep-f5-shape*) (value-type-p (fn-rtype f))
                        (some (lambda (op) (mentions op body)) '(floor truncate ceiling round)))
                   `(let ((zv ,body)) zv)
                   body))
         (aslist (getf ctx :mv-as-list))
         (body (if aslist
                   (mv-as-list body (append (rename aslist "REF") (rename aslist "OPT"))
                               (member (fn-name f) aslist))
                   body)))
    (multiple-value-bind (decls conj) (param-decls f)
      (let ((xargs `(,@(when conj `(:guard ,(if (cdr conj) `(and ,@conj) (car conj))))
                     ,@(when (member :st (fn-ptypes f)) '(:stobjs zst))
                     ,@(when (fn-measure f) `(:measure ,(fn-measure f)))
                     ,@(cond (refp '(:verify-guards nil))
                             ((getf extra-xargs :verify-guards-given) nil)
                             ((getf extra-xargs :mode) nil)
                             (t '(:verify-guards t)))
                     ,@(loop for (k v) on extra-xargs by #'cddr
                             unless (eq k :verify-guards-given) append (list k v)))))
        `(,(cond ((fn-inline f) 'defun-inline)
                 ((and (not refp) (eq (fn-style f) :notinline) (not name)) 'defun-notinline)
                 (t 'defun))
          ,self ,(fn-params f)
          (declare ,@decls
                   ,@(when (eq imode :decl) `((ignorable ,@(fn-params f))))
                   ,@(when xargs `((xargs ,@xargs))))
          ,body)))))


(defun styled-events (f p style &key name)
  "Events admitting F's raw twin (named NAME, default the OPT twin) in STYLE."
  (let* ((opt (or name (rename (fn-name f) "OPT")))
         (plain `(skip-proofs ,(defun-form f "OPT" p :name name)))
         (loc (intern (format nil "ZLOC-~A" (symbol-name opt)) :zs)))
    (ecase style
      ((nil :notinline) (list plain))
      (:late-guards (list `(skip-proofs ,(defun-form f "OPT" p :name name
                                                     :extra-xargs '(:verify-guards nil
                                                                    :verify-guards-given t)))
                          `(skip-proofs (verify-guards ,opt))))
      (:program (list `(skip-proofs ,(defun-form f "OPT" p :name name :extra-xargs '(:mode :program)))
                      `(skip-proofs (verify-termination ,opt))
                      `(skip-proofs (verify-guards ,opt))))
      (:encap (list `(encapsulate () (local (defun ,loc (x) x)) ,plain)))
      (:progn (list `(progn (defun ,loc (x) x) ,plain)))
      (:make-event (list `(make-event (quote ,plain))))
      (:with-output (list `(with-output :off (summary event) ,plain)))
      (:redundant (list plain plain))
      (:nested-encap (list `(encapsulate () (encapsulate () (local (defun ,loc (x) x)) ,plain))))
      (:local-in-encap (list `(encapsulate ()
                                (local (defun ,loc (x) (declare (xargs :guard t)) (cons x x)))
                                (local (defthm ,(intern (format nil "~A-THM" (symbol-name loc)) :zs)
                                         (consp (,loc x))))
                                ,plain))))))

(defun copy-names (f p)
  "Names of F's extra per-style copies (empty unless F was selected for all styles)."
  (and (member (fn-name f) (getf (prog-ctx p) :all-styles))
       (loop for s in (cdr *styles*) for k from 1
             collect (intern (format nil "~A-OS~D" (symbol-name (fn-name f)) k) :zs))))

(defun twin-events (f p)
  "Top-level events admitting F's REF twin, OPT twin and style copies."
  (let ((style (if (fn-inline f) nil (fn-style f))))
    (append (list `(skip-proofs ,(defun-form f "REF" p)))
            (if (eq style :program)
                (append '((program)) (list (first (styled-events f p :program))) '((logic))
                        (rest (styled-events f p :program)))
                (styled-events f p style))
            (loop for name in (copy-names f p) for s in (cdr *styles*)
                  append (let ((g (copy-fn f))) (setf (fn-inline g) nil (fn-style g) s)
                           (styled-events g p s :name name))))))

(defun query-form (f i c q p)
  (destructuring-bind (seed . args) q
    (let* ((ref `(,(rename (fn-name f) "REF") ,@args))
           (opt `(,(rename (fn-name f) "OPT") ,@args))
           (rty (fn-rtype f))
           (copies (loop for n in (copy-names f p)
                         collect `(equal o ,(if (and (consp rty) (eq (car rty) :mv))
                                                `(mv-let (a b) (,n ,@args) (list a b))
                                                `(,n ,@args)))))
           (same (if copies `(and (equal r o) ,@copies) '(equal r o)))
           (report `(cw ,(format nil "@Q ~D ~D ~~x0 ~~x1~~%" i c) (zhash r) (if ,same :ok :diff))))
      (cond ((eq rty :st)
             `(let* ((zst (zreset ,seed zst)) (zst ,ref) (r (zdig zst))
                     (zst (zreset ,seed zst)) (zst ,opt) (o (zdig zst)))
                (prog2$ ,report zst)))
            ((member :st (fn-ptypes f))
             `(let* ((zst (zreset ,seed zst)) (r ,ref) (o ,opt)) (prog2$ ,report zst)))
            ((and (consp rty) (eq (car rty) :mv) (member (fn-name f) (getf (prog-ctx p) :mv-as-list)))
             `(let* ((r ,ref) (o ,opt)) ,report))
            ((and (consp rty) (eq (car rty) :mv))
             `(let* ((r (mv-let (a b) ,ref (list a b))) (o (mv-let (a b) ,opt (list a b)))) ,report))
            (t `(let* ((r ,ref) (o ,opt)) ,report))))))

(defparameter *zhash*
  '(skip-proofs
    (defun zhash (x)
      (declare (xargs :guard t :verify-guards nil))
      (cond ((consp x) (mod (+ (* 31 (zhash (car x))) (zhash (cdr x)) 7) 4294967291))
            ((integerp x) (mod x 4294967291))
            ((rationalp x) (mod (+ (* 131 (numerator x)) (denominator x)) 4294967291))
            ((characterp x) (+ 1000003 (char-code x)))
            ((stringp x) (mod (+ 17 (zhash (coerce x 'list))) 4294967291))
            ((eq x nil) 0)
            ((eq x t) 1)
            ((symbolp x) (mod (+ 29 (zhash (symbol-name x)) (* 3 (zhash (symbol-package-name x))))
                              4294967291))
            (t 5)))))

(defparameter *macros*
  '((defmacro zm-id (x) x)
    (defmacro zm-inc (x) (list (quote +) 1 x))
    (defmacro zm-sel (c a b) (list (quote if) c a b))))

(defun write-forms (path forms &optional header)
  (with-open-file (s path :direction :output :if-exists :supersede)
    (with-zs-io
      (when header (format s "~A~%" header))
      (dolist (f forms) (format s "~S~%" f)))))

(defun function-events (p fns)
  (let ((done nil) (out nil))
    (dolist (f fns (nreverse out))
      (unless (member f done)
        (if (fn-clique f)
            (let ((ms (mates f p)))
              (dolist (suffix '("REF" "OPT"))
                (push `(skip-proofs (mutual-recursion
                                     ,@(mapcar (lambda (g) (defun-form g suffix p)) ms)))
                      out))
              (setf done (append ms done)))
            (progn
              (dolist (ev (twin-events f p)) (push ev out))
              (let ((k (find (fn-name f) (prog-computed p) :key #'first)))
                (when k (push `(defconst ,(second k) (,(rename (fn-name f) "OPT") ,@(third k))) out)))))))))

(defun book-forms (p)
  "(values main-book-forms sub-book-forms-or-NIL portcullis-forms-or-NIL)."
  (install-prog p)
  (dolist (f (prog-fns p)) (setf (fn-body f) nil))
  (let* ((ctx (prog-ctx p))
         (*stobj-inline* (getf ctx :stobj-inline))
         (fns (prog-fns p))
         (ignore-events (append (when (eq (getf ctx :ignore) :ok) '((set-ignore-ok t)))
                                (list `(set-irrelevant-formals-ok ,(getf ctx :irrelevant t)))))
         (setters (getf ctx :setters))
         (at (lambda (pos) (loop for (form where) in setters when (eq where pos) collect form)))
         (prelude (append *macros*
                          (loop for (name . ty) in (prog-consts p) collect `(defconst ,name ,(second ty)))
                          ;; the helpers draw random clamping forms; they must be the same
                          ;; for every emission of a program and of its metamorphic variants
                          (and (prog-fields p)
                               (let ((*rs* (sb-ext:seed-random-state 20261113))) (stobj-helpers)))
                          (list *zhash*)))
         (fevents (function-events p fns))
         (cut (and (eq (getf ctx :sub) :plain) (floor (length fevents) 2)))
         (mid (floor (length fevents) 2))
         (control '((skip-proofs (defun zctl-ref (x)
                                   (declare (type (signed-byte 62) x) (xargs :verify-guards nil))
                                   (+ x 1)))
                    (skip-proofs (defun zctl-opt (x)
                                   (declare (type (signed-byte 62) x) (xargs :verify-guards t))
                                   (+ x 2)))))
         (port (and (getf ctx :port)
                    '((defmacro zm-port (x) (list (quote -) x 0))
                      (set-bogus-mutual-recursion-ok t))))
         (local-sub '((set-ruler-extenders :all)
                      (set-ignore-ok :warn)
                      (defmacro zl-id (x) (list (quote car) (list (quote cons) x nil)))
                      (defun zl-fn (x) (declare (xargs :guard t)) (zl-id x))
                      (defconst *zl-c* (zl-fn 3)))))
    (flet ((with-mid (evs)
             (if (and (funcall at :mid) (> (length evs) 1))
                 (append (subseq evs 0 (min mid (length evs))) (funcall at :mid)
                         (subseq evs (min mid (length evs))))
                 (append (funcall at :mid) evs))))
      (values
       (append (case (getf ctx :sub)
                 (:plain '((include-book "sub")))
                 (:local '((local (include-book "sub")))))
               (funcall at :before) ignore-events
               (unless cut prelude)
               (with-mid (if cut (subseq fevents cut) fevents))
               control (funcall at :after))
       (case (getf ctx :sub)
         (:plain (append ignore-events prelude (subseq fevents 0 cut)))
         (:local local-sub))
       port))))

(defun emit-prog (p dir)
  (multiple-value-bind (main sub port) (book-forms p)
    (let ((fns (prog-fns p)))
      (write-forms (format nil "~Abook.lisp" dir) main "(in-package \"ACL2\")")
      (dolist (stale '("sub.lisp" "portcullis.lisp"))
        (when (probe-file (format nil "~A~A" dir stale)) (delete-file (format nil "~A~A" dir stale))))
      (when sub (write-forms (format nil "~Asub.lisp" dir) sub "(in-package \"ACL2\")"))
      (when port (write-forms (format nil "~Aportcullis.lisp" dir) port))
      (write-forms
       (format nil "~Aqueries.lisp" dir)
       (append
        ;; Number of OPT twins (and style copies) that are not guard-verified: must be 0.
        (list `(cw "@G ~x0~%"
                   (+ ,@(loop for f in fns
                              append (loop for n in (cons (opt-name f) (copy-names f p))
                                           collect `(if (eq (getpropc ',n 'symbol-class nil (w state))
                                                            :common-lisp-compliant)
                                                        0 1))))))
        (list `(cw "@U ~x0~%"
                   (append ,@(loop for f in fns
                                   append (loop for n in (cons (opt-name f) (copy-names f p))
                                                collect `(if (eq (getpropc ',n 'symbol-class nil (w state))
                                                                 :common-lisp-compliant)
                                                             nil '(,n)))))))
        (loop for f in fns for i from 0
              append (if *aggregate-queries*
                         ;; one record per function: all its inputs folded into one residue
                         (list `(let* ((r (list ,@(loop for q in (fn-queries f)
                                                        collect `(,(rename (fn-name f) "REF") ,@(cdr q)))))
                                       (o (list ,@(loop for q in (fn-queries f)
                                                        collect `(,(rename (fn-name f) "OPT") ,@(cdr q))))))
                                  (cw ,(format nil "@Q ~D 0 ~~x0 ~~x1~~%" i) (zhash r)
                                      (if (equal r o) :ok :diff))))
                         (loop for q in (fn-queries f) for c from 0 collect (query-form f i c q p))))
        '((let* ((r (zctl-ref 5)) (o (zctl-opt 5))) (cw "@C ~x0~%" (if (equal r o) :ok :diff)))
          (cw "@END~%")))
       "(set-guard-checking :all)")
      (let ((memo (remove-if (lambda (f) (or (fn-inline f) (eq (fn-style f) :notinline)
                                             (member :st (fn-ptypes f))))
                             fns)))
        (write-forms (format nil "~Amemo.lisp" dir)
                     (loop for f in memo collect `(memoize ',(rename (fn-name f) "OPT"))))
        (write-forms (format nil "~Aunmemo.lisp" dir)
                     (loop for f in memo collect `(unmemoize ',(rename (fn-name f) "OPT")))))
      (save-prog p (format nil "~Aprog.sexp" dir))
      (with-open-file (s (format nil "~Amanifest.txt" dir) :direction :output :if-exists :supersede)
        (with-zs-io
          (format s "seed ~D functions ~D queries ~D stobj-fields ~D kinds-enabled ~{~A~^ ~}~%"
                  (prog-seed p) (length fns) (reduce #'+ (mapcar (lambda (f) (length (fn-queries f))) fns))
                  (length (prog-fields p)) (prog-kinds p))
          (format s "features ~S~%context ~S~%" (prog-features p) (prog-ctx p))
          (let ((counts nil) (styles nil))
            (dolist (f fns) (incf (getf counts (fn-kind f) 0)) (incf (getf styles (fn-style f) 0)))
            (format s "kinds ~{~A ~D~^, ~}~%styles ~{~A ~D~^, ~}~%" counts styles)))))))
