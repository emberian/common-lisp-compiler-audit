;;;; Program-level tables

(defvar *fns* nil "name -> (param-types return-type)")
(defvar *fields* nil "stobj fields: (accessor updater type length-or-nil)")
(defun fn-sig (name) (gethash name *fns*))
(defvar *consts* nil "Book constants: (name . type)")

(defun unused-binding-p (form)
  "Does FORM bind a variable (LET, LET*, MV-LET) that its body never mentions?"
  (labels ((mentions (v tree)
             (cond ((eq tree v) t)
                   ((consp tree) (or (mentions v (car tree)) (mentions v (cdr tree))))))
           (walk (x)
             (and (consp x)
                  (or (case (car x)
                        ((let let*) (and (listp (second x))
                                         (some (lambda (b) (not (mentions (first b) (cddr x))))
                                               (second x))))
                        (mv-let (some (lambda (v) (not (mentions v (cdddr x)))) (second x))))
                      (some #'walk (if (listp (cdr x)) (cdr x) nil))))))
    (walk form)))

;;;; Branch refinement

(defun refine (test env pol)
  "ENV narrowed by knowing TEST is true (POL) or false."
  (flet ((upd (v ty) (acons v ty env)))
    (if (not (consp test))
        env
        (let* ((op (car test)) (v (second test)) (b (and (symbolp v) (assoc v env)))
               (ty (cdr b)))
          (cond ((eq op 'not) (refine (second test) env (not pol)))
                ((and (member op '(< <= > >= =)) (consp v) (eq (car v) 'length)
                      (symbolp (second v)) (strp* (cdr (assoc (second v) env)))
                      (integerp (third test)))
                 ;; narrow a string variable's length bounds
                 (let* ((sv (second v)) (sty (cdr (assoc sv env)))
                        (r (refine (list op 'zlen (third test))
                                   (list (cons 'zlen (list :int (second sty) (third sty)))) pol))
                        (n (cdr (assoc 'zlen r))))
                   (acons sv (ts (max 0 (second n)) (third n) (fourth sty) (fifth sty)) env)))
                ((and (eq op 'and) pol) (refine (third test) (refine (second test) env t) t))
                ((and (eq op 'or) (not pol))
                 (refine (third test) (refine (second test) env nil) nil))
                ((null b) env)
                ((and (eq ty :any) pol (member op *any-preds*))
                 (case op
                   (integerp (upd v (list :int (- *inf*) *inf*)))
                   (natp (upd v (list :int 0 *inf*)))
                   (posp (upd v (list :int 1 *inf*)))
                   (rationalp (upd v (list :rat (- *inf*) *inf* nil)))
                   (characterp (upd v (tc 0 255)))
                   (stringp (upd v *str-any*))
                   ((symbolp keywordp null) (upd v :sym))
                   (consp (upd v :pair))
                   (t env)))
                ((and (eq ty :any) (not pol) (eq op 'atom)) (upd v :pair))
                ((and (eq op 'zp) (intp* ty))
                 (if pol (upd v (ti 0 0))
                     (if (>= (third ty) 1) (upd v (ti (max 1 (second ty)) (third ty))) env)))
                ((and (member op '(endp consp)) (listp* ty))
                 (if (eq pol (eq op 'endp))
                     (upd v (tl 0 0 0 0))
                     (upd v (tl (max 1 (second ty)) (max 1 (third ty)) (fourth ty) (fifth ty)))))
                ((and (member op '(< <= > >= =)) (nump* ty) (integerp (third test)))
                 (let* ((c (third test)) (lo (second ty)) (hi (third ty))
                        (eff (if pol op (ecase op (< '>=) (<= '>) (> '<=) (>= '<) (= nil)))))
                   (multiple-value-bind (nlo nhi)
                       (case eff
                         (< (values lo (min hi (1- c)))) (<= (values lo (min hi c)))
                         (> (values (max lo (1+ c)) hi)) (>= (values (max lo c) hi))
                         (= (values (max lo c) (min hi c)))
                         (t (values lo hi)))
                     (if (<= nlo nhi)
                         (upd v (if (intp* ty) (list :int nlo nhi) (list :rat nlo nhi (fourth ty))))
                         env))))
                (t env))))))

;;;; Annotation

(defvar *ann* nil "THE density in percent while annotating, or NIL")

(defparameter *edge-widths* '(8 16 32 61 62 63 64))
(defvar *edge-bias* 35 "Percent of integer annotations rounded up to a machine-edge width.")

(defun type-for (lo hi)
  (let* ((sn (max (integer-length lo) (integer-length hi)))
         (slack (if (chance 30) (rnd 3) 0))
         (edge (and (chance *edge-bias*)
                    (find-if (lambda (w) (>= w (+ sn (if (< lo 0) 1 0)))) *edge-widths*))))
    (when (> sn 300) (return-from type-for 'integer))
    (when edge
      (return-from type-for
        (cond ((and (>= lo 0) (chance 50)) `(unsigned-byte ,edge))
              ((> edge sn) `(signed-byte ,edge))
              (t `(unsigned-byte ,edge)))))
    (case (rnd 4)
      (0 `(signed-byte ,(+ sn 1 slack)))
      (1 (if (>= lo 0) `(unsigned-byte ,(max 1 (+ (integer-length hi) slack)))
             `(integer ,lo ,hi)))
      (t `(integer ,lo ,hi)))))

(defun spec-of (ty)
  "A CL type specifier that TY's values satisfy, or NIL."
  (cond ((intp* ty) (type-for (second ty) (third ty)))
        ((ratp* ty) (if (or (> (integer-length (second ty)) 300) (> (integer-length (third ty)) 300)
                            (chance 40))
                        'rational
                        `(rational ,(second ty) ,(third ty))))
        ((charp* ty) 'character)
        ((dfp* ty) 'double-float)
        ((strp* ty) 'string)
        ((eq ty :sym) 'symbol)
        (t nil)))

(defun ann-the (ty form)
  (if (and *ann* (consp form) (not (member (car form) '(the quote))) (chance *ann*)
           (or (intp* ty) (chance 50)))
      (let ((spec (spec-of ty))) (if spec `(the ,spec ,form) form))
      form))

;;;; Inference (and annotation)

(declaim (ftype function infer))

(defun infer-args (forms env)
  (let (tys fs)
    (dolist (f forms)
      (multiple-value-bind (ty ff) (infer f env) (push ty tys) (push ff fs)))
    (values (nreverse tys) (nreverse fs))))

(defun infer-loop (form env)
  ;; (loop$ for V in L [when C] ACC BODY) | (loop$ for V from A to B [when C] ACC BODY)
  (destructuring-bind (v . rest) (cddr form)
    ;; Known-failure exclusion (finding F6): ACL2 rejects a loop$ whose variable has
    ;; the name of a df variable in scope when the target expression uses that df.
    (when (and (dfp* (cdr (assoc v env))) (not *keep-f6-shape*)) (invalid :known-finding-f6))
    (let (vty cnt-lo cnt-hi head)
      (ecase (first rest)
        (in (multiple-value-bind (lty lf) (infer (second rest) env)
              (unless (listp* lty) (invalid :loop-over-non-list))
              (setf vty (ti (fourth lty) (fifth lty)) cnt-lo (second lty) cnt-hi (third lty)
                    head `(in ,lf) rest (cddr rest))))
        (from (multiple-value-bind (aty af) (infer (second rest) env)
                (multiple-value-bind (bty bf) (infer (fourth rest) env)
                  (unless (and (intp* aty) (intp* bty)) (invalid :loop-bounds))
                  ;; ACL2 requires both bounds to satisfy OF-TYPE even when the loop
                  ;; is empty, and the raw variable is stepped once past the upper bound.
                  ;; The implicit step (BY 1) must satisfy OF-TYPE as well.
                  (setf vty (ti (min 1 (second aty) (second bty))
                                (max 1 (third aty) (1+ (third bty))))
                        cnt-lo (max 0 (1+ (- (second bty) (third aty))))
                        cnt-hi (max 0 (1+ (- (third bty) (second aty))))
                        head `(from ,af to ,bf) rest (cddddr rest))))))
      (when (> cnt-hi 64) (invalid :loop-too-long))
      ;; a loop$ body cannot refer to a df or stobj variable of its context
      (let* ((env2 (acons v vty (remove-if (lambda (b) (or (dfp* (cdr b)) (eq (cdr b) :st))) env)))
             (benv env2) (whenf nil)
             (of-type (and *ann* (chance 70) `(of-type ,(type-for (second vty) (third vty)))))
             (*ann* nil) (*in-restrict* t)) ; no THE inside loop$ bodies
        (when (eq (first rest) 'when)
          (multiple-value-bind (cty cf) (infer (second rest) env2)
            (unless (eq cty :bool) (invalid :when-not-bool))
            (setf whenf `(when ,cf) cnt-lo 0 benv (refine (second rest) env2 t)
                  rest (cddr rest))))
        (destructuring-bind (acc body) rest
          (multiple-value-bind (bty bf) (infer body benv)
            (values
             (ecase acc
               (sum (unless (intp* bty) (invalid :sum-of-non-int))
                (let ((bl (second bty)) (bh (third bty)))
                  (hull (* cnt-lo bl) (* cnt-hi bl) (* cnt-lo bh) (* cnt-hi bh))))
               (collect (unless (intp* bty) (invalid :collect-non-int))
                 (tl cnt-lo cnt-hi (second bty) (third bty)))
               (always (unless (eq bty :bool) (invalid :always-non-bool)) :bool))
             `(loop$ for ,v ,@of-type ,@head ,@whenf ,acc ,bf))))))))

(defun infer-compound (form env)
  (let ((op (car form)))
    (case op
      (quote (let ((l (second form)))
               (cond ((null l) (values (tl 0 0 0 0) nil))
                     ((symbolp l) (values :sym form))
                     ((and (consp l) (every #'integerp l))
                      (values (tl (length l) (length l) (reduce #'min l) (reduce #'max l)) form))
                     (t (invalid :quoted-object)))))
      (coerce                           ; (coerce (list CHAR...) 'string)
       (destructuring-bind (arg to) (cdr form)
         (unless (and (equal to ''string) (consp arg) (eq (car arg) 'list) (cdr arg))
           (invalid :coerce-shape))
         (multiple-value-bind (tys fs) (infer-args (cdr arg) env)
           (dolist (ty tys) (unless (charp* ty) (invalid :coerce-non-char)))
           (values (ts (length tys) (length tys) (reduce #'min (mapcar #'second tys))
                       (reduce #'max (mapcar #'third tys)))
                   `(coerce (list ,@fs) 'string)))))
      (subseq                           ; (subseq SEQ A B), literal bounds
       (destructuring-bind (seq a b) (cdr form)
         (multiple-value-bind (ty f) (infer seq env)
           (unless (and (integerp a) (integerp b) (<= 0 a b) (or (strp* ty) (listp* ty))
                        (<= b (second ty)))
             (invalid :subseq-bounds))
           (values (if (strp* ty) (ts (- b a) (- b a) (fourth ty) (fifth ty))
                       (tl (- b a) (- b a) (fourth ty) (fifth ty)))
                   `(subseq ,f ,a ,b)))))
      (make-list                        ; (make-list N :initial-element E)
       (destructuring-bind (n key e) (cdr form)
         (declare (ignore key))
         (multiple-value-bind (nty nf) (infer n env)
           (multiple-value-bind (ety ef) (infer e env)
             (unless (and (intp* nty) (intp* ety) (>= (second nty) 0) (<= (third nty) 64))
               (invalid :make-list))
             (values (tl (second nty) (third nty) (second ety) (third ety))
                     `(make-list ,nf :initial-element ,ef))))))
      (member-eq (destructuring-bind (k l) (cdr form)
                   (multiple-value-bind (kty kf) (infer k env)
                     (unless (and (eq kty :sym) (consp l) (eq (car l) 'quote)
                                  (every #'symbolp (second l)))
                       (invalid :member-eq))
                     (values :bool `(member-eq ,kf ,l)))))
      (nfix                             ; (nfix (cdr (ASSOC key 'alist))) or (nfix generalized-boolean)
       (let ((arg (second form)))
         (if (and (consp arg) (eq (car arg) 'cdr) (consp (second arg))
                  (member (car (second arg)) '(assoc assoc-eq assoc-equal)))
             (destructuring-bind (afn k al) (second arg)
               (multiple-value-bind (kty kf) (infer k env)
                 (let ((pairs (second al)))
                   (unless (and (eq (car al) 'quote) (consp pairs)
                                (every (lambda (p) (and (consp p) (integerp (cdr p)) (>= (cdr p) 0)))
                                       pairs)
                                (ecase afn
                                  (assoc (and (intp* kty) (every (lambda (p) (integerp (car p))) pairs)))
                                  (assoc-eq (and (eq kty :sym) (every (lambda (p) (symbolp (car p))) pairs)))
                                  (assoc-equal (value-type-p kty))))
                     (invalid :assoc-shape))
                   (values (ti 0 (reduce #'max (mapcar #'cdr pairs)))
                           `(nfix (cdr (,afn ,kf ,al)))))))
             (multiple-value-bind (ty f) (infer arg env)
               (unless (eq ty :bool) (invalid :nfix-arg))
               (values (ti 0 (ash 1 32)) `(nfix ,f))))))
      (the (infer (third form) env))
      (if (destructuring-bind (c a b) (cdr form)
            (multiple-value-bind (cty cf) (infer c env)
              (unless (eq cty :bool) (invalid :test-not-bool c))
              (multiple-value-bind (aty af) (infer a (refine c env t))
                (multiple-value-bind (bty bf) (infer b (refine c env nil))
                  (values (join aty bty) `(if ,cf ,af ,bf)))))))
      ((and or)
       (destructuring-bind (a b) (cdr form)
         (multiple-value-bind (aty af) (infer a env)
           (multiple-value-bind (bty bf) (infer b (refine a env (eq op 'and)))
             (unless (and (eq aty :bool) (eq bty :bool)) (invalid :connective-non-bool))
             (values :bool `(,op ,af ,bf))))))
      ((let let*)
       (destructuring-bind (bindings . dbody) (cdr form)
         (let ((env2 env) (out nil) (decls nil)
               (given (butlast dbody)) (body (car (last dbody))))   ; IGNORE/IGNORABLE declarations pass through
           (dolist (b bindings)
             (multiple-value-bind (ty f) (infer (second b) (if (eq op 'let) env env2))
               (push (list (first b) f) out)
               ;; a TYPE declaration counts as a use, so never on a variable declared IGNOREd
               (when (and *ann* (spec-of ty) (chance 60) (not (mentions (first b) given))
                          ;; one declaration covers every binding of a name in a LET*
                          (= 1 (count (first b) bindings :key #'first)))
                 (push `(type ,(spec-of ty) ,(first b)) decls))
               (setf env2 (acons (first b) ty env2))))
           (multiple-value-bind (ty bf) (infer body env2)
             (values ty `(,op ,(nreverse out) ,@given
                              ,@(when decls `((declare ,@(nreverse decls)))) ,bf))))))
      (flet                             ; (flet ((F (V) BODY)) (F ARG)): BODY sees only V
       (destructuring-bind (((fname (v) . fbody)) (cname arg)) (cdr form)
         (unless (eq fname cname) (invalid :flet-shape))
         (multiple-value-bind (aty af) (infer arg env)
           (multiple-value-bind (bty bf) (infer (car (last fbody)) (list (cons v aty)))
             (values bty `(flet ((,fname (,v) ,@(butlast fbody) ,bf)) (,cname ,af)))))))
      (mv-let (destructuring-bind (vars e . dbody) (cdr form)
                (multiple-value-bind (ety ef) (infer e env)
                  (unless (and (consp ety) (eq (car ety) :mv)
                               (= (length (cdr ety)) (length vars)))
                    (invalid :mv-let-shape))
                  (multiple-value-bind (ty bf)
                      (infer (car (last dbody)) (append (mapcar #'cons vars (cdr ety)) env))
                    (values ty `(mv-let ,vars ,ef ,@(butlast dbody) ,bf))))))
      (mv (multiple-value-bind (tys fs) (infer-args (cdr form) env)
            (values (cons :mv tys) `(mv ,@fs))))
      (mbe ;; The two sides are equal by construction, so nothing inside an MBE is a
           ;; mutation site (changing one side alone would plant a real divergence).
       (let ((*trace* nil))
         (multiple-value-bind (lty lf) (infer (third form) env)
           (multiple-value-bind (ety ef) (infer (fifth form) env)
             (declare (ignore ety))
             (values lty `(mbe :logic ,lf :exec ,ef))))))
      (case (destructuring-bind (sel . clauses) (cdr form)
              (multiple-value-bind (sty sf) (infer sel env)
                (unless (or (intp* sty) (eq sty :sym) (charp* sty)) (invalid :case-selector))
                (let (ty out)
                  (dolist (c clauses)
                    (multiple-value-bind (cty cf) (infer (second c) env)
                      (setf ty (if ty (join ty cty) cty))
                      (push (list (first c) cf) out)))
                  (values ty `(case ,sf ,@(nreverse out)))))))
      (loop$ (infer-loop form env))
      (zm-id (multiple-value-bind (ty f) (infer (second form) env) (values ty `(zm-id ,f))))
      (zm-inc (multiple-value-bind (ty f) (infer (second form) env)
                (values (xfer '1+ (list ty)) `(zm-inc ,f))))
      (zm-sel (destructuring-bind (c a b) (cdr form)
                (multiple-value-bind (cty cf) (infer c env)
                  (unless (eq cty :bool) (invalid :test-not-bool c))
                  (multiple-value-bind (aty af) (infer a (refine c env t))
                    (multiple-value-bind (bty bf) (infer b (refine c env nil))
                      (values (join aty bty) `(zm-sel ,cf ,af ,bf)))))))
      (apply$                      ; (apply$ (lambda$ VARS [decl] BODY) (list ARG...))
       (destructuring-bind (lam args) (cdr form)
         (let ((vars (second lam)) (body (car (last lam))) (annotating *ann*))
           (multiple-value-bind (tys fs) (infer-args (cdr args) env)
             (dolist (ty tys) (unless (intp* ty) (invalid :apply-argument)))
             (let ((*ann* nil) (*in-restrict* t))
               (multiple-value-bind (bty bf) (infer body (mapcar #'cons vars tys))
                 (unless (intp* bty) (invalid :apply-result))
                 (values bty
                         `(apply$ (lambda$ ,vars
                                           ,@(when (and annotating (chance 50))
                                               `((declare (type integer ,@vars))))
                                           ,bf)
                                  (list ,@fs)))))))))
      (t
       (let ((field (find-if (lambda (f) (or (eq op (first f)) (eq op (second f)))) *fields*))
             (sig (fn-sig op)))
         (cond
           (field
            (destructuring-bind (acc upd fty len) field
              (declare (ignore upd))
              (unless (and (eq (car (last form)) 'zst) (eq (cdr (assoc 'zst env)) :st))
                (invalid :stobj-not-in-scope))
              (multiple-value-bind (tys fs) (infer-args (butlast (cdr form)) env)
                (let ((val (if (eq op acc) nil (car (last tys))))
                      (idx (and len (first tys))))
                  (when len
                    (unless (and (intp* idx) (>= (second idx) 0) (<= (third idx) (1- len)))
                      (invalid :array-index)))
                  (when val (unless (sub-p val fty) (invalid :field-type val fty)))
                  (values (if (eq op acc) fty :st) `(,op ,@fs zst))))))
           (sig
            (destructuring-bind (ptys rty) sig
              (multiple-value-bind (tys fs) (infer-args (cdr form) env)
                (unless (= (length tys) (length ptys)) (invalid :arity op))
                (loop for ty in tys for pty in ptys
                      unless (sub-p ty pty) do (invalid :argument op ty pty))
                (values rty `(,op ,@fs)))))
           (t (multiple-value-bind (tys fs) (infer-args (cdr form) env)
                (values (xfer op tys) `(,op ,@fs))))))))))


(defun infer (form env)
  (cond ((integerp form) (values (ti form form) form))
        ((rationalp form) (values (tr form form (denominator form)) form))
        ((characterp form) (values (tc (char-code form) (char-code form)) form))
        ((stringp form)
         (values (if (= (length form) 0) (ts 0 0 0 0)
                     (ts (length form) (length form)
                         (reduce #'min (map 'list #'char-code form))
                         (reduce #'max (map 'list #'char-code form))))
                 form))
        ((eq form t) (values :bool form))
        ((null form) (values (tl 0 0 0 0) form))
        ((keywordp form) (values :sym form))
        ((symbolp form)
         (let ((b (or (assoc form env) (assoc form *consts*))))
           (unless b (invalid :unbound form))
           (values (cdr b) form)))
        (t (multiple-value-bind (ty f) (infer-compound form env)
             (when *trace* (push (list form env ty *in-restrict*) (car *trace*)))
             (values ty (ann-the ty f))))))
