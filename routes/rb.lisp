(in-package "ACL2")
(skip-proofs (defun rt-step (x acc)
  (declare (type (signed-byte 30) x) (type (unsigned-byte 60) acc))
  (the (unsigned-byte 60)
       (logand (+ (* acc 31) (if (evenp x) (ash x 2) (- x))) 1152921504606846975))))
(skip-proofs (defun rt-loop (n x acc)
  (declare (type (integer 0 1000) n) (type (signed-byte 30) x) (type (unsigned-byte 60) acc)
           (xargs :measure (nfix n)))
  (if (zp n) acc (rt-loop (- n 1) (if (< x 0) (- x) (- 7 x)) (rt-step x acc)))))
(defconst *rt-const* (rt-loop 50 12345 7))
(skip-proofs (defun rt-top (x) (declare (type (signed-byte 30) x)) (mv (rt-loop 9 x *rt-const*) (rt-loop 3 x 1))))
