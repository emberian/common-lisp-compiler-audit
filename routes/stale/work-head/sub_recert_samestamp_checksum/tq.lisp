(in-package "ACL2")
(set-guard-checking t)
(cw "@Q tf ~x0~%" (tf 3))
(cw "@Q tg ~x0~%" (tg))
(cw "@Q tc ~x0~%" *tc*)
(cw "@Q sf ~x0~%" (list (sf 3) (sm 3) (si 3) (sh 3) *sk*))
(set-guard-checking :none)
(cw "@N tf ~x0~%" (tf 3))
(set-guard-checking t)
(cw "@W tf ~x0~%" (getpropc 'tf 'unnormalized-body nil (w state)))
(cw "@W tc ~x0~%" (getpropc '*tc* 'const nil (w state)))
(cw "@W sf ~x0~%" (getpropc 'sf 'unnormalized-body nil (w state)))
(make-event `(defthm zs-tf (equal (tf 3) ',(tf 3)) :rule-classes nil :hints (("Goal" :in-theory (disable (:e tf) (:e sf) (:e si$inline))))))
(make-event `(defthm zs-tc (equal *tc* (list (sf 1) (sm 1))) :rule-classes nil :hints (("Goal" :in-theory (disable (:e sf))))))
(cw "@S ~x0~%" (list (if (getpropc 'zs-tf 'theorem nil (w state)) :ok :diff) (if (getpropc 'zs-tc 'theorem nil (w state)) :ok :diff)))
(cw "@END~%")
