(in-package "ACL2")
(defconst *k* 2000)
(defun f (x) (declare (xargs :guard (integerp x))) (+ x *k* 2))
(defun g (x) (declare (xargs :guard t :verify-guards nil)) (if (integerp x) (* 3 x) 0))
(defun h (x) (declare (xargs :mode :program)) (cons x 'hb))
(defmacro m (x) `(list ,x 'mb))
(defun um (x) (declare (xargs :guard t)) (m x))
(encapsulate () (local (defun loc (x) x)) (defun e (x) (declare (xargs :guard t)) (list x 'eb)))
(progn (defun p (x) (declare (xargs :guard t)) (list x 'pb)))
(defun-inline i (x) (declare (xargs :guard t)) (list x 'ib))
(defun ui (x) (declare (xargs :guard t)) (i x))
(defconst *big* (let ((l (make-list 3000 :initial-element 'bb))) (append l (list (f 5)) l)))
(defun ub () (declare (xargs :guard t)) (list (car *big*) (len *big*) (nth 3000 *big*)))
(defstobj st (fld :type integer :initially 6))
(defun rd (st) (declare (xargs :stobjs st)) (+ 200 (fld st)))
(mutual-recursion
 (defun ev1 (n) (declare (xargs :guard (natp n))) (if (zp n) 'ta (od1 (- n 1))))
 (defun od1 (n) (declare (xargs :guard (natp n))) (if (zp n) 'fa (ev1 (- n 1)))))
(defun tz (x) (declare (type (integer 0 100) x)) (+ x 8))
(defun lpz (l) (declare (xargs :guard (true-listp l) :verify-guards nil)) (loop$ for v in l sum (+ (ifix v) 2)))
(defun lm (x) (declare (xargs :guard t)) (apply$ (lambda$ (a) (cons a 'lb)) (list x)))
