(in-package "ACL2")
(defconst *k* 1000)
(defun f (x) (declare (xargs :guard (integerp x))) (+ x *k* 1))
(defun g (x) (declare (xargs :guard t :verify-guards nil)) (if (integerp x) (* 2 x) 0))
(defun h (x) (declare (xargs :mode :program)) (cons x 'ha))
(defmacro m (x) `(list ,x 'ma))
(defun um (x) (declare (xargs :guard t)) (m x))
(encapsulate () (local (defun loc (x) x)) (defun e (x) (declare (xargs :guard t)) (list x 'ea)))
(progn (defun p (x) (declare (xargs :guard t)) (list x 'pa)))
(defun-inline i (x) (declare (xargs :guard t)) (list x 'ia))
(defun ui (x) (declare (xargs :guard t)) (i x))
(defconst *big* (let ((l (make-list 3000 :initial-element 'ba))) (append l (list (f 5)) l)))
(defun ub () (declare (xargs :guard t)) (list (car *big*) (len *big*) (nth 3000 *big*)))
(defstobj st (fld :type integer :initially 5))
(defun rd (st) (declare (xargs :stobjs st)) (+ 100 (fld st)))
(mutual-recursion
 (defun ev1 (n) (declare (xargs :guard (natp n))) (if (zp n) 'ta (od1 (- n 1))))
 (defun od1 (n) (declare (xargs :guard (natp n))) (if (zp n) 'fa (ev1 (- n 1)))))
(defun tz (x) (declare (type (integer 0 100) x)) (+ x 7))
(defun lpz (l) (declare (xargs :guard (true-listp l) :verify-guards nil)) (loop$ for v in l sum (+ (ifix v) 1)))
(defun lm (x) (declare (xargs :guard t)) (apply$ (lambda$ (a) (cons a 'la)) (list x)))
(defthm f-thm (equal (f 0) 1001) :rule-classes nil)
(defun added (x) (cons x 'new))
