(format t "~&=== Testing Suspect #2a: fixnum-ash (ARM64 modulo-64 ASR/LSL) ===~%")
(let ((f-def (compile nil '(lambda (x amt)
                             (declare (fixnum x amt))
                             (the fixnum (ash x amt)))))
      (f-safe (compile nil '(lambda (x amt)
                              (declare (optimize (safety 3) (speed 1))
                                       (fixnum x amt))
                              (the fixnum (ash x amt)))))
      (f-s60 (compile nil '(lambda (x amt)
                             (declare (type (signed-byte 60) x amt))
                             (the (signed-byte 60) (ash x amt)))))
      (f-left (compile nil '(lambda (x amt)
                              (declare (fixnum x)
                                       (type (integer 0 100) amt))
                              (the fixnum (ash x amt))))))
  (dolist (pair '((1 -64) (42 -64) (-100 -64) (1 -65) (8 -65) (-100 -128) (0 64) (0 65)))
    (destructuring-bind (x amt) pair
      (format t "  (ash ~a ~a): expected=~a | f-def=~a | f-safe=~a | f-s60=~a~%"
              x amt
              (ash x amt)
              (funcall f-def x amt)
              (funcall f-safe x amt)
              (funcall f-s60 x amt))))
  (format t "  f-left (0 64): expected=0 | got=~a~%" (funcall f-left 0 64)))

(format t "~&=== Testing Suspect #2b: %ilogbitp-variable-bit (ARM64 modulo-64 LSL) ===~%")
(let ((f-lb-def (compile nil '(lambda (k x)
                                (declare (type (integer 0 100) k)
                                         (fixnum x))
                                (logbitp k x))))
      (f-lb-opt (compile nil '(lambda (k x)
                                (declare (optimize (speed 3) (safety 0))
                                         (fixnum k x))
                                (logbitp k x))))
      (f-lb-u60 (compile nil '(lambda (k x)
                                (declare (optimize (safety 3) (speed 1))
                                         (type (unsigned-byte 60) k)
                                         (type (signed-byte 60) x))
                                (logbitp k x)))))
  (dolist (pair '((60 -1) (61 -1) (62 -1) (63 -1) (64 -1)
                  (60 1) (61 1) (62 1) (63 1) (64 1) (65 2)))
    (destructuring-bind (k x) pair
      (format t "  (logbitp ~a ~a): expected=~a | def=~a | opt=~a | u60-safe=~a~%"
              k x
              (funcall (locally (declare (notinline logbitp)) #'logbitp) k x)
              (funcall f-lb-def k x)
              (funcall f-lb-opt k x)
              (funcall f-lb-u60 k x)))))

(format t "~&=== Testing Suspect #5: trap-unless-simple-array-2 / 3 ===~%")
(handler-case
    (let ((f2 (compile nil '(lambda (a)
                              (declare (optimize (safety 3) (speed 1))
                                       (type (simple-array fixnum (* *)) a))
                              (aref a 0 0)))))
      (format t "  Compiled 2D aref ok: ~a~%" f2)
      (let ((arr (make-array '(2 2) :element-type 'fixnum :initial-element 77)))
        (format t "  Valid 2D call: ~a~%" (funcall f2 arr)))
      (handler-case
          (funcall f2 "not-an-array")
        (error (e) (format t "  Invalid 2D call signaled (~a): ~a~%" (type-of e) e))))
  (error (e)
    (format t "  2D compile/eval CRASHED (~a): ~a~%" (type-of e) e)))

(handler-case
    (let ((f3 (compile nil '(lambda (a)
                              (declare (optimize (safety 3) (speed 1))
                                       (type (simple-array fixnum (* * *)) a))
                              (aref a 0 0 0)))))
      (format t "  Compiled 3D aref ok: ~a~%" f3)
      (let ((arr (make-array '(2 2 2) :element-type 'fixnum :initial-element 88)))
        (format t "  Valid 3D call: ~a~%" (funcall f3 arr)))
      (handler-case
          (funcall f3 "not-an-array")
        (error (e) (format t "  Invalid 3D call signaled (~a): ~a~%" (type-of e) e))))
  (error (e)
    (format t "  3D compile/eval CRASHED (~a): ~a~%" (type-of e) e)))

(format t "~&=== Testing Suspect #4: arm642-fixnum-ref-double-float for-effect ===~%")
(handler-case
    (let ((f4 (compile nil '(lambda (v)
                              (progn (ccl::%fixnum-ref-double-float v 0) :ok)))))
      (format t "  Compiled fixnum-ref-df ok: ~a~%" f4))
  (error (e)
    (format t "  fixnum-ref-df compile CRASHED (~a): ~a~%" (type-of e) e)))

(format t "~&=== Testing Suspect #6: arm642-div2 at (speed 0) (safety 3) ===~%")
(let ((f-div-safe (compile nil '(lambda (x)
                                  (declare (optimize (speed 0) (safety 3)))
                                  (/ (* 4 x) 4))))
      (f-div-ni (compile nil '(lambda (x)
                                (declare (optimize (speed 0) (safety 3))
                                         (notinline / *))
                                (/ (* 4 x) 4))))
      (f-zero-safe (compile nil '(lambda (x)
                                   (declare (optimize (speed 0) (safety 3)))
                                   (/ (* 0 x) -3))))
      (f-zero-ni (compile nil '(lambda (x)
                                 (declare (optimize (speed 0) (safety 3))
                                          (notinline / *))
                                 (/ (* 0 x) -3)))))
  (format t "  div2 overflow (speed 0 safety 3): compiled=~a | notinline=~a~%"
          (handler-case (funcall f-div-safe most-positive-double-float)
            (error (e) (type-of e)))
          (handler-case (funcall f-div-ni most-positive-double-float)
            (error (e) (type-of e))))
  (format t "  div2 signed-zero (speed 0 safety 3): compiled=~a (sign=~a) | notinline=~a (sign=~a)~%"
          (funcall f-zero-safe 1.0d0) (float-sign (funcall f-zero-safe 1.0d0))
          (funcall f-zero-ni 1.0d0) (float-sign (funcall f-zero-ni 1.0d0))))
