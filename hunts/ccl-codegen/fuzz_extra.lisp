;;; fuzz_extra.lisp — Extended Differential Fuzzing for CCL 1.14 (ARM64)
;;; Covers:
;;;   Suite F: Complex single/double floats (+, -, *, /, =, conjugate, realpart, imagpart)
;;;   Suite G: Float decomposition & rounding (scale-float, decode-float, integer-decode-float,
;;;            float-sign, ftruncate, ffloor, fceiling, fround, float)
;;;   Suite H: Bit-vectors & 1D/2D/3D bit/sbit + bit-and/ior/xor/eqv/nand/nor/not/andc1/andc2/orc1/orc2
;;;   Suite I: Strings (char, schar, setf char/schar, string=, subseq, replace, fill)
;;;   Suite J: Register-pressure & untargeted-reg-forms stress (1D/2D/3D typed vs untyped arrays,
;;;            loops with non-constant ash/ldb/dpb/boole, unwind-protect + MV, tagbody/go)

(defpackage :ccl-codegen-fuzz-extra
  (:use :cl))
(in-package :ccl-codegen-fuzz-extra)

(defvar *checks* 0)
(defvar *mismatches* nil)
(defvar *sbcl-extra-cases* nil)

(defun canon (val)
  (cond
    ((floatp val)
     (let ((bits (etypecase val
                   (single-float (logand (ccl::single-float-bits val) #xffffffff))
                   (double-float (multiple-value-bind (hi lo)
                                     (ccl::double-float-bits val)
                                   (logior (ash (logand hi #xffffffff) 32)
                                           (logand lo #xffffffff)))))))
       (list :float (type-of val) bits)))
    ((complexp val)
     (list :complex (canon (realpart val)) (canon (imagpart val))))
    ((consp val)
     (cons (canon (car val)) (canon (cdr val))))
    ((and (vectorp val) (not (stringp val)))
     (cons :vec (map 'list #'canon val)))
    (t val)))

(defun safe-call (fn args)
  (handler-case
      (cons :ok (mapcar #'canon (multiple-value-list (apply fn args))))
    (error (c)
      (list :err (type-of c)))))

(defun diff-check (suite desc params typed-decls untyped-body typed-body arg-tuples &key export-sbcl)
  (let ((fn-ref     (compile nil `(lambda ,params
                                    (declare (optimize (speed 0) (safety 3) (debug 3)))
                                    ,untyped-body)))
        (fn-safe    (compile nil `(lambda ,params
                                    (declare (optimize (speed 1) (safety 3))
                                             ,@typed-decls)
                                    ,typed-body)))
        (fn-default (compile nil `(lambda ,params
                                    (declare (optimize (speed 1) (safety 1))
                                             ,@typed-decls)
                                    ,typed-body)))
        (fn-opt     (compile nil `(lambda ,params
                                    (declare (optimize (speed 3) (safety 0) (space 0) (debug 0))
                                             ,@typed-decls)
                                    ,typed-body)))
        (sbcl-rows nil))
    (dolist (args arg-tuples)
      (incf *checks*)
      (let ((r-ref (safe-call fn-ref args))
            (r-safe (safe-call fn-safe args))
            (r-def (safe-call fn-default args))
            (r-opt (safe-call fn-opt args)))
        (when export-sbcl
          (push (list args r-ref) sbcl-rows))
        (unless (and (equal r-ref r-safe)
                     (equal r-ref r-def)
                     (equal r-ref r-opt))
          (unless (and (eq (car r-ref) :err)
                       (equal r-ref r-safe))
            (let ((rec (list :suite suite :desc desc :args args
                             :ref r-ref :safe r-safe :default r-def :opt r-opt)))
              (push rec *mismatches*)
              (format t "~%[MISMATCH] [~A] ~A~%  args=~S~%  ref=~S~%  safe=~S~%  def=~S~%  opt=~S~%"
                      suite desc args r-ref r-safe r-def r-opt))))))
    (when export-sbcl
      (push (list :desc desc :params params :body untyped-body :rows (reverse sbcl-rows))
            *sbcl-extra-cases*))))

;;; Suite F: Complex single-float & double-float
(defun run-suite-f ()
  (format t "~%=== Running Suite F: Complex Single/Double Float Ops ===~%")
  (let ((cs-vals (list #c(0.0f0 0.0f0) #c(-0.0f0 0.0f0) #c(0.0f0 -0.0f0) #c(-0.0f0 -0.0f0)
                       #c(1.5f0 -2.25f0) #c(-3.0f0 4.0f0) #c(0.5f0 0.5f0) #c(12.0f0 0.0f0)))
        (cd-vals (list #c(0.0d0 0.0d0) #c(-0.0d0 0.0d0) #c(0.0d0 -0.0d0) #c(-0.0d0 -0.0d0)
                       #c(1.5d0 -2.25d0) #c(-3.0d0 4.0d0) #c(0.5d0 0.5d0) #c(12.0d0 0.0d0))))
    (let ((cs-pairs (loop for a in cs-vals nconc (loop for b in cs-vals collect (list a b))))
          (cd-pairs (loop for a in cd-vals nconc (loop for b in cd-vals collect (list a b)))))
      (dolist (op '(+ - * =))
        (diff-check :suite-f (format nil "complex single-float ~A" op)
                    '(a b) '((type (complex single-float) a b))
                    `(,op a b) `(,op a b) cs-pairs :export-sbcl t)
        (diff-check :suite-f (format nil "complex double-float ~A" op)
                    '(a b) '((type (complex double-float) a b))
                    `(,op a b) `(,op a b) cd-pairs :export-sbcl t))
      (dolist (op '(- conjugate realpart imagpart abs))
        (diff-check :suite-f (format nil "complex single-float unary ~A" op)
                    '(a) '((type (complex single-float) a))
                    `(,op a) `(,op a) (mapcar #'list cs-vals) :export-sbcl t)
        (diff-check :suite-f (format nil "complex double-float unary ~A" op)
                    '(a) '((type (complex double-float) a))
                    `(,op a) `(,op a) (mapcar #'list cd-vals) :export-sbcl t))
      ;; complex construction from typed floats
      (diff-check :suite-f "complex single-float ctor"
                  '(r i) '((type single-float r i))
                  '(complex r i) '(complex r i)
                  '((0.0f0 0.0f0) (-0.0f0 0.0f0) (0.0f0 -0.0f0) (1.5f0 -2.5f0)) :export-sbcl t)
      (diff-check :suite-f "complex double-float ctor"
                  '(r i) '((type double-float r i))
                  '(complex r i) '(complex r i)
                  '((0.0d0 0.0d0) (-0.0d0 0.0d0) (0.0d0 -0.0d0) (1.5d0 -2.5d0)) :export-sbcl t))))

;;; Suite G: Float decomposition, rounding, signed-zero & conversion
(defun run-suite-g ()
  (format t "~%=== Running Suite G: Float Decomposition, Rounding & Conversion ===~%")
  (let ((dvals (list 0.0d0 -0.0d0 0.5d0 -0.5d0 1.0d0 -1.0d0 1.5d0 -1.5d0 2.5d0 -2.5d0
                     3.75d0 -3.75d0 1.0d20 -1.0d20 least-positive-normalized-double-float
                     least-positive-double-float (- least-positive-double-float)))
        (svals (list 0.0f0 -0.0f0 0.5f0 -0.5f0 1.0f0 -1.0f0 1.5f0 -1.5f0 2.5f0 -2.5f0
                     3.75f0 -3.75f0 1.0f10 -1.0f10 least-positive-normalized-single-float
                     least-positive-single-float (- least-positive-single-float))))
    (dolist (op '(decode-float integer-decode-float float-sign ftruncate ffloor fceiling fround))
      (diff-check :suite-g (format nil "double-float ~A" op)
                  '(x) '((type double-float x))
                  `(,op x) `(,op x) (mapcar #'list dvals) :export-sbcl t)
      (diff-check :suite-g (format nil "single-float ~A" op)
                  '(x) '((type single-float x))
                  `(,op x) `(,op x) (mapcar #'list svals) :export-sbcl t))
    (let ((spairs (loop for x in dvals nconc (loop for k in '(-10 -1 0 1 10 53) collect (list x k)))))
      (diff-check :suite-g "scale-float double-float"
                  '(x k) '((type double-float x) (type fixnum k))
                  '(scale-float x k) '(scale-float x k) spairs :export-sbcl t))
    ;; Integer -> float conversions near 53-bit & 64-bit seams
    (let ((ivals (mapcar #'list (list 0 1 -1 (1- (ash 1 24)) (ash 1 24) (1+ (ash 1 24))
                                      (1- (ash 1 53)) (ash 1 53) (1+ (ash 1 53)) (+ (ash 1 53) 3)
                                      most-positive-fixnum most-negative-fixnum
                                      (1- (ash 1 63)) (- (ash 1 63)) (1- (ash 1 64))))))
      (diff-check :suite-g "coerce int->double-float"
                  '(n) '((type integer n))
                  '(float n 1.0d0) '(float n 1.0d0) ivals :export-sbcl t)
      (diff-check :suite-g "coerce fixnum->double-float"
                  '(n) '((type fixnum n))
                  '(float n 1.0d0) '(float n 1.0d0)
                  (remove-if-not (lambda (row) (typep (first row) 'fixnum)) ivals))
      (diff-check :suite-g "coerce int->single-float"
                  '(n) '((type integer n))
                  '(float n 1.0f0) '(float n 1.0f0) ivals :export-sbcl t))))

;;; Suite H: Bit arrays (1D/2D/3D bit & sbit, plus bit-vector logical ops across >64 bits)
(defun run-suite-h ()
  (format t "~%=== Running Suite H: Bit Arrays (1D/2D/3D) & Bit-Vector Ops ===~%")
  ;; 1D simple-bit-vector across word seams (0, 1, 31, 32, 63, 64, 65, 127, 128, 129)
  (let ((indices (loop for idx in '(0 1 7 31 32 62 63 64 65 127 128 129)
                       nconc (list (list idx 0) (list idx 1)))))
    (diff-check :suite-h "sbit / setf sbit 130-bit seam"
                '(idx val) '((type fixnum idx) (type bit val))
                '(let ((bv (make-array 130 :element-type 'bit :initial-element 0)))
                   (setf (bit bv 63) 1 (bit bv 64) 1)
                   (let ((r (setf (sbit bv idx) val)))
                     (list r (sbit bv idx) (sbit bv 63) (sbit bv 64) (bit-not bv))))
                '(let ((bv (make-array 130 :element-type 'bit :initial-element 0)))
                   (declare (type (simple-bit-vector 130) bv))
                   (setf (sbit bv 63) 1 (sbit bv 64) 1)
                   (let ((r (setf (sbit bv idx) val)))
                     (list r (sbit bv idx) (sbit bv 63) (sbit bv 64) (bit-not bv))))
                indices :export-sbcl t))
  ;; All bit-vector bitwise ops on 135-bit vectors
  (dolist (bop '(bit-and bit-ior bit-xor bit-eqv bit-nand bit-nor bit-andc1 bit-andc2 bit-orc1 bit-orc2))
    (diff-check :suite-h (format nil "~A 135-bit" bop)
                '(seed) '((type fixnum seed))
                `(let ((a (make-array 135 :element-type 'bit :initial-element 0))
                       (b (make-array 135 :element-type 'bit :initial-element 1)))
                   (dotimes (i 135)
                     (setf (sbit a i) (logand (ash seed (- (mod i 11))) 1))
                     (setf (sbit b i) (logand (ash (lognot seed) (- (mod i 7))) 1)))
                   (,bop a b))
                `(let ((a (make-array 135 :element-type 'bit :initial-element 0))
                       (b (make-array 135 :element-type 'bit :initial-element 1)))
                   (declare (type (simple-bit-vector 135) a b))
                   (dotimes (i 135)
                     (setf (sbit a i) (logand (ash seed (- (mod i 11))) 1))
                     (setf (sbit b i) (logand (ash (lognot seed) (- (mod i 7))) 1)))
                   (,bop a b))
                '((0) (1) (#x555) (#x7ff) (-1)) :export-sbcl t)))

;;; Suite I: Strings (char, schar, setf char/schar, subseq, replace, fill)
(defun run-suite-i ()
  (format t "~%=== Running Suite I: Strings & Sequence Primitives ===~%")
  (diff-check :suite-i "simple-string schar / setf schar unicode"
              '(i ch) '((type fixnum i) (type character ch))
              '(let ((s (copy-seq "Hello-αβγ!")))
                 (let ((old (char s i))
                       (ret (setf (char s i) ch)))
                   (list old ret (char s 0) (char s i) (length s))))
              '(let ((s (copy-seq "Hello-αβγ!")))
                 (declare (type simple-string s))
                 (let ((old (schar s i))
                       (ret (setf (schar s i) ch)))
                   (list old ret (schar s 0) (schar s i) (length s))))
              '((0 #\X) (6 #\λ) (9 #\Z)) :export-sbcl t)
  (diff-check :suite-i "vector fill / replace / subseq"
              '(s1 e1 s2) '((type fixnum s1 e1 s2))
              '(let ((v1 (vector 10 20 30 40 50 60))
                     (v2 (vector 1 2 3 4)))
                 (replace v1 v2 :start1 s1 :end1 e1 :start2 s2)
                 (list (subseq v1 0 6) (fill (copy-seq v2) 99 :start 1 :end 3)))
              '(let ((v1 (vector 10 20 30 40 50 60))
                     (v2 (vector 1 2 3 4)))
                 (declare (type simple-vector v1 v2))
                 (replace v1 v2 :start1 s1 :end1 e1 :start2 s2)
                 (list (subseq v1 0 6) (fill (copy-seq v2) 99 :start 1 :end 3)))
              '((0 4 0) (1 4 1) (2 5 0) (0 2 2)) :export-sbcl t))

;;; Suite J: Register-pressure & untargeted-reg-forms stress (2D aset2, 3D aref3, loops, MV+unwind-protect)
(defun run-suite-j ()
  (format t "~%=== Running Suite J: Register Pressure, 2D/3D Arrays & Loop Stress ===~%")
  ;; 1. 2D aset2 typed vs untyped under register pressure (catches Bug #1!)
  (dolist (etype '(fixnum (unsigned-byte 8) (signed-byte 32) (unsigned-byte 64) bit double-float))
    (let ((zero (if (eq etype 'double-float) 0.0d0 0))
          (val  (if (eq etype 'double-float) 7.5d0 1)))
      (diff-check :suite-j (format nil "2D ~S setf aref reg-clobber check" etype)
                  '(vec fn cvar)
                  '((type simple-vector vec))
                  ;; Reference: untyped array, fresh copy per call!
                  `(let ((a (make-array '(2 2) :element-type ',etype :initial-element ,zero))
                         (s (copy-seq vec)))
                     (declare (notinline aref))
                     (setf (aref a (funcall fn 0) cvar)
                           (setf (svref s cvar) ,val))
                     (list (aref a 0 0) (aref a 0 1) (aref a 1 0) (aref a 1 1) (svref s cvar)))
                  ;; Typed: triggers arm642-aset2 -> arm642-four-untargeted-reg-forms!
                  `(let ((a (make-array '(2 2) :element-type ',etype :initial-element ,zero))
                         (s (copy-seq vec)))
                     (flet ((do-it (arr2 sv f idx)
                              (declare (type (simple-array ,etype (2 2)) arr2))
                              (setf (aref arr2 (funcall f 0) idx)
                                    (setf (svref sv idx) ,val))))
                       (declare (notinline do-it))
                       (do-it a s fn cvar)
                       (list (aref a 0 0) (aref a 0 1) (aref a 1 0) (aref a 1 1) (svref s cvar))))
                  (list (list (vector zero zero) #'identity 1)))))

  ;; 2. 3D aref3 typed vs untyped under register pressure (catches Bug #1 in 3D reads!)
  (diff-check :suite-j "3D simple-array T aref3 reg-clobber check"
              '(fn cvar) '()
              '(let ((arr (make-array '(2 2 2)
                                      :initial-contents '(((:a000 :a001) (:a010 :a011))
                                                          ((:a100 :a101) (:a110 :a111)))))
                     (u8 (make-array '(2 2) :element-type '(unsigned-byte 8) :initial-element 9)))
                 (declare (notinline aref))
                 (aref arr (funcall fn 0) cvar
                       (prog1 0 (funcall fn 0) (setf (aref u8 0 cvar) 0))))
              '(let ((arr (make-array '(2 2 2)
                                      :initial-contents '(((:a000 :a001) (:a010 :a011))
                                                          ((:a100 :a101) (:a110 :a111)))))
                     (u8 (make-array '(2 2) :element-type '(unsigned-byte 8) :initial-element 9)))
                 (flet ((do-read (a u f idx)
                          (declare (type (simple-array t (2 2 2)) a)
                                   (type (simple-array (unsigned-byte 8) (2 2)) u))
                          (aref a (funcall f 0) idx
                                (prog1 0 (funcall f 0) (setf (aref u 0 idx) 0)))))
                   (declare (notinline do-read))
                   (do-read arr u8 fn cvar)))
              (list (list #'identity 1) (list #'identity 0)))

  ;; 3. Loop + variable ash/ldb/dpb/boole + multiple-value-bind + unwind-protect
  (diff-check :suite-j "loop variable ash/ldb/dpb + unwind-protect MV"
              '(x n) '((type integer x) (type fixnum n))
              '(let ((acc 0)
                     (cleanups 0))
                 (multiple-value-bind (q r)
                     (unwind-protect
                          (progn
                            (dotimes (i n)
                              (let ((sh (- i 4))
                                    (w (mod (* i 7) 33))
                                    (p (mod (* i 5) 40)))
                                (setq acc (dpb (ldb (byte w p) (ash x sh))
                                               (byte w (mod i 17))
                                               (logxor acc i)))))
                            (floor acc (max 1 n)))
                       (incf cleanups 10))
                   (values q r cleanups acc)))
              '(let ((acc 0)
                     (cleanups 0))
                 (declare (type integer acc) (type fixnum cleanups))
                 (multiple-value-bind (q r)
                     (unwind-protect
                          (progn
                            (dotimes (i n)
                              (declare (type fixnum i))
                              (let ((sh (the fixnum (- i 4)))
                                    (w (the (integer 0 64) (mod (the fixnum (* i 7)) 33)))
                                    (p (the (integer 0 64) (mod (the fixnum (* i 5)) 40))))
                                (setq acc (dpb (ldb (byte w p) (ash x sh))
                                               (byte w (mod i 17))
                                               (logxor acc i)))))
                            (floor acc (max 1 n)))
                       (incf cleanups 10))
                   (values q r cleanups acc)))
              (list (list #x123456789abcdef0 12)
                    (list -9876543210987654321 15)
                    (list most-negative-fixnum 10)
                    (list (ash 1 70) 9))
              :export-sbcl t))

(defun dump-sbcl-extra (path)
  (with-open-file (out path :direction :output :if-exists :supersede)
    (with-standard-io-syntax
      (let ((*print-readably* nil)
            (*print-circle* nil))
        (prin1 (reverse *sbcl-extra-cases*) out)
        (terpri out)))))

(defun run-all-extra ()
  (setq *checks* 0 *mismatches* nil *sbcl-extra-cases* nil)
  (run-suite-f)
  (run-suite-g)
  (run-suite-h)
  (run-suite-i)
  (run-suite-j)
  (dump-sbcl-extra "/Users/ember/dev/compiler-audit/hunts/ccl-codegen/sbcl_extra_vectors.sexp")
  (format t "~%========================================~%")
  (format t "Extra differential checks:   ~D~%" *checks*)
  (format t "Extra mismatches found:      ~D~%" (length *mismatches*))
  (format t "Exported SBCL extra suites:  ~D~%" (length *sbcl-extra-cases*))
  (format t "========================================~%"))

(run-all-extra)
