(cw "~%=== PROBE 6: CCG LOOP$-RECURSION & CHK-ASSUMPTION-FREE-TTREE ===~%")
(acl2::set-termination-method :ccg)
(defun ccg-loop-rec (n)
  (declare (xargs :mode :logic))
  (if (zp n)
      0
    (loop$ for i in (list (1- n)) sum (ccg-loop-rec i))))
(value-triple :ccg-loop-rec-admitted)
(defun ccg-loop-nonterm (n)
  (declare (xargs :mode :logic))
  (loop$ for i in (list n) sum (+ 1 (ccg-loop-nonterm i))))
(value-triple :ccg-loop-nonterm-ADMITTED!!)
(defun ccg-mbe-nonterm (n)
  (declare (xargs :mode :logic :guard (natp n)))
  (mbe :logic (if (zp n) 0 (1+ (ccg-mbe-nonterm (1- n))))
       :exec (if (= n 0) 0 (ccg-mbe-nonterm n))))
(value-triple :ccg-mbe-nonterm-ok)
