(in-package "ACL2S")

(cw "~%=== 1. MAP.LISP MUTUAL REC WHERE M-IMPLIES-ALISTP CAN SUCCEED ===~%")
(defdata (mk (oneof nil mr))
         (mr (map mk nat)))
(defdata (mk2 (oneof 1 (cons 'tag mr2)))
         (mr2 (map mk2 nat)))

(cw "~%=== 2. CCG HINTS / ASSUMPTION / RULER / NON-EXEC ===~%")
(acl2::set-termination-method :ccg)
(defun ccg-bad-by (n)
  (declare (xargs :mode :logic :hints (("Goal" :by nil))))
  (if (zp n) 0 (1+ (ccg-bad-by n))))
(defun ccg-nonexec (n)
  (declare (xargs :mode :logic :non-executable t))
  (if (zp n) 0 (1+ (ccg-nonexec n))))

(cw "~%=== 3. REGISTER-TYPE WITH GARBAGE / PROGRAM / TYPE-VIOLATING ENUMERATOR ===~%")
(defun bad-type-enum (n)
  (declare (xargs :guard (natp n)))
  (declare (ignore n))
  "NOT-A-NAT")
(register-type fake-nat :predicate natp :enumerator bad-type-enum)
(thm (natp (nth-fake-nat 0)))
(value-triple (nth-fake-nat 0))

(cw "~%=== 4. DEFINEC VARIABLE CAPTURE IN OUTPUT-CONTRACT / BODY ===~%")
(definec cap1 (acl2s::x :nat) :pos (+ acl2s::x 1))
(definec cap2 (defdata::x :nat) :pos (+ defdata::x 1))
(definec cap3 (acl2::x :nat) :pos (+ acl2::x 1))
(definec cap-y (x :nat y :nat) :nat (+ x y))
(definec cap-undef (x :nat) :nat :undefined-value "not-a-nat" (+ x 1))
(cap-undef -1)
