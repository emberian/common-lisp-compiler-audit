(load "/Users/ember/dev/compiler-audit/dietz/load.lisp")
(in-package :cl-test)
(let* ((n (parse-integer (cl-user::env "DIETZ_N" "200")))
       (size (parse-integer (cl-user::env "DIETZ_SIZE" "100")))
       (nvars (parse-integer (cl-user::env "DIETZ_NVARS" "3")))
       (out (cl-user::env "DIETZ_OUT" "failures.lsp"))
       (*random-state* (make-random-state t))
       (raw (handler-bind ((warning #'muffle-warning))
              (test-random-integer-forms size nvars n :random-size t :random-nvars t)))
       (pruned (handler-bind ((warning #'muffle-warning)) (prune-results raw))))
  (with-open-file (s out :direction :output :if-exists :supersede)
    (let ((*print-readably* nil) (*print-pretty* t))
      (dolist (x pruned) (print x s) (terpri s))))
  (format t "~&DIETZ-DONE impl=~A ~A forms=~D raw-failures=~D pruned=~D~%"
          (lisp-implementation-type) (lisp-implementation-version)
          n (length raw) (length pruned)))
#+sbcl (sb-ext:exit :code 0 :abort t)
#+ccl (ccl:quit 0)
