;; Probe G: broad differential battery.
;; Level 1: E(a,b) over word-typed a,b producing (possibly) s128.
;; Level 2: consumer narrows to word/boolean.
;; Compare (speed 3)(safety 0) compiled vs notinline reference.
(load (merge-pathnames "harness.lisp" *load-truename*))
(setq *compile-print* nil)
(setq *compile-verbose* nil)

(defparameter *fails* 0)

(defparameter *u64-pairs*
  '((0 1) (1 0) (1 1) (2 3) (18446744073709551615 1) (18446744073709551615 2)
    (9223372036854775808 9223372036854775808) (9223372036854775807 9223372036854775807)
    (4611686018427387904 4611686018427387903) (18446744073709551615 18446744073709551615)
    (0 0) (13835058055282163710 4611686018427387906)))
(defparameter *s64-pairs*
  '((0 1) (1 -1) (-1 1) (-1 -1) (9223372036854775807 1) (-9223372036854775808 -1)
    (9223372036854775807 9223372036854775807) (-9223372036854775808 -9223372036854775808)
    (4611686018427387903 -4611686018427387904) (0 0) (9223372036854775808prohibited)))
(setq *s64-pairs* (substitute 0 '9223372036854775808prohibited *s64-pairs*))

(defparameter *consumers*
  '((lambda (s) s)
    (lambda (s) (logand s 18446744073709551615))
    (lambda (s) (logand s 9223372036854775807))
    (lambda (s) (ash s -1))
    (lambda (s) (ash s -63))
    (lambda (s) (ash s -64))
    (lambda (s) (ash s -65))
    (lambda (s) (ash s -100))
    (lambda (s) (ash s 1))
    (lambda (s) (< s 0))
    (lambda (s) (< s 1000000))
    (lambda (s) (= s 0))
    (lambda (s) (integer-length s))
    (lambda (s) (logcount s))
    (lambda (s) (logbitp 63 s))
    (lambda (s) (logbitp 100 s))
    (lambda (s) (evenp s))
    (lambda (s) (abs s))
    (lambda (s) (min s 4611686018427387903))
    (lambda (s) (max s -4611686018427387904))
    (lambda (s) (+ s 1))
    (lambda (s) (* s 3))
    (lambda (s) (lognot s))))

(defun run-combo (name type-a type-b pairs expr)
  (setq pairs (remove-if-not (lambda (p) (and (typep (first p) type-a)
                                              (typep (second p) type-b)))
                            pairs))
  (dolist (consumer *consumers*)
    (handler-case
        (let* ((body `(,consumer ,expr))
               (f (compile nil `(lambda (a b)
                                  (declare (type ,type-a a) (type ,type-b b)
                                           (optimize (speed 3) (safety 0)))
                                  ,body)))
               (g (compile nil `(lambda (a b)
                                  (declare (type ,type-a a) (type ,type-b b)
                                           (optimize (speed 3) (safety 0)))
                                  (locally (declare (notinline + - * logand logior logxor
                                                          lognot ash logbitp))
                                    ,body)))))
          (dolist (p pairs)
            (let ((r1 (multiple-value-list (ignore-errors (apply f p))))
                  (r2 (multiple-value-list (ignore-errors (apply g p)))))
              (unless (equalp r1 r2)
                (incf *fails*)
                (format t "DIVERGE ~a consumer=~s args=~s inline=~s ref=~s~%"
                        name (second consumer) p r1 r2)))))
      (error (e)
        (format t "COMPILE-ERROR ~a consumer=~s: ~a~%" name (second consumer) e)))))

;; one-arg producers too
(defun run-combo1 (name type vals expr)
  (dolist (consumer *consumers*)
    (handler-case
        (let* ((body `(,consumer ,expr))
               (f (compile nil `(lambda (a)
                                  (declare (type ,type a)
                                           (optimize (speed 3) (safety 0)))
                                  ,body)))
               (g (compile nil `(lambda (a)
                                  (declare (type ,type a)
                                           (optimize (speed 3) (safety 0)))
                                  (locally (declare (notinline + - * logand logior logxor
                                                          lognot ash logbitp))
                                    ,body)))))
          (dolist (v vals)
            (let ((r1 (multiple-value-list (ignore-errors (funcall f v))))
                  (r2 (multiple-value-list (ignore-errors (funcall g v)))))
              (unless (equalp r1 r2)
                (incf *fails*)
                (format t "DIVERGE ~a consumer=~s arg=~s inline=~s ref=~s~%"
                        name (second consumer) v r1 r2)))))
      (error (e)
        (format t "COMPILE-ERROR ~a consumer=~s: ~a~%" name (second consumer) e)))))

(format t "== u64 arithmetic ==~%")
(run-combo 'u64+ '(unsigned-byte 64) '(unsigned-byte 64) *u64-pairs* '(+ a b))
(run-combo 'u64- '(unsigned-byte 64) '(unsigned-byte 64) *u64-pairs* '(- a b))
(run-combo 'u64* '(unsigned-byte 64) '(unsigned-byte 64) *u64-pairs* '(* a b))
(run-combo 'u64logior '(unsigned-byte 64) '(unsigned-byte 64) *u64-pairs* '(logior a b))
(run-combo 'u64logxor '(unsigned-byte 64) '(unsigned-byte 64) *u64-pairs* '(logxor a b))
(run-combo 'u64logand '(unsigned-byte 64) '(unsigned-byte 64) *u64-pairs* '(logand a b))
(run-combo 'u64ash '(unsigned-byte 64) '(signed-byte 64) *u64-pairs* '(ash a b))
(format t "u64 done, fails so far: ~a~%" *fails*)

(format t "== s64 arithmetic ==~%")
(run-combo 's64+ '(signed-byte 64) '(signed-byte 64) *s64-pairs* '(+ a b))
(run-combo 's64- '(signed-byte 64) '(signed-byte 64) *s64-pairs* '(- a b))
(run-combo 's64* '(signed-byte 64) '(signed-byte 64) *s64-pairs* '(* a b))
(run-combo 's64logior '(signed-byte 64) '(signed-byte 64) *s64-pairs* '(logior a b))
(run-combo 's64logxor '(signed-byte 64) '(signed-byte 64) *s64-pairs* '(logxor a b))
(run-combo 's64logand '(signed-byte 64) '(signed-byte 64) *s64-pairs* '(logand a b))
(run-combo 's64ash '(signed-byte 64) '(signed-byte 64) *s64-pairs* '(ash a b))
(format t "s64 done, fails so far: ~a~%" *fails*)

(format t "== mixed u64/s64 ==~%")
(run-combo 'mix-logior '(unsigned-byte 64) '(signed-byte 64) *u64-pairs* '(logior a b))
(run-combo 'mix-logxor '(unsigned-byte 64) '(signed-byte 64) *u64-pairs* '(logxor a b))
(run-combo 'mix-logand '(unsigned-byte 64) '(signed-byte 64) *u64-pairs* '(logand a b))
(run-combo 'mix-+ '(unsigned-byte 64) '(signed-byte 64) *u64-pairs* '(+ a b))
(format t "mixed done, fails so far: ~a~%" *fails*)

(format t "== one-arg ==~%")
(run-combo1 'u64lognot '(unsigned-byte 64) *u64* '(lognot a))
(run-combo1 's64lognot '(signed-byte 64) *s64* '(lognot a))
(run-combo1 'u64neg '(unsigned-byte 64) *u64* '(- a))
(run-combo1 's64neg '(signed-byte 64) *s64* '(- a))
(run-combo1 's64abs '(signed-byte 64) *s64* '(abs a))
(run-combo1 'fixashL '(fixnum) *fixnums* '(ash a 33))
(format t "probe G done, fails=~a~%" *fails*)
