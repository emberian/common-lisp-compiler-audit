;; Probe H: division family (floor truncate mod rem ceiling) by constants
;; and by variables; multiple values compared; also integer-length/logcount/
;; abs/min/max/expt/logbitp with declared types.
(load (merge-pathnames "harness.lisp" *load-truename*))

(defparameter *div-ops* '(floor truncate ceiling mod rem))
(defparameter *divisors*
  '(2 3 4 5 7 8 9 15 16 17 255 256 1000 65536 65537
    2147483647 2147483648 4294967295 4294967296
    4611686018427387903 9223372036854775807 18446744073709551615
    -3 -5 -16 -2147483648 -9223372036854775808))

;; H1: one-arg divisions by constant: (op x c) with x typed
(flet ((div1 (name type vals op c)
         (handler-case
             (let* ((body `(,op x ,c))
                    (f (quiet-compile nil `(lambda (x)
                                             (declare (optimize (speed 3) (safety 0))
                                                      (type ,type x))
                                             ,body)))
                    (g (quiet-compile nil `(lambda (x)
                                             (declare (optimize (speed 3) (safety 0))
                                                      (type ,type x))
                                             (locally (declare (notinline ,op)) ,body)))))
               (dolist (v vals)
                 (let ((r1 (norm-result (multiple-value-list (ignore-errors (funcall f v)))))
                       (r2 (norm-result (multiple-value-list (ignore-errors (funcall g v))))))
                   (unless (equalp r1 r2)
                     (incf *fails*)
                     (format t "DIVERGE ~a/~d x=~s inline=~s ref=~s~%" op c v r1 r2)))))
           (error (e) (format t "ERR ~a ~a ~a: ~a~%" name op c e)))))
  (dolist (op *div-ops*)
    (dolist (c *divisors*)
      (div1 'fixnum 'fixnum *fixnums* op c)
      (div1 'u64 '(unsigned-byte 64) *u64* op c)
      (div1 's64 '(signed-byte 64) *s64* op c)
      (div1 's128 '(signed-byte 128) *s128* op c)))
  (format t "H1 done, fails=~a~%" *fails*))

;; H2: two-arg division with variable divisor
(flet ((div2 (type-a type-b pairs op)
         (handler-case
             (let* ((body `(,op a b))
                    (f (quiet-compile nil `(lambda (a b)
                                             (declare (optimize (speed 3) (safety 0))
                                                      (type ,type-a a) (type ,type-b b))
                                             ,body)))
                    (g (quiet-compile nil `(lambda (a b)
                                             (declare (optimize (speed 3) (safety 0))
                                                      (type ,type-a a) (type ,type-b b))
                                             (locally (declare (notinline ,op)) ,body)))))
               (dolist (p pairs)
                 (let ((r1 (norm-result (multiple-value-list (ignore-errors (apply f p)))))
                       (r2 (norm-result (multiple-value-list (ignore-errors (apply g p))))))
                   (unless (equalp r1 r2)
                     (incf *fails*)
                     (format t "DIVERGE ~a var args=~s inline=~s ref=~s~%" op p r1 r2)))))
           (error (e) (format t "ERR ~a var: ~a~%" op e)))))
  (dolist (op *div-ops*)
    (div2 'fixnum 'fixnum
          '((7 2) (-7 2) (7 -2) (-7 -2) (0 5) (4611686018427387903 3)
            (-4611686018427387904 3) (100 7) (-100 7))
          op)
    (div2 '(unsigned-byte 64) '(unsigned-byte 64)
          '((7 2) (0 5) (18446744073709551615 3) (9223372036854775808 2)
            (4611686018427387903 4611686018427387904))
          op)
    (div2 '(signed-byte 64) '(signed-byte 64)
          '((7 2) (-7 2) (7 -2) (-7 -2) (9223372036854775807 3)
            (-9223372036854775808 3) (9223372036854775807 -9223372036854775808))
          op)
    (div2 '(signed-byte 128) '(signed-byte 128)
          '((18446744073709551616 3) (-18446744073709551617 3)
            (170141183460469231731687303715884105727 7)
            (9223372036854775808 9223372036854775808))
          op))
  (format t "H2 done, fails=~a~%" *fails*))

;; H3: integer-length / logcount / abs / logbitp / min / max / expt typed
(flet ((one (name type vals body op)
         (handler-case
             (let ((f (quiet-compile nil `(lambda (x)
                                            (declare (optimize (speed 3) (safety 0))
                                                     (type ,type x))
                                            ,body)))
                   (g (quiet-compile nil `(lambda (x)
                                            (declare (optimize (speed 3) (safety 0))
                                                     (type ,type x))
                                            (locally (declare (notinline ,op)) ,body)))))
               (dolist (v vals)
                 (let ((r1 (norm-result (multiple-value-list (ignore-errors (funcall f v)))))
                       (r2 (norm-result (multiple-value-list (ignore-errors (funcall g v))))))
                   (unless (equalp r1 r2)
                     (incf *fails*)
                     (format t "DIVERGE ~a ~a x=~s inline=~s ref=~s~%" name op v r1 r2)))))
           (error (e) (format t "ERR ~a ~a: ~a~%" name op e)))))
  (dolist (spec '((fixnum) ((unsigned-byte 64)) ((signed-byte 64)) ((signed-byte 128))))
    (let ((ty (first spec))
          (vals (vals-for (first spec))))
      (one 'len ty vals '(integer-length x) 'integer-length)
      (one 'cnt ty vals '(logcount x) 'logcount)
      (one 'abs ty vals '(abs x) 'abs)
      (one 'not ty vals '(lognot x) 'lognot)
      (dolist (k '(0 1 62 63 64 65 126 127))
        (one 'bitp ty vals `(logbitp ,k x) 'logbitp))
      (one 'evenp ty vals '(evenp x) 'evenp)
      (one 'oddp ty vals '(oddp x) 'oddp)
      (dolist (k '(0 1 62 63 64 65 100 127))
        (one 'ashr ty vals `(ash x ,(- k)) 'ash)
        (one 'ashl ty vals `(ash x ,k) 'ash))))
  (format t "H3 done, fails=~a~%" *fails*))

(format t "probe H done, fails=~a~%" *fails*)
