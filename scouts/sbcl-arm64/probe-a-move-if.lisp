;; Probe A: move-if/word then=else bug (fixed post-2.6.10 by af7cdfe71)
;; Hypothesis: (if test 1 1) or (if test -1 -1) with unboxed word result
;; takes the cneg arm and returns the negated constant when test is true.
(load (merge-pathnames "harness.lisp" *load-truename*))

(format t "=== A1: logand consumer, u64, then=else=1 ===~%")
(handler-case
    (progn
      (flet ((try (c1 c2 op)
               (let* ((src `(lambda (a b)
                              (declare (type (unsigned-byte 64) a b)
                                       (optimize (speed 3) (safety 0)))
                              (,op (if (< a b) ,c1 ,c2) a)))
                      (f (compile nil src))
                      (g (compile nil `(lambda (a b)
                                         (declare (type (unsigned-byte 64) a b)
                                                  (optimize (speed 3) (safety 0)))
                                         (,op (if (funcall (symbol-function '<) a b) ,c1 ,c2) a)))))
                 (dolist (pair '((3 5) (5 3) (0 0) (18446744073709551615 1)))
                   (let ((r1 (multiple-value-list (ignore-errors (apply f pair))))
                         (r2 (multiple-value-list (ignore-errors (apply g pair)))))
                     (unless (equalp r1 r2)
                       (format t "DIVERGE c=~a,~a op=~a args=~s inline=~s ref=~s~%"
                               c1 c2 op pair r1 r2)))))))
        (try 1 1 'logand)
        (try -1 -1 'logand)
        (try 1 1 'logior)
        (try -1 -1 'logior)
        (try 1 1 'logxor)
        (try 1 1 '+)
        (try -1 -1 '-))
      (format t "A1 done~%"))
  (error (e) (format t "A1 ERROR: ~a~%" e)))

(format t "=== A2: fixnum-index array store, s64 ===~%")
(handler-case
    (progn
      (flet ((try (c1 c2)
               (let ((f (compile nil `(lambda (a b v)
                                        (declare (type (signed-byte 64) a b)
                                                 (type (simple-array (signed-byte 64) (1)) v)
                                                 (optimize (speed 3) (safety 0)))
                                        (setf (aref v 0) (if (< a b) ,c1 ,c2))
                                        (aref v 0))))
                     (g (compile nil `(lambda (a b v)
                                        (declare (type (signed-byte 64) a b)
                                                 (type (simple-array (signed-byte 64) (1)) v)
                                                 (optimize (speed 3) (safety 0)))
                                        (setf (aref v 0) (if (funcall (symbol-function '<) a b) ,c1 ,c2))
                                        (aref v 0)))))
                 (dolist (pair '((3 5) (5 3) (-3 5)))
                   (let ((v1 (make-array 1 :element-type '(signed-byte 64)))
                         (v2 (make-array 1 :element-type '(signed-byte 64))))
                     (let ((r1 (multiple-value-list (ignore-errors (funcall f (first pair) (second pair) v1))))
                           (r2 (multiple-value-list (ignore-errors (funcall g (first pair) (second pair) v2)))))
                       (unless (equalp r1 r2)
                         (format t "DIVERGE c=~a,~a args=~s inline=~s ref=~s~%" c1 c2 pair r1 r2))))))))
        (try 1 1)
        (try -1 -1)
        (try 0 0)
        (try 2 2)
        (try 1 -1)
        (try -1 1))
      (format t "A2 done~%"))
  (error (e) (format t "A2 ERROR: ~a~%" e)))

(format t "probe A done, fails=~a~%" *fails*)
