;;; J: exact post-2.6.10 regression shapes plus focused live-fix probes.
(setq *compile-print* nil *compile-verbose* nil)
(defparameter *j-fails* 0)
(defun result (thunk)
  (handler-case (multiple-value-list (funcall thunk))
    (error (e) (list :error (type-of e) (princ-to-string e)))))
(defun jshow (name form &rest args)
  (let ((r (result (lambda () (apply (compile nil form) args)))))
    (format t "JVALUE ~s args=~s => ~s~%" name args r)
    r))
(defun jcmp (name form ref-form args)
  (let ((a (result (lambda () (apply (compile nil form) args))))
        (b (result (lambda () (apply (compile nil ref-form) args)))))
    (unless (equal a b)
      (incf *j-fails*)
      (format t "JDIVERGE ~s args=~s inline=~s ref=~s~%" name args a b))))

;;; J1-J3: regression tests from e7fd560f7 (fix is after 2.6.10).
(let ((forms
       '((lambda (x)
          (declare (optimize (speed 3) (safety 0)))
          (multiple-value-bind (a b)
              (and x (labels ((f (n)
                                (if (< n 0) 3 (f (- n 1)))))
                       (f 1)))
            (declare (ignore b))
            (let ((c a))
              (if (eql c 3) :ok :bad))))
         (lambda (x)
          (declare (optimize (speed 3) (safety 0)))
          (multiple-value-bind (a b)
              (and x (labels ((f (n)
                                (if (< n 0) 3 (f (- n 1)))))
                       (f 1)))
            (declare (ignore b))
            (let* ((c a) (d c) (e d))
              (if (eql e 3) :ok :bad))))
         (lambda (x)
          (declare (optimize (speed 3) (safety 0)))
          (funcall
           (lambda (&optional (a (and x (labels ((f (n)
                                                   (if (< n 0) 3 (f (- n 1)))))
                                          (f 1)))))
             (let ((c a))
               (if (eql c 3) :ok :bad))))))))
  (loop for form in forms for i from 1 do
    (jshow (intern (format nil "OPTIMISTIC-~d" i)) form t)
    (jshow (intern (format nil "OPTIMISTIC-NIL-~d" i)) form nil)))

;;; J4: exact select-tagging regression shape from 017564a7a, value checked.
(let ((inline '(lambda (a b)
                (declare (fixnum a)
                         ((simple-array (unsigned-byte 32) (20)) b)
                         (optimize (speed 3) (safety 0)))
                (setf (aref b 0) (logxor (aref b 0) a))
                a))
      (ref '(lambda (a b)
             (declare (fixnum a)
                      ((simple-array (unsigned-byte 32) (20)) b)
                      (optimize (speed 3) (safety 0)))
             (locally (declare (notinline logxor aref))
               (setf (aref b 0) (logxor (aref b 0) a))
               a))))
  (dolist (a '(0 1 5 127 65535 4611686018427387903))
    (dolist (initial '(0 1 100 4294967295))
      (when (typep (logxor initial a) '(unsigned-byte 32))
        (let ((x (make-array 20 :element-type '(unsigned-byte 32) :initial-element initial))
              (y (make-array 20 :element-type '(unsigned-byte 32) :initial-element initial)))
          (let ((r1 (result (lambda () (funcall (compile nil inline) a x))))
                (r2 (result (lambda () (funcall (compile nil ref) a y)))))
            (unless (and (equal r1 r2) (equalp x y))
              (incf *j-fails*)
              (format t "JDIVERGE TAG-XOR a=~s initial=~s inline=~s/~s ref=~s/~s~%"
                      a initial r1 (aref x 0) r2 (aref y 0)))))))))

;;; J5: constant-initial-value shape from 45bd6e948.
(let ((inline '(lambda (n a)
                (declare ((simple-array (unsigned-byte 32) (100)) a)
                         (optimize (speed 3) (safety 0)))
                (let ((y 0))
                  (when n (setf y (aref a 0)))
                  (aref a (logand y #xf)))))
      (ref '(lambda (n a)
             (declare ((simple-array (unsigned-byte 32) (100)) a)
                      (optimize (speed 3) (safety 0)))
             (locally (declare (notinline logand aref))
               (let ((y 0))
                 (when n (setf y (aref a 0)))
                 (aref a (logand y #xf)))))))
  (dolist (n '(nil t))
    (dolist (initial '(0 1 15 16 255 4294967295))
      (jcmp 'tag-constant-init inline ref (list n (make-array 100 :element-type '(unsigned-byte 32)
                                                                :initial-element initial))))))

;;; J6: modular ASH on signed-128 inputs; all counts are small enough that
;;; the generic reference can represent its intermediate result.
(defparameter *j-s128*
  '(0 1 -1 2 -2 63 -64 4611686018427387903 -4611686018427387904
    4611686018427387904 -4611686018427387905
    9223372036854775807 -9223372036854775808
    9223372036854775808 -9223372036854775809
    18446744073709551615 18446744073709551616
    -18446744073709551616 -18446744073709551617
    170141183460469231731687303715884105727
    -170141183460469231731687303715884105728))
(defparameter *j-counts*
  '(-130 -129 -128 -127 -126 -66 -65 -64 -63 -62 -2 -1 0 1 2 62 63 64 65 66 126 127 128 129 130))
(defun j-ash (name x-type mask n-type)
  (let ((inline (compile nil `(lambda (x n)
                                (declare (type ,x-type x) (type ,n-type n)
                                         (optimize (speed 3) (safety 0)))
                                (logand (ash x n) ,mask))))
        (ref (compile nil `(lambda (x n)
                             (declare (type ,x-type x) (type ,n-type n)
                                      (optimize (speed 3) (safety 0)))
                             (locally (declare (notinline ash logand))
                               (logand (ash x n) ,mask))))))
    (dolist (x *j-s128*)
      (dolist (n *j-counts*)
        (let ((a (result (lambda () (funcall inline x n))))
              (b (result (lambda () (funcall ref x n)))))
          (unless (equal a b)
            (incf *j-fails*)
            (format t "JDIVERGE ~s x=~s n=~s inline=~s ref=~s~%" name x n a b)))))))
(j-ash 'ash-s128-u64-var '(signed-byte 128) 18446744073709551615 'fixnum)
(j-ash 'ash-s128-u64-ranged '(signed-byte 128) 18446744073709551615 '(integer -130 130))
(j-ash 'ash-s128-fx-var '(signed-byte 128) 4611686018427387903 'fixnum)
(j-ash 'ash-s128-fx-ranged '(signed-byte 128) 4611686018427387903 '(integer -130 130))

;;; J7: same transform with an unboxed s128 producer rather than a parameter.
(defun j-ash-producer (name type op mask)
  (let* ((body `(logand (ash (,op a b) n) ,mask))
         (inline (compile nil `(lambda (a b n)
                                 (declare (type ,type a b) (type fixnum n)
                                          (optimize (speed 3) (safety 0)))
                                 ,body)))
         (ref (compile nil `(lambda (a b n)
                              (declare (type ,type a b) (type fixnum n)
                                       (optimize (speed 3) (safety 0)))
                              (locally (declare (notinline ash logand ,op))
                                ,body))))
         (pairs (if (equal type '(signed-byte 64))
                    '((0 0) (1 1) (-1 -1) (9223372036854775807 2)
                      (-9223372036854775808 -1)
                      (9223372036854775807 9223372036854775807)
                      (-9223372036854775808 -9223372036854775808))
                    '((0 0) (1 1) (18446744073709551615 1)
                      (18446744073709551615 18446744073709551615)
                      (9223372036854775808 9223372036854775808)))))
    (dolist (p pairs)
      (dolist (n *j-counts*)
        (let ((args (append p (list n))))
          (let ((a (result (lambda () (apply inline args))))
                (b (result (lambda () (apply ref args)))))
            (unless (equal a b)
              (incf *j-fails*)
              (format t "JDIVERGE ~s args=~s inline=~s ref=~s~%" name args a b))))))))
(j-ash-producer 'ash-u64-sum-u64 '(unsigned-byte 64) '+ 18446744073709551615)
(j-ash-producer 'ash-u64-sum-fx '(unsigned-byte 64) '+ 4611686018427387903)
(j-ash-producer 'ash-s64-product-u64 '(signed-byte 64) '* 18446744073709551615)
(j-ash-producer 'ash-s64-product-fx '(signed-byte 64) '* 4611686018427387903)

(format t "probe J done, fails=~d~%" *j-fails*)
