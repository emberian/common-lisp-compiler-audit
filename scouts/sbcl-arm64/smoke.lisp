;; smoke test: version + basic differential harness
(format t "sbcl version: ~a~%" (sb-unix:unix-gethostname))
(format t "lisp-implementation-version: ~a~%" (lisp-implementation-version))
(format t "machine: ~a~%" (machine-type))
(defparameter *vals* '(0 1 -1 2 -2 3 -3 62 63 64 65 -63 -64 -65
                       (1- (ash 1 62)) (- (ash 1 62)) (ash 1 62) (- (ash 1 62) 1)
                       (1- (ash 1 63)) (- (ash 1 63)) (ash 1 63) (- (1- (ash 1 63)))
                       most-positive-fixnum most-negative-fixnum
                       (1+ most-positive-fixnum) (1- most-negative-fixnum)
                       (1- (ash 1 64)) (- (ash 1 64)) (ash 1 64)))
(defun ev (x) (if (consp x) (eval x) x))
(defun cmp (name f g args-list)
  (dolist (args args-list)
    (let ((a (mapcar #'ev args)))
      (let ((r1 (multiple-value-list (ignore-errors (apply f a))))
            (r2 (multiple-value-list (ignore-errors (apply g a)))))
        (unless (equalp r1 r2)
          (format t "DIVERGE ~a args=~s inline=~s ref=~s~%" name a r1 r2))))))
(defun test (name type body)
  (let* ((src `(lambda (x) (declare (optimize (speed 3) (safety 0))
                                    (type ,type x))
                ,body))
         (f (compile nil src))
         (g (compile nil `(lambda (x) (declare (optimize (speed 3) (safety 0))
                                               (type ,type x))
                           (funcall (symbol-function ',(car body)) x)))))
    (cmp name f g (mapcar (lambda (v) (list v)) *vals*))))
(test '1+ 'fixnum '(1+ x))
(test 'ash1 '(integer -70 70) '(ash 1 x))
(format t "done~%")
