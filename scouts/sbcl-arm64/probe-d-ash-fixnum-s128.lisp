;; Probe D: ash-left-c/fixnum=>s128 with amount 65 — hi word gets the
;; tagged raw value (2n) instead of n.  Sweep amounts 55..66 to bound it.
(load (merge-pathnames "harness.lisp" *load-truename*))

(format t "=== D: (ash (ash x m) -64), x fixnum, m sweep ===~%")
(flet ((drive (m)
         (handler-case
             (let ((f (compile nil `(lambda (x)
                                      (declare (type fixnum x)
                                               (optimize (speed 3) (safety 0)))
                                      (ash (ash x ,m) -64))))
                   (g (compile nil `(lambda (x)
                                      (declare (type fixnum x)
                                               (optimize (speed 3) (safety 0)))
                                      (ash (locally (declare (notinline ash)) (ash x ,m)) -64)))))
               (dolist (v *fixnums*)
                 (let ((r1 (multiple-value-list (ignore-errors (funcall f v))))
                       (r2 (multiple-value-list (ignore-errors (funcall g v)))))
                   (unless (equalp r1 r2)
                     (format t "DIVERGE m=~d x=~s inline=~s ref=~s~%" m v r1 r2))))
               (format t "  m=~d done~%" m))
           (error (e) (format t "  m=~d ERROR: ~a~%" m e)))))
  (dolist (m '(55 60 61 62 63 64 65 66))
    (drive m)))

;; D2: same but extracting the low word instead
(format t "=== D2: (logand (ash x m) 18446744073709551615) ===~%")
(flet ((drive (m)
         (handler-case
             (let ((f (compile nil `(lambda (x)
                                      (declare (type fixnum x)
                                               (optimize (speed 3) (safety 0)))
                                      (logand (ash x ,m) 18446744073709551615))))
                   (g (compile nil `(lambda (x)
                                      (declare (type fixnum x)
                                               (optimize (speed 3) (safety 0)))
                                      (logand (locally (declare (notinline ash)) (ash x ,m))
                                              18446744073709551615)))))
               (dolist (v *fixnums*)
                 (let ((r1 (multiple-value-list (ignore-errors (funcall f v))))
                       (r2 (multiple-value-list (ignore-errors (funcall g v)))))
                   (unless (equalp r1 r2)
                     (format t "DIVERGE m=~d x=~s inline=~s ref=~s~%" m v r1 r2))))
               (format t "  m=~d done~%" m))
           (error (e) (format t "  m=~d ERROR: ~a~%" m e)))))
  (dolist (m '(62 63 64 65))
    (drive m)))

;; D3: signed=>s128 control: x (signed-byte 64) untagged
(format t "=== D3: (ash (ash x m) -64), x signed-word ===~%")
(flet ((drive (m)
         (handler-case
             (let ((f (compile nil `(lambda (x)
                                      (declare (type (signed-byte 64) x)
                                               (optimize (speed 3) (safety 0)))
                                      (ash (ash x ,m) -64))))
                   (g (compile nil `(lambda (x)
                                      (declare (type (signed-byte 64) x)
                                               (optimize (speed 3) (safety 0)))
                                      (ash (locally (declare (notinline ash)) (ash x ,m)) -64)))))
               (dolist (v *s64*)
                 (let ((r1 (multiple-value-list (ignore-errors (funcall f v))))
                       (r2 (multiple-value-list (ignore-errors (funcall g v)))))
                   (unless (equalp r1 r2)
                     (format t "DIVERGE m=~d x=~s inline=~s ref=~s~%" m v r1 r2))))
               (format t "  m=~d done~%" m))
           (error (e) (format t "  m=~d ERROR: ~a~%" m e)))))
  (dolist (m '(62 63 64 65))
    (drive m)))
(format t "probe D done~%")
