;;; T: modular shifts and bit operations on bignums wider than signed 128.
(setq *compile-print* nil *compile-verbose* nil)
(defparameter *t-fails* 0)
(defparameter *t-count* 0)
(defparameter *t-vals*
  (let ((v '(0 1 -1 2 -2 9223372036854775808 -9223372036854775808
            18446744073709551615 -18446744073709551615
            170141183460469231731687303715884105727 -170141183460469231731687303715884105728)))
    (dolist (k '(127 128 129 191 192 193 255 256 257))
      (push (ash 1 k) v)
      (push (- (ash 1 k)) v)
      (push (1- (ash 1 k)) v)
      (push (- (1+ (ash 1 k))) v))
    (push (+ (ash 1 256) (ash 1 192) (ash 1 128) (ash 1 64) 12345) v)
    (push (- (+ (ash 1 256) (ash 1 192) (ash 1 128) (ash 1 64) 12345)) v)
    v))
(defparameter *t-shifts*
  '(-320 -257 -256 -255 -193 -192 -191 -130 -129 -128 -127 -66 -65 -64 -63 -62
    -2 -1 0 1 2 62 63 64 65 66 126 127 128 129 130 191 192 193 255 256 257 320))
(defun t-result (thunk)
  (handler-case (multiple-value-list (funcall thunk))
    (error (e) (list :error (type-of e) (princ-to-string e)))))
(defun t-compile (form)
  (let ((result nil))
    (with-output-to-string (*standard-output*)
      (with-output-to-string (*error-output*) (setf result (compile nil form))))
    result))
(defun t-check (name f g args)
  (let ((a (t-result (lambda () (apply f args))))
        (b (t-result (lambda () (apply g args)))))
    (unless (equal a b)
      (incf *t-fails*)
      (format t "TDIVERGE ~s args=~s inline=~s ref=~s~%" name args a b))))

;;; T1: variable-count shifts and masks.
(dolist (body '((ash x n)
                (logand (ash x n) 18446744073709551615)
                (logand (ash x n) 9223372036854775807)
                (logand (ash x n) 4611686018427387903)))
  (incf *t-count*)
  (let ((f (t-compile `(lambda (x n) (declare (integer x) (fixnum n) (optimize (speed 3) (safety 0))) ,body)))
        (g (t-compile `(lambda (x n) (declare (integer x) (fixnum n) (optimize (speed 3) (safety 0)))
                         (locally (declare (notinline ash logand)) ,body)))))
    (dolist (x *t-vals*)
      (dolist (n *t-shifts*)
        (t-check (list 'variable body) f g (list x n))))))

;;; T2: constant counts select separate ash-into-word transforms.
(dolist (n *t-shifts*)
  (dolist (body `((ash x ,n)
                  (logand (ash x ,n) 18446744073709551615)
                  (logand (ash x ,n) 4611686018427387903)))
    (incf *t-count*)
    (let ((f (t-compile `(lambda (x) (declare (integer x) (optimize (speed 3) (safety 0))) ,body)))
          (g (t-compile `(lambda (x) (declare (integer x) (optimize (speed 3) (safety 0)))
                           (locally (declare (notinline ash logand)) ,body)))))
      (dolist (x *t-vals*)
        (t-check (list 'constant body) f g (list x))))))

;;; T3: bit positions and lengths above 128.
(dolist (body '((integer-length x) (logcount x)
                (logbitp 0 x) (logbitp 62 x) (logbitp 63 x) (logbitp 64 x)
                (logbitp 65 x) (logbitp 126 x) (logbitp 127 x) (logbitp 128 x)
                (logbitp 129 x) (logbitp 191 x) (logbitp 192 x) (logbitp 255 x)
                (logbitp 256 x) (logbitp 257 x)))
  (incf *t-count*)
  (let ((f (t-compile `(lambda (x) (declare (integer x) (optimize (speed 3) (safety 0))) ,body)))
        (g (t-compile `(lambda (x) (declare (integer x) (optimize (speed 3) (safety 0)))
                         (locally (declare (notinline integer-length logcount logbitp)) ,body)))))
    (dolist (x *t-vals*)
      (t-check (list 'bits body) f g (list x)))))
(format t "probe T done, cases=~d fails=~d~%" *t-count* *t-fails*)
