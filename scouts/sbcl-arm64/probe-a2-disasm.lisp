;; Disassemble probe-A candidates to see if move-if/word fires
(let ((src '(lambda (a b)
              (declare (type (unsigned-byte 64) a b)
                       (optimize (speed 3) (safety 0)))
              (logand (if (< a b) 1 1) a))))
  (format t "=== logand/if 1 1 ===~%")
  (disassemble (compile nil src)))
(let ((src '(lambda (a b v)
              (declare (type (signed-byte 64) a b)
                       (type (simple-array (signed-byte 64) (1)) v)
                       (optimize (speed 3) (safety 0)))
              (setf (aref v 0) (if (< a b) 1 1))
              (aref v 0))))
  (format t "=== setf aref/if 1 1 ===~%")
  (disassemble (compile nil src)))
(let ((src '(lambda (a b)
              (declare (type (unsigned-byte 64) a b)
                       (optimize (speed 3) (safety 0)))
              (logand (if (< a b) 1 2) a))))
  (format t "=== logand/if 1 2 (control) ===~%")
  (disassemble (compile nil src)))
