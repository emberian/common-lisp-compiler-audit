;; Probe B: overflow+t/-t transforms applied to s128 operands
;; (fixed post-2.6.10 by 29d0bbc7f "Don't do overflow+t for s128")
(load (merge-pathnames "harness.lisp" *load-truename*))

(flet ((try (name type op y)
         (format t "--- ~a: (~a x ~a) with x ~a, cast fixnum ---~%" name op y type)
         (handler-case
             (let* ((src `(lambda (x)
                            (declare (type ,type x) (optimize (speed 3) (safety 0)))
                            (the fixnum (,op x ,y))))
                    (f (compile nil src))
                    (g (compile nil `(lambda (x)
                                       (declare (type ,type x) (optimize (speed 3) (safety 0)))
                                       (the fixnum (funcall (symbol-function ',op) x ,y)))))
                    (vals (remove-if-not (lambda (v) (typep v type)) *s128*)))
               (dolist (v vals)
                 (let ((r1 (multiple-value-list (ignore-errors (funcall f v))))
                       (r2 (multiple-value-list (ignore-errors (funcall g v)))))
                   (unless (equalp r1 r2)
                     (format t "DIVERGE ~a x=~s inline=~s ref=~s~%" name v r1 r2))))
               (format t "  ok~%"))
           (error (e) (format t "  COMPILE/RUN ERROR: ~a~%" e)))))
  (try 'B1 '(signed-byte 128) '+ 1)
  (try 'B2 '(signed-byte 128) '- 1)
  (try 'B3 '(signed-byte 128) '+ -1)
  (try 'B4 '(integer 9223372036854775808) '+ -9223372036854775807)
  (try 'B5 '(unsigned-byte 128) '+ 1)
  (try 'B6 '(integer 0) '- 1))

;; Also try the shape where the cast is via check-bound / array index
(format t "--- B7: array index consumer ---~%")
(handler-case
    (let* ((f (compile nil `(lambda (x a)
                              (declare (type (signed-byte 128) x)
                                       (type (simple-array fixnum (16)) a)
                                       (optimize (speed 3) (safety 0)))
                              (aref a (+ x 1))))))
      (format t "f(0)=~s f(-1)=~s~%" (ignore-errors (funcall f 0 (make-array 16 :initial-element 7)))
              (ignore-errors (funcall f -1 (make-array 16 :initial-element 7)))))
  (error (e) (format t "B7 ERROR: ~a~%" e)))
(format t "probe B done~%" *fails*)
