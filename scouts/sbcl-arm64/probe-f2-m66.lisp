;; Probe F2: m=66 targeted. (ash x 66) for x=2^62-1 gives 2^128-2^66 which
;; exceeds s128; if the VOP wraps mod 2^128 the sign bit flips.
(load (merge-pathnames "harness.lisp" *load-truename*))
(defparameter *xfix* '(0 1 -1 2 -2 3 -3 2305843009213693951
                       4611686018427387902 4611686018427387903
                       -4611686018427387903 -4611686018427387904))
(flet ((drive (m consumer-expr)
         (format t "--- m=~d consumer=~s ---~%" m consumer-expr)
         (let ((f (compile nil `(lambda (x)
                                  (declare (type fixnum x)
                                           (optimize (speed 3) (safety 0)))
                                  (let ((s (ash x ,m))) ,consumer-expr))))
               (g (compile nil `(lambda (x)
                                  (declare (type fixnum x)
                                           (optimize (speed 3) (safety 0)))
                                  (locally (declare (notinline ash))
                                    (let ((s (ash x ,m))) ,consumer-expr))))))
           (dolist (v *xfix*)
             (let ((r1 (multiple-value-list (ignore-errors (funcall f v))))
                   (r2 (multiple-value-list (ignore-errors (funcall g v)))))
               (format t "  x=~22s inline=~s ref=~s~% " v r1 r2)
               (unless (equalp r1 r2)
                 (format t " <<< DIVERGE~%")))))))
  (drive 66 '(ash s -127))
  (drive 66 '(< s 0))
  (drive 66 '(ash s -100))
  (drive 66 's)
  (drive 127 '(ash s -127))
  (drive 127 '(< s 0)))
(format t "probe F2 done~%")
