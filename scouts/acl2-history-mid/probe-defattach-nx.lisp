(in-package "ACL2")

(cw "~%=== H44 VALID NONEXECUTABLE DEFUN-INLINE AND TRACE ===~%")
(defun-inline nx-inline44 (x)
  (declare (xargs :guard t :non-executable t))
  (prog2$ (throw-nonexec-error 'nx-inline44$inline (list x)) x))
(defthm nx-inline44-logical (equal (nx-inline44 x) x) :rule-classes nil)
(value-triple (nx-inline44 3))
(defconst *nx-inline44* (nx-inline44 3))
(trace$ nx-inline44$inline)
(value-triple (nx-inline44 4))

(cw "~%=== H45 PARTIAL MUTUAL-RECURSION RECLASSIFICATION ===~%")
(mutual-recursion
 (defun mf45 (x)
   (declare (xargs :mode :program))
   (if (consp x) (mg45 (cdr x)) x))
 (defun mg45 (x)
   (declare (xargs :mode :program))
   (if (consp x) (mf45 (cdr x)) x)))
(defun mf45 (x)
  (declare (xargs :mode :logic))
  (if (consp x) (mg45 (cdr x)) x))
(defun-nx mf45 (x)
  (if (consp x) (mg45 (cdr x)) x))

(cw "~%=== H46 DIRECT DEFAXIOM SUPPORT BLOCKS ATTACHMENT (PROBE) ===~%")
(encapsulate (((c46 *) => *))
  (local (defun c46 (x) x)))
(defaxiom ax46 (equal (c46 x) x))
(defun id46 (x) (declare (xargs :guard t)) x)
(defattach c46 id46)

(cw "~%=== H47 INDIRECT DEFAXIOM SUPPORT BLOCKS ATTACHMENT (PROBE) ===~%")
(encapsulate (((c47 *) => *))
  (local (defun c47 (x) x)))
(defun f47 (x) (c47 x))
(defaxiom ax47 (equal (f47 x) x))
(defun id47 (x) (declare (xargs :guard t)) x)
(defattach c47 id47)

(cw "~%=== H48 MAKE-EVENT-GENERATED DEFAXIOM SUPPORT (PROBE) ===~%")
(encapsulate (((c48 *) => *))
  (local (defun c48 (x) x)))
(make-event '(defaxiom ax48 (equal (c48 x) x)))
(defun id48 (x) (declare (xargs :guard t)) x)
(defattach c48 id48)

(cw "~%=== H49 ATTACHMENT CONTROL WITHOUT DEFAXIOM ===~%")
(encapsulate (((c49 *) => *))
  (local (defun c49 (x) x)))
(defun id49 (x) (declare (xargs :guard t)) x)
(defattach c49 id49)
(value-triple (c49 3))

(quit)
