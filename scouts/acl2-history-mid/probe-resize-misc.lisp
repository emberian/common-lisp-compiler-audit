(in-package "ACL2")

(cw "~%=== H38 RESIZABLE ARRAY OF STOBJS: LOGICAL/RAW GROWTH ===~%")
(defstobj kid38 (fld38 :type integer :initially 0))
(defstobj par38 (kids38 :type (array kid38 (0)) :resizable t))
(defun update-kid38-at (i v par38)
  (declare (xargs :stobjs par38
                   :guard (and (integerp i) (<= 0 i)
                               (< i (kids38-length par38))
                               (integerp v))))
  (stobj-let ((kid38 (kids38i i par38)))
             (kid38)
             (update-fld38 v kid38)
             par38))
(defun read-kid38-at (i par38)
  (declare (xargs :stobjs par38
                   :guard (and (integerp i) (<= 0 i)
                               (< i (kids38-length par38)))))
  (stobj-let ((kid38 (kids38i i par38)))
             (v)
             (fld38 kid38)
             v))
(defun test38 ()
  (with-local-stobj par38
    (mv-let (v par38)
      (let* ((par38 (resize-kids38 2 par38))
             (par38 (update-kid38-at 1 7 par38))
             (v1 (read-kid38-at 1 par38))
             (par38 (resize-kids38 1 par38))
             (par38 (resize-kids38 2 par38))
             (v2 (read-kid38-at 1 par38)))
        (mv (and (equal v1 7) (equal v2 0) (equal (kids38-length par38) 2))
            par38))
      v)))
(value-triple (test38))
(defthm test38-true (test38) :rule-classes nil)
(defthm test38-not (not (test38)) :rule-classes nil)

(cw "~%=== H39 CONGRUENT RESIZE PLUS MEMOIZED CHILD READER ===~%")
(defstobj kid39 (fld39 :type integer :initially 0))
(defstobj par39a (kids39a :type (array kid39 (0)) :resizable t))
(defstobj par39b (kids39b :type (array kid39 (0)) :resizable t)
  :congruent-to par39a)
(defun update-kid39-at (i v par39b)
  (declare (xargs :stobjs par39b
                   :guard (and (integerp i) (<= 0 i)
                               (< i (kids39b-length par39b))
                               (integerp v))))
  (stobj-let ((kid39 (kids39bi i par39b)))
             (kid39)
             (update-fld39 v kid39)
             par39b))
(defun read-kid39-at (i par39a)
  (declare (xargs :stobjs par39a
                   :guard (and (integerp i) (<= 0 i)
                               (< i (kids39a-length par39a)))))
  (stobj-let ((kid39 (kids39ai i par39a)))
             (v)
             (fld39 kid39)
             v))
(defun test39 ()
  (with-local-stobj par39b
    (mv-let (v par39b)
      (let* ((par39b (resize-kids39a 2 par39b))
             (par39b (update-kid39-at 1 7 par39b))
             (v1 (read-kid39-at 1 par39b))
             (par39b (resize-kids39b 1 par39b))
             (par39b (resize-kids39b 2 par39b))
             (v2 (read-kid39-at 1 par39b)))
        (mv (and (equal v1 7) (equal v2 0)) par39b))
      v)))
(defthm test39-true (test39) :rule-classes nil)
(memoize 'read-kid39-at)
(value-triple (test39))
(defthm test39-not (not (test39)) :rule-classes nil)

(cw "~%=== H40 DIVERGENT MBE IN DO LOOP$, CORRECTED SYNTAX ===~%")
(defun f-do-loop-mbe-h40 ()
  (loop$ with x = 1 with ans = nil
         do (if (zp x)
                (return ans)
              (progn (setq ans (mbe :logic nil :exec t))
                     (setq x (1- x))))))
(value-triple (f-do-loop-mbe-h40))
(value-triple (f-do-loop-mbe-h40) :safe-mode t)
(defthm f-do-loop-mbe-logical-h40 (equal (f-do-loop-mbe-h40) nil)
  :rule-classes nil)
(defthm f-do-loop-mbe-exec-h40 (equal (f-do-loop-mbe-h40) t)
  :rule-classes nil)

(cw "~%=== H41 EXTENDED METAFUNCTION TTREE SIGNATURES ===~%")
(value-triple
 (list (stobjs-out 'mfc-relieve-hyp-ttree (w state))
       (stobjs-out 'mfc-rw+-ttree (w state))
       (stobjs-out 'mfc-rw-ttree (w state))
       (stobjs-out 'mfc-ts-ttree (w state))))
(defmacro bad-mfc-ap-h41 (term mfc st)
