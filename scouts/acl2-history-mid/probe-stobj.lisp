(in-package "ACL2")

(cw "~%=== H7R STRING RECOGNIZED AS STOBJ, CORRECTED NAMES ===~%")
(defstobj st-h7r fld-h7r)
(value-triple (st-h7rp "abc"))
(defthm bad-h7r (st-h7rp "abc") :rule-classes nil)
(defthm contradiction-h7r
  nil
  :hints (("Goal" :in-theory (disable (st-h7rp)) :use bad-h7r))
  :rule-classes nil)

(cw "~%=== H15 LET/MV-LET DROPS UPDATED STOBJ ===~%")
(defstobj s15 fld15)
(defun drop-let-h15 (s15)
  (declare (xargs :stobjs s15))
  (let ((s15 (update-fld15 1 s15))) nil))
(defun drop-mv-let-h15 (s15)
  (declare (xargs :stobjs s15))
  (mv-let (v s15)
          (mv 0 (update-fld15 1 s15))
          (declare (ignore v))
          nil))
(defun drop-let-mbe-h15 (s15)
  (declare (xargs :stobjs s15))
  (mbe :logic s15
       :exec (let ((s15 (update-fld15 1 s15))) nil)))

(cw "~%=== H16 NON-CHILD STOBJ PRODUCER NOT RETURNED ===~%")
(defstobj kid16 fld16)
(defstobj other16 ofld16)
(defstobj other16c ofld16c :congruent-to other16)
(defstobj mom16 (kid16-field :type kid16))
(defun bad-nonchild-h16 (mom16 other16)
  (declare (xargs :stobjs (mom16 other16)))
  (stobj-let
   ((kid16 (kid16-field mom16)))
   (kid16 other16)
   (mv (update-fld16 1 kid16) (update-ofld16 2 other16))
   mom16))
(defun bad-nonchild-congruent-h16 (mom16 other16c)
  (declare (xargs :stobjs (mom16 other16c)))
  (stobj-let
   ((kid16 (kid16-field mom16)))
   (kid16 other16c)
   (mv (update-fld16 1 kid16) (update-ofld16c 2 other16c))
   mom16))

(cw "~%=== H17 PARENT AS PRODUCER, NEWER NESTED-STOBJ SIBLING ===~%")
(defstobj sub17 (subfld17 :type (integer 0 10) :initially 0))
(defstobj parent17 (child17 :type sub17))
(defun upd17 (parent17)
  (declare (xargs :stobjs parent17))
  (stobj-let ((sub17 (child17 parent17)))
             (sub17)
             (update-subfld17 1 sub17)
             parent17))
(defun bad-parent-producer-h17 (parent17)
  (declare (xargs :stobjs parent17))
  (stobj-let ((sub17 (child17 parent17)))
             (v parent17)
             (let* ((v1 (subfld17 sub17))
                    (parent17 (upd17 parent17))
                    (v2 (subfld17 sub17)))
               (mv (equal v1 v2) parent17))
             (mv v parent17)))

(cw "~%=== H18 CONGRUENT CHILD ALIASING ===~%")
(defstobj a18 (afld18))
(defstobj aa18 (aafld18) :congruent-to a18)
(defstobj c18 (ca18 :type a18))
(defun bad-congruent-alias-h18 (c18)
  (declare (xargs :stobjs c18))
  (stobj-let
   ((a18 (ca18 c18))
    (aa18 (ca18 c18)))
   (a18 aa18)
   (let ((a18 (update-afld18 (not (afld18 a18)) a18)))
     (mv a18 aa18))
   c18))

(cw "~%=== H19 DYNAMIC ARRAY ALIAS WITHOUT GUARD VERIFICATION ===~%")
(defstobj ca19 (afld19))
(defstobj caa19 (aafld19) :congruent-to ca19)
(defstobj cp19 (as19 :type (array ca19 (2))))
(defun read-ca19 (cp19)
  (declare (xargs :stobjs cp19))
  (stobj-let ((ca19 (as19i 0 cp19))) (x) (afld19 ca19) x))
(defun hidden-array-update-h19 (i j cp19)
  (declare (xargs :stobjs cp19 :verify-guards nil))
  (stobj-let
   ((ca19 (as19i i cp19))
    (caa19 (as19i j cp19)))
   (ca19 caa19)
   (let ((ca19 (update-afld19 (not (afld19 ca19)) ca19)))
     (mv ca19 caa19))
   cp19))
(defun array-test-h19 ()
  (declare (xargs :guard t :verify-guards nil))
  (with-local-stobj cp19
    (mv-let (x cp19)
      (let* ((before (read-ca19 cp19))
             (cp19 (hidden-array-update-h19 0 0 cp19))
             (after (read-ca19 cp19)))
        (mv (equal after before) cp19))
      x)))
(value-triple (array-test-h19))
(defthm array-test-logical-h19
  (array-test-h19)
  :hints (("Goal" :in-theory (disable (array-test-h19)
                                      (read-ca19)
                                      (hidden-array-update-h19))))
  :rule-classes nil)
(defthm array-contradiction-h19
  nil
  :hints (("Goal" :use array-test-logical-h19
           :in-theory (disable array-test-logical-h19)))
  :rule-classes nil)

(quit)
