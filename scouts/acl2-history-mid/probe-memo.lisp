(in-package "ACL2")

(cw "~%=== H24 NESTED STOBJ/MEMOIZE ORIGINAL ===~%")
(defstobj kid24a fld24a)
(defstobj kid24b fld24b)
(defstobj mom24 (kid24a-field :type kid24a) (kid24b-field :type kid24b))
(defun mom24-update-fld (val mom24)
  (declare (xargs :stobjs mom24))
  (stobj-let ((kid24a (kid24a-field mom24)))
             (kid24a)
             (update-fld24a val kid24a)
             mom24))
(defun mom24-read-fld (mom24)
  (declare (xargs :stobjs mom24))
  (stobj-let ((kid24a (kid24a-field mom24)))
             (val)
             (fld24a kid24a)
             val))
(defun test24 ()
  (with-local-stobj mom24
    (mv-let (val mom24)
      (let* ((mom24 (mom24-update-fld 3 mom24))
             (v1 (mom24-read-fld mom24))
             (mom24 (mom24-update-fld 4 mom24))
             (v2 (mom24-read-fld mom24)))
        (mv (equal v1 v2) mom24))
      val)))
(defthm true24 (not (test24)) :rule-classes nil)
(memoize 'mom24-read-fld)
(value-triple (test24))
(defthm false24 (test24) :rule-classes nil)
(defthm contradiction24 nil
  :hints (("Goal" :use (true24 false24))) :rule-classes nil)

(cw "~%=== H25 NONCANONICAL CONGRUENT STOBJ/MEMOIZE ===~%")
(defstobj a25 (fld25a))
(defstobj b25 (fld25b) :congruent-to a25)
(defstobj c25 (fld25c) :congruent-to b25)
(defun read25 (a25)
  (declare (xargs :stobjs a25))
  (fld25a a25))
(defun test25 ()
  (with-local-stobj c25
    (mv-let (val c25)
      (let* ((c25 (update-fld25b 3 c25))
             (v1 (read25 c25))
             (c25 (update-fld25c 4 c25))
             (v2 (read25 c25)))
        (mv (equal v1 v2) c25))
      val)))
(defthm true25 (not (test25)) :rule-classes nil)
(memoize 'read25)
(value-triple (test25))
(defthm false25 (test25) :rule-classes nil)

(cw "~%=== H26 CONGRUENT HASH REMOVE AND CLEAR FLUSH ===~%")
(defstobj h26a (ht26a :type (hash-table eql)))
(defstobj h26b (ht26b :type (hash-table eql)) :congruent-to h26a)
(defun rd26-rem (h26a) (declare (xargs :stobjs h26a)) (ht26a-get 0 h26a))
(defun test26-rem ()
  (with-local-stobj h26b
    (mv-let (val h26b)
      (let* ((h26b (ht26a-put 0 3 h26b))
             (v1 (rd26-rem h26b))
             (h26b (ht26b-rem 0 h26b))
             (v2 (rd26-rem h26b)))
        (mv (equal v1 v2) h26b))
      val)))
(defthm true26-rem (not (test26-rem)) :rule-classes nil)
(memoize 'rd26-rem)
(value-triple (test26-rem))
(defthm false26-rem (test26-rem) :rule-classes nil)

(defun rd26-clear (h26a) (declare (xargs :stobjs h26a)) (ht26a-get 0 h26a))
(defun test26-clear ()
  (with-local-stobj h26b
    (mv-let (val h26b)
      (let* ((h26b (ht26a-put 0 3 h26b))
             (v1 (rd26-clear h26b))
             (h26b (ht26b-clear h26b))
             (v2 (rd26-clear h26b)))
        (mv (equal v1 v2) h26b))
      val)))
(defthm true26-clear (not (test26-clear)) :rule-classes nil)
(memoize 'rd26-clear)
(value-triple (test26-clear))
(defthm false26-clear (test26-clear) :rule-classes nil)

(cw "~%=== H27 CONGRUENT STOBJ-TABLE CHILD UPDATE FLUSH ===~%")
(defstobj child27 fld27)
(defstobj tab27a (tbl27a :type (stobj-table)))
(defstobj tab27b (tbl27b :type (stobj-table)) :congruent-to tab27a)
(defun tab27-update (val tab27b)
  (declare (xargs :stobjs tab27b))
  (stobj-let ((child27 (tbl27b-get 'child27 tab27b (create-child27))))
             (child27)
             (update-fld27 val child27)
             tab27b))
(defun tab27-read (tab27a)
  (declare (xargs :stobjs tab27a))
  (stobj-let ((child27 (tbl27a-get 'child27 tab27a (create-child27))))
             (val)
             (fld27 child27)
             val))
(defun test27 ()
  (with-local-stobj tab27b
    (mv-let (val tab27b)
      (let* ((tab27b (tab27-update 3 tab27b))
             (v1 (tab27-read tab27b))
             (tab27b (tab27-update 4 tab27b))
             (v2 (tab27-read tab27b)))
        (mv (equal v1 v2) tab27b))
      val)))
(defthm true27 (not (test27)) :rule-classes nil)
(memoize 'tab27-read)
(value-triple (test27))
(defthm false27 (test27) :rule-classes nil)

(quit)
