(in-package "ACL2")
(defstobj nest-kid nest-fld)
(defstobj nest-mom
  (nest-kid-field :type nest-kid)
  nest-last-op)
(defun nest-read (nest-mom)
  (declare (xargs :stobjs nest-mom :verify-guards nil))
  (stobj-let ((nest-kid (nest-kid-field nest-mom)))
             (ans)
             (list (nest-fld nest-kid) (nest-last-op nest-mom))
             ans))
(defun nest-write (nest-mom)
  (declare (xargs :stobjs nest-mom :verify-guards nil))
  (stobj-let ((nest-kid (nest-kid-field nest-mom)))
             (nest-kid)
             (update-nest-fld 7 nest-kid)
             (update-nest-last-op 'done nest-mom)))
