(in-package "ACL2")
(defun flet-value ()
  (flet ((local-f (x) (cons x x)))
    (local-f 3)))
(defun macrolet-value ()
  (macrolet ((local-m (x) `(cons ,x ,x)))
    (local-m 4)))
(defun ec-call-value (x)
  (declare (xargs :verify-guards nil))
  (ec-call (car (cons x nil))))
(defun equal-mbe-value (x)
  (mbe :logic (+ x 1) :exec (+ x 1)))
(defun oneify-control-values (x)
  (list (flet-value) (macrolet-value) (ec-call-value x)
        (equal-mbe-value x)))
